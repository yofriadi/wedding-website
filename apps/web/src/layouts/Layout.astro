---
// Font delivery (webfont-delivery, design D6). One family per role:
//
// - Sans: the `wght` variable entrypoint only. The four `@fontsource/geist-sans`
//   static weights are gone — `--font-sans` resolves "Geist Variable" first and
//   that family covers 100–900, so the static family was unreachable while still
//   costing 15 `@font-face` rules and four legacy `.woff` files.
// - Serif: `standard` (wght + opsz), not `full` (wght + opsz + SOFT + WONK). No
//   consumer in `src/` drives SOFT or WONK; `opsz` is load-bearing, because
//   `font-optical-sizing: auto` changes contrast and spacing at the hero's
//   `clamp(2.5rem, 11.5vw, 7.5rem)` display sizes.
//
// Italic is retained on the serif: HeroZoom renders the display ampersand italic
// and RsvpSection renders an italic line. Subsets are `unicode-range`-gated by the
// stock entrypoints, so Vietnamese and Cyrillic declarations ship but transfer no
// bytes on an Indonesian/English render — verified against the request list, not
// the emitted CSS.
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/fraunces/standard.css";
import "@fontsource-variable/fraunces/standard-italic.css";
// Resolved through Vite rather than written as a package path: the build emits
// this file into `dist/client/_astro/` under a content hash, so a literal
// `/node_modules/@fontsource-variable/...` href would 404 and the hint would
// silently double-fetch nothing.
import frauncesLatinNormal from "@fontsource-variable/fraunces/files/fraunces-latin-standard-normal.woff2";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "wedding-website" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {/* The latin serif face that paints the largest above-the-fold display
         text. `crossorigin` is mandatory for font preloads even same-origin, or
         the hint fetches a second copy the @font-face then ignores. One hint,
         not two: the italic and the sans are not on the critical text path, and
         webfont-delivery caps font preloads at two. */}
    <link rel="preload" as="font" type="font/woff2" href={frauncesLatinNormal} crossorigin />

    {/* Page-owned head hints. Layout is shared, so a hint for an asset only one
         page renders belongs to that page: index.astro puts the hero image
         preload here through this slot. */}
    <slot name="head" />

    {/* Media tiering: default to full unless user explicitly enabled Save-Data. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
        var tier = (conn && conn.saveData) ? 'lite' : 'full';
        root.setAttribute('data-tier', tier);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-neutral-950 text-white">
    <slot />
  </body>
</html>
