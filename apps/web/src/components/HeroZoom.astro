---
---
<section class="relative hero-scroll" id="hero-container">
  <div class="hero-stage sticky top-0 w-full overflow-hidden">
    <!-- Sharp image stays visible while the hero zooms out. -->
    <picture>
      <source srcset="/wedding_photo-390.avif 390w, /wedding_photo-640.avif 640w, /wedding_photo.avif 768w, /wedding_photo-1024.avif 1024w, /wedding_photo-1536.avif 1536w" sizes="min(280vw, 1536px)" type="image/avif" />
      <source srcset="/wedding_photo-390.webp 390w, /wedding_photo-640.webp 640w, /wedding_photo.webp 768w, /wedding_photo-1024.webp 1024w, /wedding_photo-1536.webp 1536w" sizes="min(280vw, 1536px)" type="image/webp" />
      <img
        src="/wedding_photo-1024.webp"
        srcset="/wedding_photo-390.webp 390w, /wedding_photo-640.webp 640w, /wedding_photo.webp 768w, /wedding_photo-1024.webp 1024w, /wedding_photo-1536.webp 1536w"
        sizes="min(280vw, 1536px)"
        width="1024"
        height="1835"
        alt="Aisha Amalia and Yofriadi Yahya displaying their wedding rings"
        data-hero-media
        fetchpriority="high"
        loading="eager"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover animate-image"
      />
    </picture>
    <!-- Pre-blurred layer fades in instead of animating an expensive CSS filter. -->
    <picture>
      <source src="/wedding_photo_blur.avif" type="image/avif" />
      <source src="/wedding_photo_blur.webp" type="image/webp" />
      <img
        src="/wedding_photo_blur.webp"
        width="768"
        height="1376"
        alt=""
        aria-hidden="true"
        loading="eager"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover animate-blur"
      />
    </picture>
    <div class="absolute inset-0 z-10 bg-black pointer-events-none animate-overlay"></div>

    <!-- Overlay Content (Names & Date) -->
    <div class="absolute inset-0 flex flex-col items-center justify-center z-20 pointer-events-none">
      <div class="w-full max-w-5xl px-5 text-center text-balance space-y-18 sm:space-y-26 md:space-y-32 animate-text">
        <p
          class="text-[clamp(1.5rem,4.5vw,3.5rem)] leading-none font-light text-white/90 tracking-wide font-serif animate-pernikahan drop-shadow-lg"
        >
          Pernikahan
        </p>
        <!-- pl- offsets the trailing letter-space so the glyphs stay optically centered. -->
        <h1
          class="grid grid-cols-[1fr_auto_1fr] items-center justify-center w-full max-w-5xl mx-auto gap-x-1 sm:gap-x-1.5 md:gap-x-2 font-serif text-white tracking-[0.03em] drop-shadow-lg"
        >
          <span
            class="col-start-1 row-start-1 text-right text-[clamp(3rem,14vw,9rem)] leading-[0.95] whitespace-nowrap animate-aisha"
          >
            Aisha
          </span>
          <span
            class="col-start-2 row-start-2 text-center text-[clamp(2.5rem,11.5vw,7.5rem)] text-white/80 font-light italic leading-none my-[-0.18em] z-10 animate-amp"
          >
            &
          </span>
          <span
            class="col-start-3 row-start-3 text-left text-[clamp(3rem,14vw,9rem)] leading-[0.95] whitespace-nowrap animate-yofri"
          >
            Yofri
          </span>
        </h1>
        <p
          class="text-[clamp(1.5rem,4.5vw,3.5rem)] leading-none font-light text-white/90 tracking-wide font-serif drop-shadow-lg"
        >
          <time datetime="2026-10-10" class="animate-date inline-block">Sabtu, 10 Oktober 2026</time>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* The 300lvh section gives the 100lvh stage 200lvh of pinned travel.

     lvh, not svh: `lvh` is the viewport with browser chrome HIDDEN, which is the
     state the pinned sequence is actually watched in — every browser retracts the
     URL bar as soon as you scroll down. At `svh` the sticky stage would be ~70px
     shorter than the visible area for the entire pinned phase, exposing a band of
     section background under it. Sized `lvh` the stage matches the screen exactly
     once the bar is gone; the cost is that the bottom ~70px sits below the fold at
     rest, before the first scroll.

     Never `dvh`: dvh re-resolves while the chrome collapses, so the runway would
     silently change length mid-scroll and jump the scrub. lvh is as static as svh.

     The `vh` fallback agrees with `lvh` by construction — iOS Safari's legacy `vh`
     has always been the large viewport. */
  .hero-scroll {
    height: 350vh;
    height: 350lvh;
  }
  .hero-stage {
    height: 100vh;
    height: 100lvh;
  }
  .hero-scroll,
  .hero-stage {
    /* Keep the cinematic sequence stable while mobile browser chrome changes. */
    min-height: 0;
  }
  .animate-image,
  .animate-blur {
    transform-origin: center 40%;
    will-change: transform, opacity;
  }

  /* The static fallback is the readable, fully revealed hero. Enhanced modes override it. */
  .animate-image {
    transform: scale(1);
  }
  .animate-blur {
    opacity: 1;
  }
  .animate-overlay {
    opacity: 0.3;
  }
  .animate-text {
    opacity: 1;
    transform: translateY(0);
  }
  .animate-aisha,
  .animate-amp,
  .animate-yofri {
    opacity: 1;
    transform: translateY(0);
    will-change: transform, opacity;
  }
  .animate-pernikahan,
  .animate-date {
    opacity: 1;
    filter: blur(0px);
    will-change: filter, opacity;
  }

  /* Map animation progress to the 250lvh period while the stage is pinned. */
  @keyframes image-scroll-effect {
    0% {
      transform: scale(2.8);
    }
    28%, 35%, 55%, 100% {
      transform: scale(1);
    }
  }

  @keyframes blur-reveal {
    0%, 35% {
      opacity: 0;
    }
    50%, 100% {
      opacity: 1;
    }
  }

  @keyframes overlay-reveal {
    0%, 35% {
      opacity: 0;
    }
    50%, 100% {
      opacity: 0.3;
    }
  }

  /* Sequential entrance for Aisha, &, Yofri — short, snappy timing:
     1. Aisha glides up and fades in: 35% → 42%
     2. & blooms in at the center: 39% → 46%
     3. Yofri glides up into place: 43% → 50% */
  @keyframes aisha-reveal {
    0%, 35% {
      opacity: 0;
      transform: translateY(24px);
    }
    42%, 100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes amp-reveal {
    0%, 39% {
      opacity: 0;
      transform: translateY(18px) scale(0.85);
    }
    46%, 100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes yofri-reveal {
    0%, 43% {
      opacity: 0;
      transform: translateY(24px);
    }
    50%, 100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Blur reveal matching https://www.anthropic.com/claude-fable-and-mythos-5-1 fx-title-in:
     Elements transition from a soft camera-like blur (16px) with 0 opacity
     into crisp focus. Triggered sequentially after the couple names settle:
     1. Aisha & Yofri completes entrance at 50%
     2. Pernikahan blur reveals (53% → 66%)
     3. Date blur reveals (59.5% → 72.5%, starting halfway through Pernikahan)
     4. Completed lockup stays pinned and held (72.5% → 100%) for a quiet reading beat */
  @keyframes blur-reveal-pernikahan {
    0%, 53% {
      opacity: 0;
      filter: blur(16px);
    }
    59% {
      opacity: 1;
    }
    66%, 100% {
      opacity: 1;
      filter: blur(0px);
    }
  }

  @keyframes blur-reveal-date {
    0%, 59.5% {
      opacity: 0;
      filter: blur(16px);
    }
    65.5% {
      opacity: 1;
    }
    72.5%, 100% {
      opacity: 1;
      filter: blur(0px);
    }
  }

  /* A named view timeline keeps progress local to this hero section. */
  @supports (view-timeline: --hero-progress block) and (animation-timeline: --hero-progress) {
    .hero-scroll {
      view-timeline: --hero-progress block;
      view-timeline-inset: 100% 100%;
    }
    .animate-image {
      animation: image-scroll-effect var(--ease-out-zoom) both;
      animation-timeline: --hero-progress;
      animation-range: 0% 100%;
    }
    .animate-blur {
      animation: blur-reveal linear both;
      animation-timeline: --hero-progress;
      animation-range: 0% 100%;
    }
    .animate-overlay {
      animation: overlay-reveal linear both;
      animation-timeline: --hero-progress;
      animation-range: 0% 100%;
    }
    .animate-aisha {
      animation: aisha-reveal linear both;
      animation-timeline: --hero-progress;
      animation-range: 0% 100%;
    }
    .animate-amp {
      animation: amp-reveal linear both;
      animation-timeline: --hero-progress;
      animation-range: 0% 100%;
    }
    .animate-yofri {
      animation: yofri-reveal linear both;
      animation-timeline: --hero-progress;
      animation-range: 0% 100%;
    }
    .animate-pernikahan {
      animation: blur-reveal-pernikahan linear both;
      animation-timeline: --hero-progress;
      animation-range: 0% 100%;
    }
    .animate-date {
      animation: blur-reveal-date linear both;
      animation-timeline: --hero-progress;
      animation-range: 0% 100%;
    }
  }

  /* Unsupported browsers keep the static hero until the JS enhancement initializes. */

  /* Reduced-motion users get the complete, readable hero without a scroll sequence. */
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll {
      height: 100vh;
      height: 100lvh;
    }
    .hero-stage {
      position: relative !important;
    }
    .animate-image,
    .animate-blur,
    .animate-overlay,
    .animate-text,
    .animate-aisha,
    .animate-amp,
    .animate-yofri,
    .animate-pernikahan,
    .animate-date {
      animation: none !important;
    }
    .animate-image {
      transform: scale(1) !important;
    }
    .animate-blur {
      opacity: 1 !important;
    }
    .animate-overlay {
      opacity: 0.3 !important;
    }
    .animate-text,
    .animate-aisha,
    .animate-amp,
    .animate-yofri {
      opacity: 1 !important;
      transform: none !important;
    }
    .animate-pernikahan,
    .animate-date {
      opacity: 1 !important;
      filter: none !important;
    }
  }
</style>

<script is:inline>
  // Section-relative fallback for browsers without named view-timeline support.
  const supportsScrollTimeline =
    CSS.supports("view-timeline: --hero-progress block") &&
    CSS.supports("animation-timeline: --hero-progress");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!supportsScrollTimeline && !prefersReducedMotion) {
    const section = document.querySelector("#hero-container");
    const img = section?.querySelector(".animate-image");
    const blur = section?.querySelector(".animate-blur");
    const overlay = section?.querySelector(".animate-overlay");
    const aisha = section?.querySelector(".animate-aisha");
    const amp = section?.querySelector(".animate-amp");
    const yofri = section?.querySelector(".animate-yofri");
    const pernikahan = section?.querySelector(".animate-pernikahan");
    const date = section?.querySelector(".animate-date");
    const stage = section?.querySelector(".hero-stage");

    if (section && img && blur && overlay && aisha && amp && yofri && pernikahan && date) {
      let ticking = false;
      let heroActive = true;

      // Gate the fallback while the hero is far offscreen: scroll events then
      // perform no rect reads and no style writes.
      if (typeof IntersectionObserver !== "undefined") {
        const observer = new IntersectionObserver(
          (entries) => {
            heroActive = entries[entries.length - 1].isIntersecting;
          },
          { rootMargin: "100% 0px 100% 0px" },
        );
        observer.observe(section);
      }

      // Matches Anthropic's fx-title-in blur reveal:
      // Opacity ramps from 0 to 1 in the first ~45% of progress,
      // while blur clears from 16px down to 0px across 100% of progress.
      const getBlurReveal = (progress) => {
        if (progress <= 0) return { opacity: "0", filter: "blur(16px)" };
        if (progress >= 1) return { opacity: "1", filter: "blur(0px)" };
        const opacity = Math.min(progress / 0.45, 1);
        const blurPx = 16 * (1 - progress);
        return {
          opacity: `${opacity}`,
          filter: `blur(${blurPx.toFixed(2)}px)`,
        };
      };

      const update = () => {
        ticking = false;
        const sectionRect = section.getBoundingClientRect();
        const scrolled = Math.max(0, -sectionRect.top);
        const viewportHeight =
          stage?.getBoundingClientRect().height || document.documentElement.clientHeight;

        const travel = Math.max(
          sectionRect.height - viewportHeight,
          1,
        );
        // Phase boundaries mirror the CSS keyframes across the 250lvh pinned travel:
        // - Zoom: 0% → 28%
        // - Pause: 28% → 35%
        // - Sequential names reveal (short timing):
        //     Aisha: 35% → 42%
        //     &: 39% → 46%
        //     Yofri: 43% → 50%
        // - Pernikahan blur reveal: 53% → 66%
        // - Date blur reveal: 59.5% → 72.5% (starting halfway through Pernikahan)
        // - Completed lockup stays held: 72.5% → 100%
        const zoomEnd = (travel * 28) / 100;
        const pauseEnd = (travel * 35) / 100;
        const aishaStart = (travel * 35) / 100;
        const aishaEnd = (travel * 42) / 100;
        const ampStart = (travel * 39) / 100;
        const ampEnd = (travel * 46) / 100;
        const yofriStart = (travel * 43) / 100;
        const yofriEnd = (travel * 50) / 100;
        const pernikahanStart = (travel * 53) / 100;
        const pernikahanEnd = (travel * 66) / 100;
        const dateStart = (travel * 59.5) / 100;
        const dateEnd = (travel * 72.5) / 100;

        if (scrolled <= zoomEnd) {
          const progress = Math.min(scrolled / zoomEnd, 1);
          const eased = 1 - Math.pow(1 - progress, 3); // easeOutCubic, matches the CSS curve.
          const scale = 2.8 - eased * 1.8;
          img.style.transform = `scale(${scale})`;
          blur.style.opacity = "0";
          overlay.style.opacity = "0";
          aisha.style.opacity = "0";
          aisha.style.transform = "translateY(24px)";
          amp.style.opacity = "0";
          amp.style.transform = "translateY(18px) scale(0.85)";
          yofri.style.opacity = "0";
          yofri.style.transform = "translateY(24px)";
          pernikahan.style.opacity = "0";
          pernikahan.style.filter = "blur(16px)";
          date.style.opacity = "0";
          date.style.filter = "blur(16px)";
          return;
        }

        if (scrolled <= pauseEnd) {
          img.style.transform = "scale(1)";
          blur.style.opacity = "0";
          overlay.style.opacity = "0";
          aisha.style.opacity = "0";
          aisha.style.transform = "translateY(24px)";
          amp.style.opacity = "0";
          amp.style.transform = "translateY(18px) scale(0.85)";
          yofri.style.opacity = "0";
          yofri.style.transform = "translateY(24px)";
          pernikahan.style.opacity = "0";
          pernikahan.style.filter = "blur(16px)";
          date.style.opacity = "0";
          date.style.filter = "blur(16px)";
          return;
        }

        const blurProgress = Math.min(
          Math.max((scrolled - pauseEnd) / (yofriEnd - pauseEnd), 0),
          1,
        );
        img.style.transform = "scale(1)";
        blur.style.opacity = `${blurProgress}`;
        overlay.style.opacity = `${blurProgress * 0.3}`;

        const aishaProgress = Math.min(
          Math.max((scrolled - aishaStart) / (aishaEnd - aishaStart), 0),
          1,
        );
        aisha.style.opacity = `${aishaProgress}`;
        aisha.style.transform = `translateY(${24 * (1 - aishaProgress)}px)`;

        const ampProgress = Math.min(
          Math.max((scrolled - ampStart) / (ampEnd - ampStart), 0),
          1,
        );
        const ampScale = 0.85 + 0.15 * ampProgress;
        amp.style.opacity = `${ampProgress}`;
        amp.style.transform = `translateY(${18 * (1 - ampProgress)}px) scale(${ampScale})`;

        const yofriProgress = Math.min(
          Math.max((scrolled - yofriStart) / (yofriEnd - yofriStart), 0),
          1,
        );
        yofri.style.opacity = `${yofriProgress}`;
        yofri.style.transform = `translateY(${24 * (1 - yofriProgress)}px)`;

        const pProgress = Math.min(
          Math.max((scrolled - pernikahanStart) / (pernikahanEnd - pernikahanStart), 0),
          1,
        );
        const pReveal = getBlurReveal(pProgress);
        pernikahan.style.opacity = pReveal.opacity;
        pernikahan.style.filter = pReveal.filter;

        const dProgress = Math.min(
          Math.max((scrolled - dateStart) / (dateEnd - dateStart), 0),
          1,
        );
        const dReveal = getBlurReveal(dProgress);
        date.style.opacity = dReveal.opacity;
        date.style.filter = dReveal.filter;
      };

      const scheduleUpdate = () => {
        if (ticking || !heroActive) return;
        ticking = true;
        requestAnimationFrame(update);
      };

      const initialState = () => {
        img.style.transform = "scale(2.8)";
        blur.style.opacity = "0";
        overlay.style.opacity = "0";
        aisha.style.opacity = "0";
        aisha.style.transform = "translateY(24px)";
        amp.style.opacity = "0";
        amp.style.transform = "translateY(18px) scale(0.85)";
        yofri.style.opacity = "0";
        yofri.style.transform = "translateY(24px)";
        pernikahan.style.opacity = "0";
        pernikahan.style.filter = "blur(16px)";
        date.style.opacity = "0";
        date.style.filter = "blur(16px)";
      };

      initialState();
      window.addEventListener("scroll", scheduleUpdate, { passive: true });
      window.addEventListener("resize", scheduleUpdate, { passive: true });
      update();
    }
  }
</script>
