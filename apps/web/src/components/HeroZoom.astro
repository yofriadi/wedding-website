---
---
<section class="relative hero-scroll" id="hero-container">
  <div class="hero-stage sticky top-0 w-full overflow-hidden">
    <!-- Sharp image stays visible while the hero zooms out. -->
    <picture>
      <source srcset="/wedding_photo-390.avif 390w, /wedding_photo-640.avif 640w, /wedding_photo.avif 768w, /wedding_photo-1024.avif 1024w, /wedding_photo-1536.avif 1536w" sizes="min(280vw, 1536px)" type="image/avif" />
      <source srcset="/wedding_photo-390.webp 390w, /wedding_photo-640.webp 640w, /wedding_photo.webp 768w, /wedding_photo-1024.webp 1024w, /wedding_photo-1536.webp 1536w" sizes="min(280vw, 1536px)" type="image/webp" />
      <img
        src="/wedding_photo-1024.webp"
        srcset="/wedding_photo-390.webp 390w, /wedding_photo-640.webp 640w, /wedding_photo.webp 768w, /wedding_photo-1024.webp 1024w, /wedding_photo-1536.webp 1536w"
        sizes="min(280vw, 1536px)"
        width="1024"
        height="1835"
        alt="Aisha and Yofri displaying their wedding rings"
        data-hero-media
        fetchpriority="high"
        loading="eager"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover animate-image"
      />
    </picture>
    <!-- Pre-blurred layer fades in instead of animating an expensive CSS filter. -->
    <picture>
      <source src="/wedding_photo_blur.avif" type="image/avif" />
      <source src="/wedding_photo_blur.webp" type="image/webp" />
      <img
        src="/wedding_photo_blur.webp"
        width="768"
        height="1376"
        alt=""
        aria-hidden="true"
        loading="eager"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover animate-blur"
      />
    </picture>
    <div class="absolute inset-0 z-10 bg-black pointer-events-none animate-overlay"></div>

    <!-- Overlay Content (Names & Date) -->
    <div class="absolute inset-0 flex flex-col items-center justify-center z-20 pointer-events-none">
      <div class="w-full max-w-5xl px-5 text-center text-balance space-y-2 animate-text">
        <h1 class="text-5xl md:text-8xl font-serif text-white tracking-tight drop-shadow-lg">
          Yofri <span class="text-white/80 font-light italic">&</span> Aisha
        </h1>
        <p class="text-xl md:text-2xl font-light text-white/90 tracking-widest font-serif">
          <time datetime="2026-10-10" class="animate-date">October 10, 2026</time>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* The 300lvh section gives the 100lvh stage 200lvh of pinned travel.

     lvh, not svh: `lvh` is the viewport with browser chrome HIDDEN, which is the
     state the pinned sequence is actually watched in — every browser retracts the
     URL bar as soon as you scroll down. At `svh` the sticky stage would be ~70px
     shorter than the visible area for the entire pinned phase, exposing a band of
     section background under it. Sized `lvh` the stage matches the screen exactly
     once the bar is gone; the cost is that the bottom ~70px sits below the fold at
     rest, before the first scroll.

     Never `dvh`: dvh re-resolves while the chrome collapses, so the runway would
     silently change length mid-scroll and jump the scrub. lvh is as static as svh.

     The `vh` fallback agrees with `lvh` by construction — iOS Safari's legacy `vh`
     has always been the large viewport. */
  .hero-scroll {
    height: 300vh;
    height: 300lvh;
  }
  .hero-stage {
    height: 100vh;
    height: 100lvh;
  }
  .hero-scroll,
  .hero-stage {
    /* Keep the cinematic sequence stable while mobile browser chrome changes. */
    min-height: 0;
  }
  .animate-image,
  .animate-blur {
    transform-origin: center 40%;
    will-change: transform, opacity;
  }

  /* The static fallback is the readable, fully revealed hero. Enhanced modes override it. */
  .animate-image {
    transform: scale(1);
  }
  .animate-blur {
    opacity: 1;
  }
  .animate-overlay {
    opacity: 0.3;
  }
  .animate-text {
    opacity: 1;
    transform: translateY(0);
    will-change: transform, opacity;
  }

  /* --sweep is the % position of the reveal band's center across the date.
     -17% = fully hidden, 117% = fully revealed solid text. */
  @property --sweep {
    syntax: "<percentage>";
    inherits: false;
    initial-value: 117%;
  }

  /* Dia-style band sweep without framer-motion: one gradient whose stops all
     derive from --sweep. Revealed glyphs are white, the moving band is a warm
     champagne/gold shimmer, the unrevealed tail is transparent. Painted via
     background-clip: text, so it composites correctly over the photo. */
  .animate-date {
    color: transparent;
    -webkit-background-clip: text;
    background-clip: text;
    background-image: linear-gradient(
      90deg,
      rgb(255 255 255 / 0.9) 0%,
      rgb(255 255 255 / 0.9) calc(var(--sweep, 117%) - 17%),
      #faf0e0 calc(var(--sweep, 117%) - 17%),
      #f0d6a8 calc(var(--sweep, 117%) - 5.667%),
      #e2ab63 calc(var(--sweep, 117%) + 5.667%),
      #f6e9d2 calc(var(--sweep, 117%) + 17%),
      transparent calc(var(--sweep, 117%) + 17%),
      transparent 100%
    );
  }

  /* Map animation progress to the 200lvh period while the stage is pinned. */
  @keyframes image-scroll-effect {
    0% {
      transform: scale(2.8);
    }
    33.333%, 41.667%, 66.667%, 100% {
      transform: scale(1);
    }
  }

  @keyframes blur-reveal {
    0%, 41.667% {
      opacity: 0;
    }
    66.667%, 100% {
      opacity: 1;
    }
  }

  @keyframes overlay-reveal {
    0%, 41.667% {
      opacity: 0;
    }
    66.667%, 100% {
      opacity: 0.3;
    }
  }

  @keyframes text-reveal {
    0%, 41.667% { /* Hidden through the ~83lvh pause. */
      opacity: 0;
      transform: translateY(40px);
    }
    66.667%, 100% { /* Fully visible by ~133lvh and held. */
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* The names finish fading in at 66.667%; hold the date hidden a touch longer,
     then sweep it in — 72%→92% of the pinned travel. The keyframe timing
     function is easeInOutCubic, matching magicui's sweepEase. */
  @keyframes date-sweep {
    0%, 72% {
      --sweep: -17%;
      animation-timing-function: cubic-bezier(0.645, 0.045, 0.355, 1);
    }
    92%, 100% {
      --sweep: 117%;
    }
  }

  /* A named view timeline keeps progress local to this hero section. */
  @supports (view-timeline: --hero-progress block) and (animation-timeline: --hero-progress) {
    .hero-scroll {
      view-timeline: --hero-progress block;
      view-timeline-inset: 100% 100%;
    }
    .animate-image {
      animation: image-scroll-effect var(--ease-out-zoom) both;
      animation-timeline: --hero-progress;
      animation-range: 0% 100%;
    }
    .animate-blur {
      animation: blur-reveal linear both;
      animation-timeline: --hero-progress;
      animation-range: 0% 100%;
    }
    .animate-overlay {
      animation: overlay-reveal linear both;
      animation-timeline: --hero-progress;
      animation-range: 0% 100%;
    }
    .animate-text {
      animation: text-reveal linear both;
      animation-timeline: --hero-progress;
      animation-range: 0% 100%;
    }
    .animate-date {
      animation-name: date-sweep;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: --hero-progress;
      animation-range: 0% 100%;
    }
  }

  /* Unsupported browsers keep the static hero until the JS enhancement initializes. */

  /* Reduced-motion users get the complete, readable hero without a scroll sequence. */
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll {
      height: 100vh;
      height: 100lvh;
    }
    .hero-stage {
      position: relative !important;
    }
    .animate-image,
    .animate-blur,
    .animate-overlay,
    .animate-text,
    .animate-date {
      animation: none !important;
    }
    .animate-image {
      transform: scale(1) !important;
    }
    .animate-blur {
      opacity: 1 !important;
    }
    .animate-overlay {
      opacity: 0.3 !important;
    }
    .animate-text {
      opacity: 1 !important;
      transform: translateY(0) !important;
    }
  }
</style>

<script is:inline>
  // Section-relative fallback for browsers without named view-timeline support.
  const supportsScrollTimeline =
    CSS.supports("view-timeline: --hero-progress block") &&
    CSS.supports("animation-timeline: --hero-progress");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!supportsScrollTimeline && !prefersReducedMotion) {
    const section = document.querySelector("#hero-container");
    const img = section?.querySelector(".animate-image");
    const blur = section?.querySelector(".animate-blur");
    const overlay = section?.querySelector(".animate-overlay");
    const text = section?.querySelector(".animate-text");
    const date = section?.querySelector(".animate-date");
    const stage = section?.querySelector(".hero-stage");

    if (section && img && blur && overlay && text && date) {
      let ticking = false;
      let heroActive = true;

      // Gate the fallback while the hero is far offscreen: scroll events then
      // perform no rect reads and no style writes.
      if (typeof IntersectionObserver !== "undefined") {
        const observer = new IntersectionObserver(
          (entries) => {
            heroActive = entries[entries.length - 1].isIntersecting;
          },
          { rootMargin: "100% 0px 100% 0px" },
        );
        observer.observe(section);
      }

      // Same cubic-in-out as magicui's sweepEase; matches the CSS keyframe timing.
      const easeInOutCubic = (t) =>
        t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2;
      // t: 0 = hidden, 1 = fully revealed. Mirrors the date-sweep keyframes.
      const setSweep = (t) =>
        date.style.setProperty("--sweep", `${-17 + 134 * easeInOutCubic(t)}%`);

      const update = () => {
        ticking = false;
        const sectionRect = section.getBoundingClientRect();
        const scrolled = Math.max(0, -sectionRect.top);
        const viewportHeight =
          stage?.getBoundingClientRect().height || document.documentElement.clientHeight;

        const travel = Math.max(
          sectionRect.height - viewportHeight,
          1,
        );
        // Phase boundaries mirror the CSS keyframes (33.333% / 41.667% / 66.667%).
        const zoomEnd = travel / 3;
        const pauseEnd = (travel * 5) / 12;
        const blurEnd = (travel * 2) / 3;
        // Date sweep runs 72%→92% of the timeline — after the names are fully
        // revealed at 66.667%, plus a beat. Mirrors date-sweep keyframes.
        const sweepStart = (travel * 18) / 25;
        const sweepEnd = (travel * 23) / 25;

        if (scrolled <= zoomEnd) {
          const progress = Math.min(scrolled / zoomEnd, 1);
          const eased = 1 - Math.pow(1 - progress, 3); // easeOutCubic, matches the CSS curve.
          const scale = 2.8 - eased * 1.8;
          img.style.transform = `scale(${scale})`;
          blur.style.opacity = "0";
          overlay.style.opacity = "0";
          text.style.opacity = "0";
          text.style.transform = "translateY(40px)";
          setSweep(0);
          return;
        }

        if (scrolled <= pauseEnd) {
          img.style.transform = "scale(1)";
          blur.style.opacity = "0";
          overlay.style.opacity = "0";
          text.style.opacity = "0";
          text.style.transform = "translateY(40px)";
          setSweep(0);
          return;
        }

        const progress = Math.min(
          Math.max((scrolled - pauseEnd) / (blurEnd - pauseEnd),
          0),
          1,
        );
        img.style.transform = "scale(1)";
        blur.style.opacity = `${progress}`;
        overlay.style.opacity = `${progress * 0.3}`;
        text.style.opacity = `${progress}`;
        text.style.transform = `translateY(${40 * (1 - progress)}px)`;
        const sweepProgress = Math.min(
          Math.max((scrolled - sweepStart) / (sweepEnd - sweepStart), 0),
          1,
        );
        setSweep(sweepProgress);
      };

      const scheduleUpdate = () => {
        if (ticking || !heroActive) return;
        ticking = true;
        requestAnimationFrame(update);
      };

      const initialState = () => {
        img.style.transform = "scale(2.8)";
        blur.style.opacity = "0";
        overlay.style.opacity = "0";
        text.style.opacity = "0";
        text.style.transform = "translateY(40px)";
        setSweep(0);
      };

      initialState();
      window.addEventListener("scroll", scheduleUpdate, { passive: true });
      window.addEventListener("resize", scheduleUpdate, { passive: true });
      update();
    }
  }
</script>
