---
/**
 * ZoomParallax Component - Tunnel Vision Edition
 * 
 * Concept: "Parent Scaling"
 * - Each item is wrapped in a full-screen absolute container (The "Wrapper").
 * - The wrapper is centered in the viewport.
 * - The image is positioned absolutely inside the wrapper to match its grid slot.
 * - Animation: We scale the *Wrapper* up. 
 * - Result: The image (offset from center) moves radially outward and scales up, creating a 3D tunnel effect.
 */

const pictures = [
  // 1. Top Right Square (single right column, top)
  { 
    src: "/square-top-right.webp", 
    alt: "Square Top Right",
    grid: { col: 2, row: 0, w: 1, h: 1 },
    scale: 9, // Fast (Outer edge)
    iw: 1024, ih: 1024
  },
  // 2. Upper Right Square (single right column, upper)
  { 
    src: "/square-upper-right.webp", 
    alt: "Square Upper Right",
    grid: { col: 2, row: 1, w: 1, h: 1 },
    scale: 8, // Fast (Side edge)
    iw: 1024, ih: 1024
  },
  // 3. Top Left Landscape (two columns on left)
  { 
    src: "/landscape-top-left.webp", 
    alt: "Landscape Top Left",
    grid: { col: 0, row: 0, w: 2, h: 1 },
    scale: 7, // Medium-Fast (Top edge)
    iw: 1024, ih: 576
  },
  // 4. Mid Left Landscape (two columns on left)
  { 
    src: "/landscape-mid-left.webp", 
    alt: "Landscape Mid Left",
    grid: { col: 0, row: 1, w: 2, h: 1 },
    scale: 5, // Slow (Inner ring)
    iw: 1024, ih: 768
  },
  // 5. Mid Left Square
  { 
    src: "/square-mid-left.webp", 
    alt: "Square Mid Left",
    grid: { col: 0, row: 2, w: 1, h: 1 },
    scale: 8, // Fast (Side edge)
    iw: 473, ih: 1024
  },
  // 6. CENTER HERO - The Focus (keeps 9:16 portrait aspect)
  { 
    src: "/center-focus.webp", 
    alt: "CENTER FOCUS",
    isCenter: true,
    grid: { col: 1, row: 2, w: 1, h: 1 }, 
    scale: 4,
    iw: 1920, ih: 1280
  },
  // 7. Mid Right Square
  { 
    src: "/square-mid-right.webp", 
    alt: "Square Mid Right",
    grid: { col: 2, row: 2, w: 1, h: 1 },
    scale: 8, // Fast (Side edge)
    iw: 1024, ih: 768
  },
  // 8. Bottom Left Portrait
  { 
    src: "/portrait-bottom-left.webp", 
    alt: "Portrait Bottom Left",
    grid: { col: 0, row: 3, w: 1, h: 2 },
    scale: 9, // Fast (Corner)
    iw: 768, ih: 1024
  },
  // 9. Mid Bottom Landscape
  { 
    src: "/landscape-mid-bottom.webp", 
    alt: "Landscape Mid Bottom",
    grid: { col: 1, row: 3, w: 2, h: 1 },
    scale: 5, // Slow (Inner ring)
    iw: 1024, ih: 473
  },
  // 10. Bottom Right Landscape
  { 
    src: "/landscape-bottom-right.webp", 
    alt: "Landscape Bottom Right",
    grid: { col: 1, row: 4, w: 2, h: 1 },
    scale: 7, // Medium-Fast (Bottom edge)
    iw: 1024, ih: 577
  }
];

const COL_W = 33.333; // 33.333vw
---

<div id="zoom-parallax-container" class="zoom-container relative w-full">
  <div class="zoom-stage sticky top-0 w-full overflow-hidden bg-neutral-950">
    
    <!-- Items Wrapper -->
    {pictures.map((picture, slotIndex) => (
      <div 
        class="zoom-wrapper absolute inset-0 w-full h-full pointer-events-none flex items-center justify-center will-change-transform"
        data-is-center={picture.isCenter}
        data-scale-target={picture.scale}
        data-slot={slotIndex}
        style={{ zIndex: picture.isCenter ? 50 : 10 }}
      >
        <!-- Inner Image Container (Positioned absolutely relative to grid) -->
        <div 
          class="zoom-inner absolute overflow-hidden shadow-2xl ring-1 ring-white/10"
          style={`
            left: ${picture.grid.col * COL_W}vw; 
            width: ${picture.grid.w * COL_W}vw; 
          `}
        >
          <!-- Deferred by design (media-tiering): no live src/srcset ships in
               the markup, so no collage byte moves until the tier says so.
               `full` promotes during the parse (inline promoter in
               index.astro, immediately after this markup); `pending` promotes
               on resolution to `full`; `lite` promotes per image as the
               collage approaches (IntersectionObserver below). Intrinsic
               width/height stay in the markup so the slots never reflow when
               a source lands. -->
          <picture>
            <source data-srcset={`${picture.src.replace(/\.webp$/, ".avif")}`} type="image/avif" />
            <img
              data-src={picture.src}
              alt={picture.alt}
              width={picture.iw}
              height={picture.ih}
              class="zoom-image"
              decoding="async"
            />
          </picture>
        </div>
      </div>
    ))}
    
  </div>
</div>

<!--
  No scripting: nothing promotes the deferred collage sources, so the pinned
  runway would be four screens of empty frames. Collapse it to the same
  one-viewport grid the lite tier shows. This is absence-keyed, not
  value-keyed, so it cannot conflict with the `lite`/`pending` rules below and
  it disappears on a real rollback (which reverts the deferred markup too).
  Media-tiering D4 accepted a degraded no-JS tail; this keeps it to one screen.
-->
<noscript>
  <style>
    #zoom-parallax-container {
      height: 100vh !important;
      height: 100lvh !important;
    }
    #zoom-parallax-container .zoom-stage {
      position: relative !important;
    }
  </style>
</noscript>

<script>
  import { scroll } from "motion";

  // Cleanup storage
  let cleanupFns: Array<() => void> = [];
  let resizeTimeout: number | undefined;
  // Viewport width the current bindings were measured against. Height-only
  // `resize` events are mobile browser chrome collapsing, not a layout change:
  // every length here is vw/svh-based, so re-initializing on them would only
  // tear down and rebuild the scroll bindings mid-scroll (scroll-motion spec:
  // no bindings are rebuilt in response to a height-only resize). Same guard
  // TimelineScroll uses.
  let measuredWidth = 0;

  // --- Media tier ------------------------------------------------------------
  // Layout.astro's head script owns `html[data-tier]`; this component only
  // reads it. `full` gets the pinned scroll-zoom plus every collage byte at
  // parse time. `lite` and `pending` get the collapsed static bento grid, no
  // scroll binding, and per-image promotion as the collage approaches.
  const COLLAGE_IMAGES = "#zoom-parallax-container img[data-src]:not([src])";
  // Generous on purpose: a lite guest pays for a photo well before it could be
  // seen, so the frames are never empty on arrival. Two viewport heights also
  // absorb a `pending → full` resolution that lands after the guest already
  // scrolled — promotion is idempotent, so the worst case is a late load,
  // never a missing one.
  //
  // Computed in pixels rather than written as "200% 0px": a percentage root
  // margin resolves per-axis against the root box, and engines have not agreed
  // on the vertical axis, so the same string can mean two viewport HEIGHTS or
  // two viewport WIDTHS. On a portrait phone those differ by more than 2x, and
  // a sub-viewport margin is exactly the empty-frames-on-arrival failure this
  // margin exists to prevent.
  function promoteMargin(): string {
    return `${Math.round(window.innerHeight * 2)}px 0px`;
  }

  let deferredObserver: IntersectionObserver | null = null;
  // The margin the live observer was built with, so a viewport change can tell
  // a rebuild is needed instead of silently keeping a stale rootMargin.
  let deferredMargin = "";
  let bound = false;

  function mediaTier(): string | null {
    return document.documentElement.getAttribute("data-tier");
  }

  // Only an explicit `lite`/`pending` collapses. A MISSING attribute means the
  // head script never ran (rollback, an inline-script blocker, an exception),
  // and media-tiering D4 requires that case to behave like `full` — the same
  // way the CSS does, since its collapse rules key on those two values. Ask
  // "is it collapsed?" rather than "is it full?": getting this backwards leaves
  // the JS and the CSS disagreeing, with a 400lvh pinned runway that nothing
  // scrubs and a collage nothing promotes.
  function isCollapsedTier(): boolean {
    const tier = mediaTier();
    return tier === "lite" || tier === "pending";
  }

  function promoteImage(img: HTMLImageElement) {
    // <source> first: the moment the <img> grows a src the <picture>
    // re-resolves, and promoting in the other order would fetch the WebP
    // fallback and then the AVIF over it.
    const picture = img.closest("picture");
    picture?.querySelectorAll("source[data-srcset]:not([srcset])").forEach((source) => {
      const srcset = source.getAttribute("data-srcset");
      if (srcset) source.setAttribute("srcset", srcset);
    });
    const src = img.getAttribute("data-src");
    if (src && !img.getAttribute("src")) img.setAttribute("src", src);
  }

  function promoteAll() {
    document.querySelectorAll<HTMLImageElement>(COLLAGE_IMAGES).forEach(promoteImage);
  }

  function watchDeferredImages() {
    if (typeof IntersectionObserver === "undefined") return;
    // A rotation or a width-changing resize alters the viewport this margin was
    // computed from, and both re-enter here — so rebuild rather than keep a
    // rootMargin measured against a viewport that no longer exists.
    const margin = promoteMargin();
    if (deferredObserver && margin === deferredMargin) return;
    stopWatchingDeferredImages();
    const images = document.querySelectorAll<HTMLImageElement>(COLLAGE_IMAGES);
    if (images.length === 0) return;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          promoteImage(entry.target as HTMLImageElement);
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: margin }
    );
    images.forEach((img) => observer.observe(img));
    deferredObserver = observer;
    deferredMargin = margin;
  }

  function stopWatchingDeferredImages() {
    deferredObserver?.disconnect();
    deferredObserver = null;
  }

  // Re-read the verdict whenever the head script resolves or downgrades it.
  //
  // `rebuild` separates the two callers. Resize and (re)initialization must
  // re-measure the center scale against the current stage rect, so they
  // rebuild. A tier change must not: `net-tier:change` can fire between module
  // evaluation and DOMContentLoaded (the observer callback is a task and the
  // parser yields between chunks), and rebuilding from both would bind twice in
  // one page load — two layout flushes, contradicting the archived
  // scroll-motion requirement that ZoomParallax binds exactly once.
  function applyTier(rebuild: boolean) {
    if (!isCollapsedTier()) {
      stopWatchingDeferredImages();
      promoteAll();
      if (rebuild || !bound) bindScrollZoomIfEligible();
    } else {
      teardownScrollZoom();
      watchDeferredImages();
    }
  }

  function onTierChange() {
    applyTier(false);
  }

  function bindScrollZoomIfEligible() {
    // Reduced motion: the static bento grid is the content; bind no
    // scroll-driven transforms and let the CSS media query collapse the pin.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    // Tier gate: while collapsed the stage stays static (see the CSS below) and
    // no scroll-driven zoom runs. A `pending` tier that resolves to `full`
    // re-enters here through the net-tier:change listener; a `full → lite`
    // downgrade tears the binding down again.
    if (isCollapsedTier()) return;

    // Re-binding is the resize path too: bindScrollZoom drops the previous
    // cleanup and re-measures the center scale against the current stage rect.
    bindScrollZoom();
  }

  // `rebuild` is true only when the geometry the bindings were measured
  // against has changed — a width-changing resize, or a client navigation to a
  // fresh document. First initialization passes false: a `pending → full`
  // resolution can arrive between module evaluation and DOMContentLoaded, and
  // rebuilding there would bind twice in one page load and flush layout twice,
  // contradicting the archived scroll-motion requirement.
  function initZoomParallax(rebuild = false) {
    // Record the width the measurements below are taken against, so
    // handleResize can ignore the height-only resizes browser chrome emits.
    measuredWidth = window.innerWidth;

    // Deferred promotion and the scroll binding are both tier-driven, and
    // promotion runs on every tier and every motion preference: the static
    // grid is content, and an unpromoted <img> is an empty frame.
    applyTier(rebuild);
  }

  function bindScrollZoom() {
    const container = document.getElementById("zoom-parallax-container");
    const wrappers = document.querySelectorAll(".zoom-wrapper");

    if (!container || wrappers.length === 0) return;

    const stage = container.querySelector(".zoom-stage") as HTMLElement | null;
    if (!stage) return;

    // Cleanup previous scroll bindings
    cleanupFns.forEach(fn => fn());
    cleanupFns = [];

    // Reset all transforms to baseline before measuring/animating
    wrappers.forEach(w => {
      (w as HTMLElement).style.transform = "scale(1)";
    });

    // Force layout flush
    container.getBoundingClientRect();

    // Center Logic
    const centerWrapper = document.querySelector('[data-is-center="true"]') as HTMLElement;
    let centerScaleFactor = 4;

    if (centerWrapper) {
      const inner = centerWrapper.querySelector('.zoom-inner') as HTMLElement;
      if (inner) {
        // Calculate the scale that makes the center image cover the stage.
        // The wrapper is full screen (100x100); the inner is smaller, and
        // scaling the wrapper scales the inner with it.
        // Measured against the stage's own rect rather than
        // window.innerWidth/innerHeight: the dynamic viewport re-resolves every
        // time mobile browser chrome collapses, which would change the finale's
        // crop mid-scroll. The stage is also the right thing to cover — it is
        // what clips the image.
        const stageRect = stage.getBoundingClientRect();
        const rect = inner.getBoundingClientRect();
        const scaleX = stageRect.width / rect.width;
        const scaleY = stageRect.height / rect.height;
        centerScaleFactor = Math.max(scaleX, scaleY) * 1.01; // No gaps
      }
    }

    const cleanup = scroll(
      (progress: number) => {
        wrappers.forEach((wrapper) => {
          const el = wrapper as HTMLElement;
          const isCenter = el.dataset.isCenter === "true";
          const scaleTarget = parseFloat(el.dataset.scaleTarget || "1");

          let currentScale = 1;
          if (isCenter) {
            // 0-10%: Hold at 1
            // 10-80%: Scale up to centerScaleFactor
            // 80-100%: Hold at centerScaleFactor
            if (progress <= 0.1) {
              currentScale = 1;
            } else if (progress >= 0.8) {
              currentScale = centerScaleFactor;
            } else {
              const p = (progress - 0.1) / 0.7;
              currentScale = 1 + (centerScaleFactor - 1) * p;
            }
          } else {
            // 0-10%: Hold at 1
            // 10-100%: Scale up to scaleTarget
            if (progress <= 0.1) {
              currentScale = 1;
            } else {
              const p = (progress - 0.1) / 0.9;
              currentScale = 1 + (scaleTarget - 1) * p;
            }
          }
          el.style.transform = `scale(${currentScale})`;
        });
      },
      {
        target: container,
        offset: ["start start", "end end"],
      }
    );
    cleanupFns.push(cleanup);
    bound = true;
  }

  // Downgrade (full → lite): stop the scrub and drop the transforms it wrote,
  // or the collapsed grid would freeze at whatever scale the verdict caught it
  // at. The container/stage collapse itself is CSS, keyed on data-tier.
  function teardownScrollZoom() {
    if (!bound) return;
    cleanupFns.forEach(fn => fn());
    cleanupFns = [];
    bound = false;
    document.querySelectorAll<HTMLElement>(".zoom-wrapper").forEach(w => {
      // Clear rather than write scale(1): the collapsed grid should match the
      // reduced-motion state exactly (no inline transform at all), and a
      // non-`none` transform keeps each of the ten full-viewport wrappers a
      // containing block and a layerization candidate even with will-change
      // released.
      w.style.transform = "";
    });
  }

  function handleResize() {
    // Height-only resizes are mobile browser chrome collapsing or expanding;
    // the vw/svh geometry bound here is unchanged by them, so ignore them
    // instead of tearing down and rebuilding every scroll binding mid-scroll.
    // Cancel any queued rebuild before the guard, not after: a width change
    // that reverts inside the 150 ms debounce would otherwise still fire the
    // queued teardown + rebind + layout flush.
    clearTimeout(resizeTimeout);
    if (window.innerWidth === measuredWidth) return;
    resizeTimeout = setTimeout(() => initZoomParallax(true), 150) as unknown as number;
  }

  window.addEventListener("net-tier:change", onTierChange);

  // astro:page-load covers client navigation (a fresh document, so rebuild);
  // the readyState branch covers the initial load, which this site enters
  // without ClientRouter — no astro:page-load fires on first render. Wrapped
  // rather than passed directly so the Event object is not read as `rebuild`.
  document.addEventListener("astro:page-load", () => initZoomParallax(true));
  window.addEventListener('resize', handleResize);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => initZoomParallax());
  } else {
    initZoomParallax();
  }
</script>

<style>
  /* Runway + stage sized in lvh, not svh: lvh is the viewport with browser
     chrome HIDDEN, which is the state a pinned sequence is actually watched in —
     every mobile browser retracts its URL bar on the first downward scroll. At
     svh the sticky stage sits ~60-80px short of the screen for the whole pinned
     run, exposing page background beneath it (HeroZoom/TimelineScroll already
     made this move; scroll-motion spec: "Pinned stages are sized to the
     chrome-hidden viewport").
     Never dvh: it re-resolves while the chrome collapses, so the runway would
     silently change length mid-scroll and jump the scrub. lvh is as static as
     svh. The vh fallback agrees with lvh by construction — iOS Safari's legacy
     vh already resolves to the large viewport. */
  .zoom-container {
    height: 400vh;
    height: 400lvh;
  }
  .zoom-stage {
    height: 100vh;
    height: 100lvh;
  }

  /* Bento slot vertical geometry: one rule per slot so each top/height pair can */
  /* carry its vh -> lvh fallback. Horizontal vw values stay inline per item.    */
  [data-slot="0"] .zoom-inner { top: 0vh; top: 0lvh; height: 20vh; height: 20lvh; }
  [data-slot="1"] .zoom-inner { top: 20vh; top: 20lvh; height: 20vh; height: 20lvh; }
  [data-slot="2"] .zoom-inner { top: 0vh; top: 0lvh; height: 20vh; height: 20lvh; }
  [data-slot="3"] .zoom-inner { top: 20vh; top: 20lvh; height: 20vh; height: 20lvh; }
  [data-slot="4"] .zoom-inner { top: 40vh; top: 40lvh; height: 20vh; height: 20lvh; }
  [data-slot="5"] .zoom-inner { top: 40vh; top: 40lvh; height: 20vh; height: 20lvh; }
  [data-slot="6"] .zoom-inner { top: 40vh; top: 40lvh; height: 20vh; height: 20lvh; }
  [data-slot="7"] .zoom-inner { top: 60vh; top: 60lvh; height: 40vh; height: 40lvh; }
  [data-slot="8"] .zoom-inner { top: 60vh; top: 60lvh; height: 20vh; height: 20lvh; }
  [data-slot="9"] .zoom-inner { top: 80vh; top: 80lvh; height: 20vh; height: 20lvh; }

  .zoom-inner {
    /* Subtle border for separation in bento state */
    outline: 1px solid rgba(0,0,0,0.2); 
    background: #050505;
  }

  .zoom-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* `translateZ(0)` alone is enough to keep the image on its own texture
       during the parent's scale. The scroll scrub transforms .zoom-wrapper,
       never this element, so hinting `transform` here only doubles the
       number of full-viewport layers the compositor holds. */
    transform: translateZ(0);
  }

  /* Deferred sources: until promotion gives the <img> a real src the browser
     would paint its alt text into the slot. Hide the placeholder so an
     unpromoted frame reads as an empty frame, not a broken image. Geometric
     only — IntersectionObserver still sees the element. */
  .zoom-image:not([src]) {
    visibility: hidden;
  }

  /* Lite/pending collapse (media-tiering D4): the stage stops pinning and the
     runway shrinks to one viewport, so the ten photos read as a static bento
     grid in normal document flow with no scroll-driven zoom.
     Keyed on the explicit tier values and NEVER on `:not([data-tier="full"])`:
     a rolled-back build without the head script then degrades to today's full
     behavior instead of a broken static page.
     `position: relative` rather than `static` keeps the stage as the
     containing block for the absolutely positioned bento slots — the same
     collapse the reduced-motion rule below already ships. */
  :global(html[data-tier="lite"]) .zoom-container,
  :global(html[data-tier="pending"]) .zoom-container {
    height: 100vh !important;
    height: 100lvh !important;
  }
  :global(html[data-tier="lite"]) .zoom-stage,
  :global(html[data-tier="pending"]) .zoom-stage {
    position: relative !important;
  }

  /* Nothing transforms these wrappers while collapsed, so the compositor
     promotion hint only reserves ten full-viewport layers for an animation
     that will never run. Release them: the population paying for those layers
     is the low-memory device population the lite tier exists to serve. A
     `pending → full` resolution restores the hint by dropping out of this
     selector. The reduced-motion block below does the same for the identical
     static presentation, so neither collapse path is asymmetric. */
  :global(html[data-tier="lite"]) .zoom-wrapper,
  :global(html[data-tier="pending"]) .zoom-wrapper {
    will-change: auto !important;
  }

  /* Reduced motion: the bento grid is static, readable content in one viewport. */
  @media (prefers-reduced-motion: reduce) {
    .zoom-container {
      height: 100vh !important;
      height: 100lvh !important;
    }
    .zoom-stage {
      position: relative !important;
    }
    .zoom-wrapper {
      will-change: auto !important;
    }
  }
</style>
