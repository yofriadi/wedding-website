---
/**
 * ZoomParallax Component - Tunnel Vision Edition
 * 
 * Concept: "Parent Scaling"
 * - Each item is wrapped in a full-screen absolute container (The "Wrapper").
 * - The wrapper is centered in the viewport.
 * - The image is positioned absolutely inside the wrapper to match its grid slot.
 * - Animation: We scale the *Wrapper* up. 
 * - Result: The image (offset from center) moves radially outward and scales up, creating a 3D tunnel effect.
 */

const pictures = [
  // 1. Top Right Portrait (single right column)
  { 
    src: "/10.webp", 
    alt: "Portrait Top Right",
    grid: { col: 2, row: 0, w: 1, h: 2 },
    scale: 9, // Fast (Outer edge)
    iw: 576, ih: 1024
  },
  // 2. Top Left Landscape (two columns on left)
  { 
    src: "/3.webp", 
    alt: "Landscape Top Left",
    grid: { col: 0, row: 0, w: 2, h: 1 },
    scale: 7, // Medium-Fast (Top edge)
    iw: 1024, ih: 576
  },
  // 3. Mid Left Landscape (two columns on left)
  { 
    src: "/4.webp", 
    alt: "Landscape Mid Left",
    grid: { col: 0, row: 1, w: 2, h: 1 },
    scale: 5, // Slow (Inner ring)
    iw: 1024, ih: 768
  },
  // 4. Mid Left Square
  { 
    src: "/14.webp", 
    alt: "Square Mid Left",
    grid: { col: 0, row: 2, w: 1, h: 1 },
    scale: 8, // Fast (Side edge)
    iw: 473, ih: 1024
  },
  // 5. CENTER HERO - The Focus (keeps 9:16 portrait aspect)
  { 
    src: "/1.webp", 
    alt: "CENTER FOCUS",
    isCenter: true,
    grid: { col: 1, row: 2, w: 1, h: 1 }, 
    scale: 4,
    iw: 1920, ih: 1280
  },
  // 6. Mid Right Square
  { 
    src: "/6.webp", 
    alt: "Square Mid Right",
    grid: { col: 2, row: 2, w: 1, h: 1 },
    scale: 8, // Fast (Side edge)
    iw: 1024, ih: 768
  },
  // 7. Bottom Left Portrait
  { 
    src: "/15.webp", 
    alt: "Portrait Bottom Left",
    grid: { col: 0, row: 3, w: 1, h: 2 },
    scale: 9, // Fast (Corner)
    iw: 768, ih: 1024
  },
  // 8. Mid Bottom Landscape
  { 
    src: "/18.webp", 
    alt: "Landscape Mid Bottom",
    grid: { col: 1, row: 3, w: 2, h: 1 },
    scale: 5, // Slow (Inner ring)
    iw: 1024, ih: 473
  },
  // 9. Bottom Right Landscape
  { 
    src: "/7.webp", 
    alt: "Landscape Bottom Right",
    grid: { col: 1, row: 4, w: 2, h: 1 },
    scale: 7, // Medium-Fast (Bottom edge)
    iw: 1024, ih: 577
  }
];

const COL_W = 33.333; // 33.333vw
const ROW_H = 20;     // 20lvh per row (5 rows = the stage); vertical geometry lives in the per-slot CSS
---

<div id="zoom-parallax-container" class="zoom-container relative w-full" data-progressive-section>
  <div class="zoom-stage sticky top-0 w-full overflow-hidden bg-neutral-950">
    
    <!-- Items Wrapper -->
    {pictures.map((picture, slotIndex) => (
      <div 
        class="zoom-wrapper absolute inset-0 w-full h-full pointer-events-none flex items-center justify-center will-change-transform"
        data-is-center={picture.isCenter}
        data-scale-target={picture.scale}
        data-slot={slotIndex}
        style={{ zIndex: picture.isCenter ? 50 : 10 }}
      >
        <!-- Inner Image Container (Positioned absolutely relative to grid) -->
        <div 
          class="zoom-inner absolute overflow-hidden shadow-2xl ring-1 ring-white/10"
          style={`
            left: ${picture.grid.col * COL_W}vw; 
            width: ${picture.grid.w * COL_W}vw; 
          `}
        >
          <picture>
            <source data-srcset={`${picture.src.replace(/\.webp$/, ".avif")}`} type="image/avif" />
            <img
              data-src={picture.src}
              alt={picture.alt}
              width={picture.iw}
              height={picture.ih}
              class="zoom-image"
              decoding="async"
            />
          </picture>
        </div>
      </div>
    ))}
    
  </div>
</div>

<script>
  import { animate, inView, scroll } from "motion";

  // Cleanup storage
  let cleanupFns: Array<() => void> = [];
  let resizeTimeout: number | undefined;
  // The blur reveal is a one-shot that must outlive init's cleanup pass: if the
  // pending timer lived in cleanupFns, a re-init between the inView fire and the
  // reveal would cancel it and strand the images in their hidden (.js) state.
  let revealTimer: ReturnType<typeof setTimeout> | undefined;
  // Viewport width the current bindings were measured against. Height-only
  // `resize` events are mobile browser chrome collapsing, not a layout change:
  // every length here is vw/svh-based, so re-initializing on them would only
  // tear down and rebuild the scroll bindings mid-scroll (scroll-motion spec:
  // no bindings are rebuilt in response to a height-only resize). Same guard
  // TimelineScroll uses.
  let measuredWidth = 0;

  function initZoomParallax() {
    // Record the width the measurements below are taken against, so
    // handleResize can ignore the height-only resizes browser chrome emits.
    measuredWidth = window.innerWidth;

    // Reduced motion: the static bento grid is the content; bind no scroll-driven
    // transforms and let the CSS media query collapse the pin.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const container = document.getElementById("zoom-parallax-container");
    const wrappers = document.querySelectorAll(".zoom-wrapper");

    if (!container || wrappers.length === 0) return;

    const stage = container.querySelector(".zoom-stage") as HTMLElement | null;
    if (!stage) return;

    // Reveal lifecycle, tracked on the stage element (not in this closure) so it
    // survives a re-init and resets with the DOM on client navigation:
    //   absent      - images hidden by .js, waiting for the stage to scroll in
    //   "scheduled" - inView fired; the stagger is queued or running
    //   "done"      - images stay visible; nothing left to bind
    const revealState = stage.dataset.zoomReveal;

    // JS is running and motion is allowed: hide the images for the reveal. Done
    // here (not in markup) so no-JS / reduced-motion never see hidden images.
    // Once the reveal has played the class stays off for good — a later init
    // must never re-hide and re-blur the grid.
    stage.classList.toggle("js", revealState !== "done");

    // Cleanup previous scroll bindings
    cleanupFns.forEach(fn => fn());
    cleanupFns = [];

    // Reset all transforms to baseline before measuring/animating
    wrappers.forEach(w => {
      (w as HTMLElement).style.transform = "scale(1)";
    });

    // Force layout flush
    container.getBoundingClientRect();

    // Center Logic
    const centerWrapper = document.querySelector('[data-is-center="true"]') as HTMLElement;
    let centerScaleFactor = 4;
    
    if (centerWrapper) {
      const inner = centerWrapper.querySelector('.zoom-inner') as HTMLElement;
      if (inner) {
        // Calculate the scale that makes the center image cover the stage.
        // The wrapper is full screen (100x100); the inner is smaller, and
        // scaling the wrapper scales the inner with it.
        // Measured against the stage's own rect rather than
        // window.innerWidth/innerHeight: the dynamic viewport re-resolves every
        // time mobile browser chrome collapses, which would change the finale's
        // crop mid-scroll. The stage is also the right thing to cover — it is
        // what clips the image.
        const stageRect = stage.getBoundingClientRect();
        const rect = inner.getBoundingClientRect();
        const scaleX = stageRect.width / rect.width;
        const scaleY = stageRect.height / rect.height;
        centerScaleFactor = Math.max(scaleX, scaleY) * 1.01; // No gaps
      }
    }

    wrappers.forEach((wrapper) => {
      const el = wrapper as HTMLElement;
      const isCenter = el.dataset.isCenter === "true";
      const scaleTarget = parseFloat(el.dataset.scaleTarget || "1");

      if (isCenter) {
        // CENTER: Hold at entry, then scale to fill, then hold at end
        const animation = animate(
          el,
          { transform: [`scale(1)`, `scale(1)`, `scale(${centerScaleFactor})`, `scale(${centerScaleFactor})`] },
          { ease: "linear" }
        );

        const cleanup = scroll(animation, {
          target: container,
          // 0-10%: Hold (appreciate the grid)
          // 10-80%: Scale up
          // 80-100%: Hold (full image)
          offset: ["start start", "10% start", "80% end", "end end"] 
        });
        
        cleanupFns.push(cleanup);
      } else {
        // OTHERS: Hold at entry, then race forward
        const animation = animate(
          el,
          { transform: [`scale(1)`, `scale(1)`, `scale(${scaleTarget})`] },
          { ease: "linear" }
        );

        const cleanup = scroll(animation, {
          target: container,
          // 0-10%: Hold (appreciate the grid)
          // 10-100%: Scale up
          offset: ["start start", "10% start", "end end"]
        });
        
        cleanupFns.push(cleanup);
      }
    });

    // Blur Fade reveal (Magic UI): each image fades from opacity 0 + blur(6px)
    // with a small upward settle, staggered per image. Triggered once, the first
    // time 10% of the stage scrolls into view, then held back by a short delay
    // so the grid settles before the reveal plays. Reduced-motion users never
    // reach this (initZoomParallax returned early), so their static grid stays
    // fully visible.
    if (!revealState) {
      const images = Array.from(container.querySelectorAll<HTMLElement>(".zoom-image"));
      const REVEAL_DELAY_MS = 400; // wait after the stage scrolls into view

      const stopReveal = inView(stage, () => {
        // Marked before the delay and never cleared. An IntersectionObserver
        // always delivers an initial observation for an element already on
        // screen, so any re-init that re-bound inView while the stage was still
        // in view — the end of the runway, scrolling up and down as the URL bar
        // collapses — replayed the whole reveal. Element state makes that
        // impossible: the observer is only ever bound while the state is unset.
        stage.dataset.zoomReveal = "scheduled";
        clearTimeout(revealTimer);
        revealTimer = setTimeout(() => {
          const finished = images.map((img, i) =>
            animate(
              img,
              { opacity: [0, 1], y: [-6, 0], filter: ["blur(6px)", "blur(0px)"] },
              { delay: i * 0.25, duration: 0.5, ease: "easeOut" }
            ).finished.catch(() => {})
          );
          // Drop the hiding class only after every image has committed its
          // revealed inline styles, so the tail of the stagger never flashes.
          void Promise.all(finished).then(() => {
            stage.dataset.zoomReveal = "done";
            stage.classList.remove("js");
          });
        }, REVEAL_DELAY_MS);
      }, { amount: 0.1 });

      // The observer is a binding (dispose on re-init); the timer is not — it
      // lives at module scope so an in-flight reveal survives one.
      cleanupFns.push(stopReveal);
    }
  }

  function handleResize() {
    // Height-only resizes are mobile browser chrome collapsing or expanding;
    // the vw/svh geometry bound here is unchanged by them, so ignore them
    // instead of tearing down and rebuilding every scroll binding mid-scroll.
    if (window.innerWidth === measuredWidth) return;
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(initZoomParallax, 150) as unknown as number;
  }

  // astro:page-load covers client navigation; the readyState branch covers the
  // initial load, which this site enters without ClientRouter (no astro:page-load
  // event fires on first render).
  document.addEventListener("astro:page-load", initZoomParallax);
  window.addEventListener('resize', handleResize);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initZoomParallax);
  } else {
    initZoomParallax();
  }
</script>

<style>
  /* Blur Fade reveal: images start hidden/blurred only while this component's JS
     is waiting to play it. The class is added from the script (never in markup),
     so no-JS and reduced-motion paths keep images fully visible — and it is
     removed for good once the reveal completes, so a later init can't re-hide
     the grid and replay it. */
  .zoom-stage.js .zoom-image {
    opacity: 0;
    filter: blur(6px);
  }

  /* Runway + stage sized in lvh, not svh: lvh is the viewport with browser
     chrome HIDDEN, which is the state a pinned sequence is actually watched in —
     every mobile browser retracts its URL bar on the first downward scroll. At
     svh the sticky stage sits ~60-80px short of the screen for the whole pinned
     run, exposing page background beneath it (HeroZoom/TimelineScroll already
     made this move; scroll-motion spec: "Pinned stages are sized to the
     chrome-hidden viewport").
     Never dvh: it re-resolves while the chrome collapses, so the runway would
     silently change length mid-scroll and jump the scrub. lvh is as static as
     svh. The vh fallback agrees with lvh by construction — iOS Safari's legacy
     vh already resolves to the large viewport. */
  .zoom-container {
    height: 400vh;
    height: 400lvh;
  }
  .zoom-stage {
    height: 100vh;
    height: 100lvh;
  }

  /* Bento slot vertical geometry: one rule per slot so each top/height pair can */
  /* carry its vh -> lvh fallback. Horizontal vw values stay inline per item.    */
  [data-slot="0"] .zoom-inner { top: 0vh; top: 0lvh; height: 40vh; height: 40lvh; }
  [data-slot="1"] .zoom-inner { top: 0vh; top: 0lvh; height: 20vh; height: 20lvh; }
  [data-slot="2"] .zoom-inner { top: 20vh; top: 20lvh; height: 20vh; height: 20lvh; }
  [data-slot="3"] .zoom-inner { top: 40vh; top: 40lvh; height: 20vh; height: 20lvh; }
  [data-slot="4"] .zoom-inner { top: 40vh; top: 40lvh; height: 20vh; height: 20lvh; }
  [data-slot="5"] .zoom-inner { top: 40vh; top: 40lvh; height: 20vh; height: 20lvh; }
  [data-slot="6"] .zoom-inner { top: 60vh; top: 60lvh; height: 40vh; height: 40lvh; }
  [data-slot="7"] .zoom-inner { top: 60vh; top: 60lvh; height: 20vh; height: 20lvh; }
  [data-slot="8"] .zoom-inner { top: 80vh; top: 80lvh; height: 20vh; height: 20lvh; }

  .zoom-inner {
    /* Subtle border for separation in bento state */
    outline: 1px solid rgba(0,0,0,0.2); 
    background: #050505;
  }

  .zoom-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translateZ(0);
    will-change: transform;
  }

  /* Reduced motion: the bento grid is static, readable content in one viewport. */
  @media (prefers-reduced-motion: reduce) {
    .zoom-container {
      height: 100vh !important;
      height: 100lvh !important;
    }
    .zoom-stage {
      position: relative !important;
    }
  }
</style>
