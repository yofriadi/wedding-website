---
const items = [
  {
    id: "rsvp",
    number: "01",
    title: "Batas waktu konfirmasi kehadiran",
    content: "Untuk memudahkan estimasi tamu & undangan yang hadir, mohon konfirmasi kehadiran paling lambat 5 Oktober 2026."
  },
  {
    id: "dress-code",
    number: "02",
    title: "Ketentuan pakaian (dress code)",
    content: "Dress code acara adalah Black Tie Optional. Tamu pria disarankan mengenakan tuksedo atau setelan jas gelap dan dasi, sedangkan tamu wanita disarankan mengenakan gaun malam atau gaun koktail panjang midi."
  },
  {
    id: "plus-one",
    number: "03",
    title: "Apakah boleh datang berdua?",
    content: "Ya."
  },
  {
    id: "dining",
    number: "04",
    title: "Piring Terbang",
    content: "Kami menggunakan tradisi khas Solo dan Jawa Tengah, yaitu Piring Terbang (Ladosan). Tamu undangan tidak perlu mengantre prasmanan—cukup duduk santai dan menikmati acara, seluruh rangkaian hidangan akan disajikan langsung ke tempat duduk Anda."
  },
  {
    id: "parking",
    number: "05",
    title: "Tempat parkir",
    content: "Area parkir cukup luas tapi tetap tidak cukup besar untuk mengakomodir semua tamu undangan."
  }
];
---

<div class="w-full bg-(--faq-background)" id="wedding-faq">
  <div class="space-y-0 max-w-3xl mx-auto px-4 pt-2 pb-10">
    {items.map((item) => (
      <div class="accordion-item group border-b border-[color:var(--faq-border)]" data-id={item.id}>
        <button class="w-full py-3 relative flex items-center gap-4 text-left focus:outline-none active:scale-[0.98] transition-transform duration-160 ease-out cursor-pointer">
           <!-- Number with animated circle -->
           <div class="relative flex items-center justify-center w-10 h-10 shrink-0">
             <div class="number-bg absolute inset-0 rounded-full bg-[color:var(--faq-badge)] ring-1 ring-[color:var(--faq-badge-ring)] origin-center"></div>
             <span class="number-text relative z-10 text-sm font-medium tracking-wide text-[color:var(--faq-muted-foreground)] transition-colors duration-200">
               {item.number}
             </span>
           </div>

           <!-- Title -->
           <h3 class="title-text text-lg md:text-xl font-serif tracking-tight text-[color:var(--faq-muted-foreground)] text-balance">
             {item.title}
           </h3>
           <!-- Animated indicator -->
            <div class="ml-auto flex items-center justify-center w-8 h-8 shrink-0">
              <div class="icon-plus transition-transform duration-200 text-[color:var(--faq-muted-foreground)]">
               <svg width="20" height="20" viewBox="0 0 16 16" fill="none" class="transition-colors">
                 <path d="M8 1V15M1 8H15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
               </svg>
             </div>
           </div>
           
           <!-- Active Underline -->
            <div class="absolute bottom-0 left-0 h-[1px] bg-[color:var(--faq-foreground)] origin-left scale-x-0 active-line w-full"></div>
        </button>

        <!-- Content -->
         <div class="accordion-content h-0 overflow-hidden opacity-0">
           <p class="pl-14 pr-4 md:pr-10 pb-5 pt-1 text-[color:var(--faq-muted-foreground)] leading-relaxed font-light text-sm text-pretty">
             {item.content}
           </p>
        </div>
      </div>
    ))}
  </div>
</div>


<style>
  /* Theme tokens (this component is the repo precedent): dark is the authored
     default, light inverts the same black/white pair via the OS preference.
     The root paints --faq-background itself because body/main stay
     bg-neutral-950 in either scheme — the same reason #rsvp-section
     and #venue-map own their own chrome. */
  #wedding-faq {
    --faq-background: #0a0a0a;
    --faq-foreground: #fafafa;
    --faq-muted-foreground: #a3a3a3;
    --faq-border: rgba(255, 255, 255, 0.16);
    --faq-badge: var(--faq-background);
    --faq-badge-ring: transparent;
    --faq-primary-foreground: #0a0a0a;
  }

  @media (prefers-color-scheme: light) {
    #wedding-faq {
      --faq-background: #ffffff;
      --faq-foreground: #0a0a0a;
      --faq-muted-foreground: #525252; /* neutral-600: holds contrast on white */
      --faq-border: rgba(0, 0, 0, 0.16);
      --faq-badge: #ffffff;
      --faq-badge-ring: transparent;
      --faq-primary-foreground: #ffffff;
    }
  }

  :global(#wedding-faq .accordion-item:last-child) {
    border-bottom: none;
  }
</style>


<script>
  import { animate, spring } from "motion";


  // JS twin of the CSS --ease-out-expo token; keep in sync.
  const EASE_OUT_EXPO = [0.16, 1, 0.3, 1] as const;

  // Read once at module scope; drives fade-only branches below.
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function initFAQ() {
    const container = document.getElementById('wedding-faq');
    if (!container) return;

    const items = container.querySelectorAll('.accordion-item');
    // Alias for closure use: `container`'s null-narrowing doesn't reach inside
    // nested functions.
    const root = container;

    // Colors are resolved from the cascade on each interaction (SlideToConfirm's
    // readDuration precedent) instead of being captured once at init — the
    // light theme is a media query, so a snapshot could animate stale ink.
    function theme() {
      const styles = getComputedStyle(root);
      return {
        foreground: styles.getPropertyValue('--faq-foreground').trim(),
        mutedForeground: styles.getPropertyValue('--faq-muted-foreground').trim(),
        badgeBase: styles.getPropertyValue('--faq-badge').trim(),
        primaryForeground: styles.getPropertyValue('--faq-primary-foreground').trim(),
      };
    }

    let activeItem: Element | null = null;

    items.forEach(item => {
      const button = item.querySelector('button');
      if (!button) return;

      button.addEventListener('click', () => {
        const isOpen = item === activeItem;

        // Close active if exists
        if (activeItem && activeItem !== item) {
           closeItem(activeItem);
        }

        if (isOpen) {
          closeItem(item);
          activeItem = null;
        } else {
          openItem(item);
          activeItem = item;
        }
      });
    });

    function openItem(item: Element) {
      const content = item.querySelector('.accordion-content') as HTMLElement;
      const numberBg = item.querySelector('.number-bg');
      const numberText = item.querySelector('.number-text');
      const titleText = item.querySelector('.title-text');
      const icon = item.querySelector('.icon-plus') as HTMLElement | null;
      const iconSvg = icon?.querySelector('svg');
      const activeLine = item.querySelector('.active-line') as HTMLElement | null;
      const { foreground, primaryForeground } = theme();

      if (content) {
        if (reducedMotion) {
          // Height snaps; only the opacity tweens.
          content.style.height = "auto";
          animate(content, { opacity: 1 }, { duration: 0.15 });
        } else {
          animate(content, { height: "auto", opacity: 1 } as any, { duration: 0.25, ease: EASE_OUT_EXPO });
        }
      }
      
      // Subtle pop (1.08, not a bounce) gives the state change physicality.
      if (numberBg) {
        if (reducedMotion) {
          animate(numberBg, { backgroundColor: foreground }, { duration: 0.15 });
        } else {
          animate(numberBg, { scale: [1, 1.08, 1], backgroundColor: foreground }, { duration: 0.25, ease: EASE_OUT_EXPO });
        }
      }
      
      if (numberText) animate(numberText, { color: primaryForeground }, { duration: 0.15 });
      
      // Color has no momentum to simulate, so a spring here is an unbounded
      // main-thread rAF for something that should just ease. Matches the
      // 150ms color tweens on numberText/iconSvg either side of it.
      if (titleText) animate(titleText, { color: foreground }, { duration: 0.15, ease: "easeOut" });
      
      if (icon) {
        if (reducedMotion) {
          icon.style.transform = "rotate(45deg)";
        } else {
          animate(icon, { rotate: 45 }, { type: spring, stiffness: 300, damping: 20 });
        }
      }
      if (iconSvg) animate(iconSvg, { color: foreground }, { duration: 0.15 });
      
      if (activeLine) {
        if (reducedMotion) {
          activeLine.style.transform = "scaleX(1)";
        } else {
          animate(activeLine, { scaleX: 1 }, { type: spring, stiffness: 300, damping: 30 });
        }
      }
    }

    function closeItem(item: Element) {
      const content = item.querySelector('.accordion-content') as HTMLElement;
      const numberBg = item.querySelector('.number-bg');
      const numberText = item.querySelector('.number-text');
      const titleText = item.querySelector('.title-text');
      const icon = item.querySelector('.icon-plus') as HTMLElement | null;
      const iconSvg = icon?.querySelector('svg');
      const activeLine = item.querySelector('.active-line') as HTMLElement | null;
      const { mutedForeground, badgeBase } = theme();

      if (content) {
        if (reducedMotion) {
          content.style.height = "0px";
          animate(content, { opacity: 0 }, { duration: 0.15 });
        } else {
          animate(content, { height: 0, opacity: 0 } as any, { duration: 0.2, ease: EASE_OUT_EXPO });
        }
      }
      
      if (numberBg) {
        if (reducedMotion) {
          animate(numberBg, { backgroundColor: badgeBase }, { duration: 0.15 });
        } else {
          animate(numberBg, { scale: 1, backgroundColor: badgeBase }, { type: spring, stiffness: 400, damping: 25 });
        }
      }
      
      if (numberText) animate(numberText, { color: mutedForeground }, { duration: 0.15 });
      
      if (titleText) animate(titleText, { color: mutedForeground }, { duration: 0.15, ease: "easeOut" });
      
      if (icon) {
        if (reducedMotion) {
          icon.style.transform = "rotate(0deg)";
        } else {
          animate(icon, { rotate: 0 }, { type: spring, stiffness: 300, damping: 20 });
        }
      }
      if (iconSvg) animate(iconSvg, { color: mutedForeground }, { duration: 0.15 });
      
      if (activeLine) {
        if (reducedMotion) {
          activeLine.style.transform = "scaleX(0)";
        } else {
          animate(activeLine, { scaleX: 0 }, { type: spring, stiffness: 300, damping: 30 });
        }
      }
    }
  }

  // Initialize
  initFAQ();
  
  // Re-init on View Transitions
  document.addEventListener('astro:after-swap', initFAQ);
</script>
