      !titleLayerBottom ||
      !circleOverlay ||
      !circleExpansion ||
      !track ||
      !node1 ||
      !node2 ||
      !node3 ||
      !node4 ||
      !node5 ||
      !node6 ||
      !node7 ||
      !node8 ||
      !dot1 ||
      !dot2 ||
      !dot3 ||
      !dot4 ||
      !dot5 ||
      !dot6 ||
      !dot7 ||
      !dot8 ||
      !dot9 ||
