            // the JS scroll progress so every track shares one correct clock.
            const scrubWithScroll = (anim: { pause(): void; time: number; duration: number }) => {
              anim.pause();
              cleanupFns.push(
                scroll(
                  (progress: number) => {
                    anim.time = progress * anim.duration;
                  },
                  { target: section, offset: ["start start", "end end"] }
                )
              );
            };
      
            // 5. Line 1 Animation
            // Line-N (dot-N → dot-N+1) completes exactly at connect(N+1);
            // line-1 starts drawing when the intro ends.
            const line1Anim = animate(
              line1,
              {
                opacity: [0, 1, 1, 1],
                pathLength: [0, 0, 1, 1]
              },
              { ease: "linear", times: [0, INTRO_END, connect(2), 1] }
            );
            scrubWithScroll(line1Anim);
      
            // Reusable Node Animation Helper
            // Reveals are scroll-scrubbed pops: each part pops inside one
            // REVEAL_WINDOW-wide window opening exactly at its connect
            // threshold — nothing is visible before the line reaches the dot.
            // Photo leads; date trails +STAGGER_DATE, desc +STAGGER_DESC.
            // Partial scroll maps to partial pops; backward scroll reverses
            // them. Each block's transform-origin points at its dot and is
            // maintained by applyRevealOrigins().
            const REVEAL_TOTAL = 0.61;

            function setupNodeAnimation(nodeNum: number, connectAt: number, contentConnectAt: number = connectAt) {
              const dot = document.getElementById(`dot-${nodeNum}`);
              const photo = document.querySelector(`[data-node${nodeNum}-photo]`);
              const date = document.querySelector(`[data-node${nodeNum}-date]`);
              const desc = document.querySelector(`[data-node${nodeNum}-desc]`);
      
              if (!dot) return;
      
              const setHidden = () => {
                dot.style.opacity = nodeNum === 9 ? "0" : "1";
                dot.style.transform = nodeNum === 9 ? "scale(1)" : "scale(0.6)";
                if (photo instanceof HTMLElement) {
                  photo.style.opacity = "0";
                  photo.style.transform = "scale(0.6)";
                }
                if (date instanceof HTMLElement) {
                  date.style.opacity = "0";
                  date.style.transform = "scale(0.6)";
                }
                if (desc instanceof HTMLElement) {
                  desc.style.opacity = "0";
                  desc.style.transform = "scale(0.6)";
                }
              };
      
              setHidden();

              const parts: Array<{ start: number; anims: Array<{ pause(): void; time: number; duration: number }> }> = [];

              // Normal dots use the existing overshoot. The finale dot arrives
              // at full 20px size, then becomes the seed for the expanding fill.
              parts.push({
                start: connectAt,
                anims: [
                  animate(
                    dot,
                    nodeNum === 9
                      ? { opacity: [0, 1, 1], transform: ["scale(1)", "scale(1)", "scale(1)"] }
                      : { opacity: [1, 1, 1, 1], transform: ["scale(0.6)", "scale(1.35)", "scale(1)", "scale(1)"] },
                    nodeNum === 9
                      ? { duration: REVEAL_TOTAL, ease: "linear", times: [0, 0.2, 1] }
                      : { duration: REVEAL_TOTAL, ease: [EASE_OUT_EXPO, EASE_OUT_EXPO, "linear"], times: [0, 0.492, 0.984, 1] }
                  )
                ]
              });

              // Pop: opacity completes in the first ~40% of the window while
              // the scale overshoots 0.6 → 1.06 and settles back to 1.
              const popAnimate = (el: HTMLElement) =>
                animate(
                  el,
                  {
                    opacity: [0, 1, 1],
                    transform: ["scale(0.6)", "scale(1.06)", "scale(1)"]
                  },
                  { duration: 1, ease: [EASE_OUT_EXPO, EASE_OUT_EXPO], times: [0, 0.4, 1] }
                );

              if (photo instanceof HTMLElement) parts.push({ start: contentConnectAt, anims: [popAnimate(photo)] });
              if (date instanceof HTMLElement) parts.push({ start: contentConnectAt + STAGGER_DATE, anims: [popAnimate(date)] });
              if (desc instanceof HTMLElement) parts.push({ start: contentConnectAt + STAGGER_DESC, anims: [popAnimate(desc)] });

              // Scrub only opacity/scale. Position stays authored on the dot and
              // moves solely with the timeline track—never with a second transform.
              parts.forEach((part) => part.anims.forEach((anim) => anim.pause()));
              cleanupFns.push(
                scroll(
                  (progress: number) => {
                    for (const part of parts) {
                      const local = Math.min(1, Math.max(0, (progress - part.start) / REVEAL_WINDOW));
                      for (const anim of part.anims) anim.time = local * anim.duration;
                    }
                  },
                  { target: section!, offset: ["start start", "end end"] }
                )
              );
            }
      
            // Content stays authored on each dot; node 8 intentionally keeps its side card.
            setupNodeAnimation(2, connect(2));
            setupNodeAnimation(3, connect(3));
            setupNodeAnimation(4, connect(4));
            setupNodeAnimation(5, connect(5));
            setupNodeAnimation(6, connect(6));
            setupNodeAnimation(7, connect(7));
            setupNodeAnimation(8, connect(8), NODE8_CONTENT_AT);

            // Form the final dot while it is still below the viewport. It then enters
            // naturally during the long descent instead of spawning at the landing.
            const finalDotReady = FINALE_CORNER + 0.038;
            const finalDotAnim = animate(
              dot9,
              {
                opacity: [0, 0, 1, 1],
                transform: ["scale(0.9)", "scale(0.9)", "scale(1)", "scale(1)"]
              },
              {
                ease: ["linear", EASE_OUT_EXPO, "linear"],
                times: [0, FINALE_CORNER, finalDotReady, 1]
              }
            );
            cleanupFns.push(scroll(finalDotAnim, { target: section, offset: ["start start", "end end"] }));

      
                        // Line animations (continued): line-N draws from just after node
            // N's pop (connect(N) + 0.025) until its tip meets dot-(N+1)
            // exactly at connect(N+1).
            const lineDraw = (line: SVGPathElement, start: number, end: number) => {
              const anim = animate(
                line,
                { opacity: [0, 0, 1, 1, 1], pathLength: [0, 0, 0, 1, 1] },
                { ease: "linear", times: [0, start, start, end, 1] }
              );
              scrubWithScroll(anim);
            };

            lineDraw(line2, connect(2) + 0.025, connect(3));
            lineDraw(line3, connect(3) + 0.025, connect(4));
            lineDraw(line4, connect(4) + 0.025, connect(5));
            lineDraw(line5, connect(5) + 0.025, connect(6));
            lineDraw(line6, connect(6) + 0.025, connect(7));
            lineDraw(line7, connect(7) + 0.025, connect(8));
      
            // Derive draw fractions from the measured V-H-V path. The tip and
            // camera meet at the halfway point, second turn, and final dot, so the
            // line remains in-frame instead of outrunning the viewport.
            const line8Start = connect(8) + 0.006;
            const finaleMidY = points[7].y + (points[8].y - points[7].y) * FINALE_ELBOW_T;
            const firstLeg = Math.abs(finaleMidY - points[7].y);
            const horizontalLeg = Math.abs(points[8].x - points[7].x);
            const firstTurnFraction = firstLeg / lens[7];
            const halfwayFraction = (firstLeg + horizontalLeg * 0.5) / lens[7];
            const secondTurnFraction = (firstLeg + horizontalLeg) / lens[7];
            const line8Anim = animate(
              line8,
              {
                opacity: [0, 0, 1, 1, 1, 1, 1, 1],
                pathLength: [
                  0,
                  0,
                  0,
                  firstTurnFraction,
                  halfwayFraction,
                  secondTurnFraction,
                  1,
                  1
                ]
              },
              {
                ease: "linear",
                times: [
                  0,
                  connect(8),
                  line8Start,
                  FINALE_TURN,
                  FINALE_MID,
                  FINALE_CORNER,
                  VERT_END,
                  1
                ]
              }
            );
            scrubWithScroll(line8Anim);
      
            // 10. Circle Expansion (End)
            // The grow begins the moment the line completes on the dot, so the
            // connection reads as the trigger. The title stays hidden until the
            // growing circle's edge reaches it — the clip-path sweep itself is
            // the reveal, the inverse of the opening shrink crossing Mula-mula.
            const expansionAnim = animate(
              circleExpansion,
              {
                clipPath: [
                  "circle(0.001px at 50% 50%)",
                  "circle(0.001px at 50% 50%)",
                  "circle(100vmax at 50% 50%)",
                  "circle(100vmax at 50% 50%)"
                ]
              },
              { ease: "linear", times: [0, EXPANSION_START, EXPANSION_END, 1] }
            );
            cleanupFns.push(scroll(expansionAnim, { target: section, offset: ["start start", "end end"] }));
    });
  }

  document.addEventListener("astro:page-load", initTimeline);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTimeline);
  } else {
    initTimeline();
  }
</script>
