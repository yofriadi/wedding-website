        setSmooth(line1, points[0], points[1]),
        setSmooth(line2, points[1], points[2]),
        setSmooth(line3, points[2], points[3]),
        setSmooth(line4, points[3], points[4]),
        setSmooth(line5, points[4], points[5]),
        setSmooth(line6, points[5], points[6]),
        setSmoothIntoNode8(line7, points[6], points[7]),
        setFinale(line8, points[7], points[8])
