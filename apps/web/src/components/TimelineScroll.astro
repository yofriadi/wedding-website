              { ease: "linear", times: [0, INTRO_END, INTRO_END + 0.001, 1] }
            );
            cleanupFns.push(scroll(node1Anim, { target: section, offset: ["start start", "end end"] }));
            cleanupFns.push(
              scroll(
                (progress: number) => {
                  node1.style.visibility = progress >= INTRO_END ? "visible" : "hidden";
                },
                { target: section, offset: ["start start", "end end"] }
