---

<section id="timeline-section" class="timeline-section relative w-full bg-white">
  <div class="timeline-stage sticky top-0 w-full overflow-hidden">
    
    <!-- 1. Bottom Layer: Title (Black text on White bg) -->
    <!-- Visible outside the shrinking circle. Fades out when timeline starts moving. -->
    <div 
      id="title-layer-bottom"
      class="absolute inset-0 z-0 pointer-events-none"
    >
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
        <div class="relative h-4 w-4">
          <div class="absolute bottom-[calc(100%+12px)] left-1/2 -translate-x-1/2 whitespace-nowrap text-center">
            <h2 class="max-w-[18ch] text-center font-serif tracking-wide text-neutral-950 text-4xl md:text-6xl px-6">
              Mula-mula
            </h2>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Track Layer: The scrolling timeline -->
    <!-- z-10: Above bottom title, below top circle overlay -->
    <div
      id="timeline-track"
      class="relative z-10 h-[250vh] w-[1100vw] will-change-transform"
      style="transform: translate(0vw, 0vh); width: 1100vw;"
    >
      <!-- SVG connectors live INSIDE the track -->
      <svg class="absolute inset-0 h-full w-full pointer-events-none" xmlns="http://www.w3.org/2000/svg">
        <path id="line-1" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
        <path id="line-2" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
        <path id="line-3" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
        <path id="line-4" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
        <path id="line-5" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
        <path id="line-6" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
        <path id="line-7" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
        <path id="line-8" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
      </svg>

      <!-- Node 1 (left) -->
      <!-- Adjusted to 50vw/50% to match shrinking circle center -->
      <div
        id="node-1"
        class="timeline-node absolute opacity-0"
        style="left: 50vw; transform: translate(-50%, -50%);"
      >
        <div
          id="dot-1"
          class="relative h-4 w-4 rounded-full bg-neutral-950"
        >
          <div
            id="node-1-label"
            class="absolute bottom-[calc(100%+12px)] left-1/2 -translate-x-1/2 whitespace-nowrap text-center text-neutral-950"
          >
            <h2 class="max-w-[18ch] text-center font-serif tracking-wide text-inherit text-4xl md:text-6xl px-6">Mula-mula</h2>
          </div>
        </div>
      </div>

      <!-- Node 2 (middle) -->
      <div
        id="node-2"
        class="timeline-node absolute"
        style="left: 150vw; transform: translate(-50%, -50%);"
      >
        <div
          id="dot-2"
          class="h-5 w-5 rounded-full bg-neutral-950"
          style="transform: scale(0.6); transform-origin: center;"
        ></div>

        <!-- Date above the node -->
        <div class="absolute left-1/2 -translate-x-1/2 bottom-[calc(100%+16px)] whitespace-nowrap">
          <div data-node2-date style="opacity: 0; transform: translateY(12px) scale(0.98); transform-origin: center;">
            <div class="font-serif text-2xl text-neutral-950">Februari 2025</div>
          </div>
        </div>

        <!-- Photo and Text below the node -->
        <div class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+24px)] flex flex-col items-center">
          <div data-node2-photo style="opacity: 0; transform: translateY(18px);">
            <div class="h-45 w-[320px] md:h-55 md:w-105 overflow-hidden rounded-xl bg-neutral-200 shadow-xl ring-1 ring-black/10">
              <img src="/13.jpg" alt="Februari 2025" class="h-full w-full object-cover" loading="eager" />
            </div>
          </div>

          <div data-node2-desc class="mt-4 w-[320px]" style="opacity: 0; transform: translateY(12px) scale(0.98); transform-origin: center;">
            <p class="text-sm leading-relaxed text-neutral-600 text-pretty">
              Menjadi bulan pertama kami bertemu dan berkenalan. Sebatas teman, dikenalkan oleh Rahadian,
              kakak Aci. Tidak dekat, tidak berlebihan.
            </p>
          </div>
        </div>
      </div>

      <!-- Node 3 (right, end) -->
      <!-- Adjusted left to 275vw to be further from Node 2 and connect at 80% viewport width -->
      <div
        id="node-3"
        class="timeline-node absolute"
        style="left: 275vw; transform: translate(-50%, -50%);"
      >
        <!-- Photo and Date above the node -->
        <div class="absolute left-1/2 -translate-x-1/2 bottom-[calc(100%+24px)] flex flex-col items-center">
          <div data-node3-photo style="opacity: 0; transform: translateY(18px);">
            <div class="h-45 w-[320px] md:h-55 md:w-105 overflow-hidden rounded-xl bg-neutral-200 shadow-xl mb-4 ring-1 ring-black/10">
              <img src="/13.jpg" alt="5 April 2025" class="h-full w-full object-cover" loading="eager" />
            </div>
          </div>
          <div data-node3-date style="opacity: 0; transform: translateY(12px) scale(0.98); transform-origin: center;">
            <div class="whitespace-nowrap font-serif text-2xl text-neutral-950">
              5 April 2025
            </div>
          </div>
        </div>

        <div id="dot-3" class="h-5 w-5 rounded-full bg-neutral-950" style="transform: scale(0.6); transform-origin: center;"></div>

        <!-- Text below the node -->
        <div data-node3-desc class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+24px)] w-[320px]" style="opacity: 0; transform: translateY(12px) scale(0.98); transform-origin: center;">
          <p class="text-sm leading-relaxed text-neutral-600 text-center text-pretty">
            Menjadi bulan pertama kami bertemu dan berkenalan. Sebatas teman, dikenalkan oleh Rahadian, kakak Aci. Tidak dekat, tidak berlebihan.
          </p>
        </div>
      </div>

      <!-- Node 4 -->
      <div
        id="node-4"
        class="timeline-node absolute"
        style="left: 379vw; transform: translate(-50%, -50%);"
      >
        <div id="dot-4" class="h-5 w-5 rounded-full bg-neutral-950" style="transform: scale(0.6); transform-origin: center;"></div>

        <div class="absolute left-1/2 -translate-x-1/2 bottom-[calc(100%+24px)]">
          <div data-node4-photo style="opacity: 0; transform: translateY(18px);">
            <div class="h-45 w-[320px] md:h-55 md:w-105 overflow-hidden rounded-xl bg-neutral-200 shadow-xl ring-1 ring-black/10">
              <img src="/0.jpg" alt="28 Juni 2025" class="h-full w-full object-cover" loading="eager" />
            </div>
          </div>
        </div>

        <div class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+22px)] w-[320px] flex flex-col items-center">
          <div data-node4-date style="opacity: 0; transform: translateY(12px) scale(0.98); transform-origin: center;">
            <div class="font-serif text-2xl text-neutral-950">28 Juni 2025</div>
          </div>
          <div data-node4-desc style="opacity: 0; transform: translateY(12px) scale(0.98); transform-origin: center;">
            <p class="mt-2 text-sm leading-relaxed text-neutral-600 text-center text-pretty">
              Kali pertama kami jalan berdua saja. Aci pikir, perbedaan hobi dan interest akan menjadi hambatan dari merasa nyaman.
              Namun ternyata, candaan dan obrolan mengalir dengan baik. Bahkan diamnya saja menyenangkan.
            </p>
          </div>
        </div>
      </div>

      <!-- Node 5 -->
      <div
        id="node-5"
        class="timeline-node absolute"
        style="left: 488vw; transform: translate(-50%, -50%);"
      >
        <div id="dot-5" class="h-5 w-5 rounded-full bg-neutral-950" style="transform: scale(0.6); transform-origin: center;"></div>

        <div class="absolute left-1/2 -translate-x-1/2 bottom-[calc(100%+24px)]">
          <div data-node5-photo style="opacity: 0; transform: translateY(18px);">
            <div class="h-45 w-[320px] md:h-55 md:w-105 overflow-hidden rounded-xl bg-neutral-200 shadow-xl ring-1 ring-black/10">
              <img src="/0.jpg" alt="26 Oktober 2025" class="h-full w-full object-cover" loading="eager" />
            </div>
          </div>
        </div>

        <div class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+22px)] w-[320px] flex flex-col items-center">
          <div data-node5-date style="opacity: 0; transform: translateY(12px) scale(0.98); transform-origin: center;">
            <div class="font-serif text-2xl text-neutral-950">26 Oktober 2025</div>
          </div>
          <div data-node5-desc style="opacity: 0; transform: translateY(12px) scale(0.98); transform-origin: center;">
            <p class="mt-2 text-sm leading-relaxed text-neutral-600 text-center text-pretty">
              Pertama kali kami saling mengungkapkan rasa ketertarikan. Sepulangnya dari kafe, Adi langsung mengajak Aci bertemu Mama Nur.
              Salah satu bentuk yang menunjukkan keseriusan untuk melanjutkan ke jenjang berikutnya.
            </p>
          </div>
        </div>
      </div>

      <!-- Node 6 -->
      <div
        id="node-6"
        class="timeline-node absolute"
        style="left: 597vw; transform: translate(-50%, -50%);"
      >
        <div id="dot-6" class="h-5 w-5 rounded-full bg-neutral-950" style="transform: scale(0.6); transform-origin: center;"></div>

        <div class="absolute left-1/2 -translate-x-1/2 bottom-[calc(100%+24px)]">
          <div data-node6-photo style="opacity: 0; transform: translateY(18px);">
            <div class="h-45 w-[320px] md:h-55 md:w-105 overflow-hidden rounded-xl bg-neutral-200 shadow-xl ring-1 ring-black/10">
              <img src="/0.jpg" alt="1 November 2025" class="h-full w-full object-cover" loading="eager" />
            </div>
          </div>
        </div>

        <div class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+22px)] w-[320px] text-center">
          <div data-node6-date style="opacity: 0; transform: translateY(12px) scale(0.98); transform-origin: center;">
            <div class="font-serif text-2xl text-neutral-950">1 November 2025</div>
          </div>
          <div data-node6-desc style="opacity: 0; transform: translateY(12px) scale(0.98); transform-origin: center;">
            <p class="mt-2 text-sm leading-relaxed text-neutral-600 text-pretty">
              Foto berdua kami yang pertama. Kami mulai sore di hari hujan itu dengan bercerita. Tentang diri, tentang pertemanan kami,
              tentang kisah yang lalu, dan rencana-rencana masa depan kami.
            </p>
          </div>
        </div>
      </div>

      <!-- Node 7 -->
      <div
        id="node-7"
        class="timeline-node absolute"
        style="left: 706vw; transform: translate(-50%, -50%);"
      >
        <div id="dot-7" class="h-5 w-5 rounded-full bg-neutral-950" style="transform: scale(0.6); transform-origin: center;"></div>

        <div class="absolute left-1/2 -translate-x-1/2 bottom-[calc(100%+24px)]">
          <div data-node7-photo style="opacity: 0; transform: translateY(18px);">
            <div class="h-45 w-[320px] md:h-55 md:w-105 overflow-hidden rounded-xl bg-neutral-200 shadow-xl ring-1 ring-black/10">
              <img src="/0.jpg" alt="29-30 November 2025" class="h-full w-full object-cover" loading="eager" />
            </div>
          </div>
        </div>

        <div class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+22px)] w-[320px] text-center">
          <div data-node7-date style="opacity: 0; transform: translateY(12px) scale(0.98); transform-origin: center;">
            <div class="font-serif text-2xl text-neutral-950">29-30 November 2025</div>
          </div>
          <div data-node7-desc style="opacity: 0; transform: translateY(12px) scale(0.98); transform-origin: center;">
            <p class="mt-2 text-sm leading-relaxed text-neutral-600 text-pretty">
              Aci membawa Adi ke rumah Solo. Mengenalkan kepada orang tua Aci, saudara Aci, keluarga besar. Go public!
              Ditandai dengan unggahan story media sosial. Tanpa penjelasan, cukup foto kami berdua.
            </p>
          </div>
        </div>
      </div>

      <!-- Node 8 -->
      <div
        id="node-8"
        class="timeline-node absolute"
        style="left: 815vw; transform: translate(-50%, -50%);"
      >
        <div class="absolute bottom-[calc(100%+12px)] left-1/2 -translate-x-1/2 whitespace-nowrap text-center">
            <div data-node8-date style="opacity: 0; transform: translateY(12px) scale(0.98); transform-origin: center;">
              <div class="font-serif text-2xl text-neutral-950">11 April 2026</div>
            </div>
        </div>
        <div id="dot-8" class="h-5 w-5 rounded-full bg-neutral-950" style="transform: scale(0.6); transform-origin: center;"></div>
        
        <!-- Photo and Text on the right side of the node -->
        <div class="absolute left-[50vw] -translate-x-1/2 top-4 flex flex-col items-center w-[260px]">
          <div data-node8-photo style="opacity: 0; transform: translateY(18px);">
            <div class="h-45 w-full overflow-hidden rounded-xl bg-neutral-200 shadow-xl mb-4 ring-1 ring-black/10">
              <img src="/0.jpg" alt="Lamaran" class="h-full w-full object-cover" loading="eager" />
            </div>
          </div>
          <div data-node8-desc style="opacity: 0; transform: translateY(12px) scale(0.98); transform-origin: center;">
            <p class="text-sm leading-relaxed text-neutral-600 text-center text-pretty">
              Momentum besar bagi kami sebagai langkah awal dalam menjalin hubungan yang lebih serius. Lamaran.
            </p>
          </div>
        </div>
      </div>

      <!-- Node 9 Anchor (for path calc) -->
      <div
        id="dot-9-anchor"
        class="absolute"
        style="left: 965vw; width: 20px; height: 20px; transform: translate(-50%, -50%); visibility: hidden;"
      ></div>
    </div>

    <!-- 3. Top Layer: Overlay (Black BG + White Title) -->
    <!-- z-30: Topmost. Shrinks via clip-path. Visible inside the circle. -->
    <div
      id="timeline-circle-overlay"
      class="absolute inset-0 z-30 pointer-events-none bg-neutral-950"
      style="clip-path: circle(150% at 50% 50%);"
    >
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
        <div class="relative h-4 w-4">
          <div class="absolute bottom-[calc(100%+12px)] left-1/2 -translate-x-1/2 whitespace-nowrap text-center">
            <h2 class="max-w-[18ch] text-center font-serif tracking-wide text-white text-4xl md:text-6xl px-6">
              Mula-mula
            </h2>
          </div>
        </div>
      </div>
    </div>

    <!-- 4. Expansion Overlay (End) -->
    <!-- z-40: Above everything. Expands from dot-9 to fill screen. -->
    <div
      id="timeline-circle-expansion"
      class="absolute z-40 pointer-events-none"
      style="width: 200vmax; height: 200vmax; left: 50%; transform: translate(-50%, -50%);"
    >
      <div
        id="timeline-circle-expansion-fill"
        class="h-full w-full rounded-full bg-neutral-950"
        style="transform: scale(0.001);"
      ></div>
    </div>

    <!-- 5. Final Node Overlay -->
    <!-- z-50: Above the expansion fill. -->
    <div
      id="node-9"
      class="timeline-node absolute z-50 pointer-events-none"
      style="left: 0; top: 0; width: 100%; height: 100%; transform: translate(0vw, 0vh); will-change-transform;"
    >
      <div style="position: absolute; left: 965vw; transform: translate(-50%, -50%);">
        <div class="absolute left-1/2 -translate-x-1/2 top-[calc(45%)] whitespace-nowrap text-center">
          <div data-node9-date style="opacity: 0; transform: translateY(12px) scale(0.98); transform-origin: center;">
            <div class="font-serif text-2xl md:text-3xl text-white">10 October 2026</div>
            <div class="font-serif text-2xl md:text-3xl text-white">Menikah</div>
          </div>
        </div>
        <div id="dot-9" class="h-5 w-5 rounded-full bg-neutral-950" style="transform: scale(0.6); transform-origin: center;"></div>
      </div>
    </div>

  </div>
</section>

<style>
  /* Scroll runway: vh fallback, svh so mobile browser chrome cannot shift the scrub. */
  .timeline-section {
    height: 1200vh;
    height: 1200svh;
  }

  /* Stage: vh fallback, svh so mobile browser chrome cannot clip the pinned stage. */
  .timeline-stage {
    height: 100vh;
    height: 100svh;
  }

  /* Node vertical positions, keyed by id so each can carry its vh -> svh fallback pair. */
  #node-1 { top: 50vh; top: 50svh; }
  #node-2 { top: 30vh; top: 30svh; }
  #node-3 { top: 70vh; top: 70svh; }
  #node-4 { top: 45vh; top: 45svh; }
  #node-5 { top: 65vh; top: 65svh; }
  #node-6 { top: 35vh; top: 35svh; }
  #node-7 { top: 55vh; top: 55svh; }
  #node-8 { top: 25vh; top: 25svh; }
  #dot-9-anchor { top: 133vh; top: 133svh; }
  #node-9 > div { top: 133vh; top: 133svh; }
  #timeline-circle-expansion { top: 50vh; top: 50svh; }

  /* Reduced motion: readable vertical story instead of the pinned scrub sequence. */
  @media (prefers-reduced-motion: reduce) {
    .timeline-section {
      height: auto !important;
    }
    .timeline-stage {
      position: relative !important;
      height: auto !important;
      overflow: visible !important;
    }
    #title-layer-bottom,
    #timeline-track > svg,
    #timeline-circle-overlay,
    #timeline-circle-expansion {
      display: none !important;
    }
    #timeline-track {
      width: auto !important;
      height: auto !important;
      position: static !important;
      transform: none !important;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4rem;
      padding: 4rem 1.5rem;
    }
    .timeline-node {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      transform: none !important;
      opacity: 1 !important;
      width: 100%;
      max-width: 26rem;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    /* Per-node content blocks were art-directed as absolutes; reflow them as flow items. */
    .timeline-node > div {
      position: static !important;
      left: auto !important;
      top: auto !important;
      right: auto !important;
      bottom: auto !important;
      transform: none !important;
      margin: 0 !important;
    }
    /* Dots keep their Tailwind size (dot-9 lacks the scoping attr, so the */
    /* #id rule below would otherwise win the width cascade with width: auto). */
    .timeline-node div[id^="dot-"] {
      width: 1.25rem !important;
      height: 1.25rem !important;
    }
    #node-9 > div > div[id^="dot-"] {
      width: 1.25rem !important;
      height: 1.25rem !important;
    }
    /* Node 1 / node 9 wrap their dot in an extra positioning div; neutralize the */
    /* remaining absolutely-positioned label wrappers inside them. */
    #node-1 > div > div,
    #node-9 > div > div {
      position: static !important;
      transform: none !important;
      width: auto !important;
      margin: 0 0 1rem !important;
      text-align: center;
    }
    /* Dot date/photo/desc stacks keep their column flow and spacing. */
    .timeline-node > div {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    /* Force every hidden-by-attribute piece of content visible. */
    [data-node2-photo], [data-node2-date], [data-node2-desc],
    [data-node3-photo], [data-node3-date], [data-node3-desc],
    [data-node4-photo], [data-node4-date], [data-node4-desc],
    [data-node5-photo], [data-node5-date], [data-node5-desc],
    [data-node6-photo], [data-node6-date], [data-node6-desc],
    [data-node7-photo], [data-node7-date], [data-node7-desc],
    [data-node8-photo], [data-node8-date], [data-node8-desc],
    [data-node9-date] {
      opacity: 1 !important;
      transform: none !important;
    }
    #node-1 {
      opacity: 1 !important;
    }
  }
</style>

<script>
  import { animate, scroll } from "motion";

  // JS twin of the CSS --ease-out-expo token; keep in sync.
  const EASE_OUT_EXPO = [0.16, 1, 0.3, 1] as const;

  let cleanupFns: Array<() => void> = [];
  let resizeTimeout: ReturnType<typeof setTimeout> | undefined;
  let initRaf: number | undefined;
  let settleTimeout: ReturnType<typeof setTimeout> | undefined;

  function initTimeline() {
    // Reduced motion: the CSS media query reflows the timeline into a readable
    // vertical story; no animate()/scroll() scrub bindings are created at all.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }

    if (initRaf) cancelAnimationFrame(initRaf);
    cleanupFns.forEach((fn) => fn());
    cleanupFns = [];
    clearTimeout(resizeTimeout);
    clearTimeout(settleTimeout);

    const section = document.getElementById("timeline-section");
    const titleLayerBottom = document.getElementById("title-layer-bottom");
    const circleOverlay = document.getElementById("timeline-circle-overlay");
    const circleExpansionFill = document.getElementById("timeline-circle-expansion-fill");
    const track = document.getElementById("timeline-track");

    const node1 = document.getElementById("node-1");
    const node2 = document.getElementById("node-2");
    const node3 = document.getElementById("node-3");
    const node4 = document.getElementById("node-4");
    const node5 = document.getElementById("node-5");
    const node6 = document.getElementById("node-6");
    const node7 = document.getElementById("node-7");
    const node8 = document.getElementById("node-8");
    const node9 = document.getElementById("node-9");

    const dot1 = document.getElementById("dot-1");
    const dot2 = document.getElementById("dot-2");
    const dot3 = document.getElementById("dot-3");
    const dot4 = document.getElementById("dot-4");
    const dot5 = document.getElementById("dot-5");
    const dot6 = document.getElementById("dot-6");
    const dot7 = document.getElementById("dot-7");
    const dot8 = document.getElementById("dot-8");
    const dot9 = document.getElementById("dot-9");
    const dot9Anchor = document.getElementById("dot-9-anchor");


    const line1 = document.getElementById("line-1");
    const line2 = document.getElementById("line-2");
    const line3 = document.getElementById("line-3");
    const line4 = document.getElementById("line-4");
    const line5 = document.getElementById("line-5");
    const line6 = document.getElementById("line-6");
    const line7 = document.getElementById("line-7");
    const line8 = document.getElementById("line-8");

    if (
      !section ||
      !titleLayerBottom ||
      !circleOverlay ||
      !circleExpansionFill ||
      !track ||
      !node1 ||
      !node2 ||
      !node3 ||
      !node4 ||
      !node5 ||
      !node6 ||
      !node7 ||
      !node8 ||
      !node9 ||
      !dot1 ||
      !dot2 ||
      !dot3 ||
      !dot4 ||
      !dot5 ||
      !dot6 ||
      !dot7 ||
      !dot8 ||
      !dot9 ||
      !(line1 instanceof SVGPathElement) ||
      !(line2 instanceof SVGPathElement) ||
      !(line3 instanceof SVGPathElement) ||
      !(line4 instanceof SVGPathElement) ||
      !(line5 instanceof SVGPathElement) ||
      !(line6 instanceof SVGPathElement) ||
      !(line7 instanceof SVGPathElement) ||
      !(line8 instanceof SVGPathElement)
    ) {
      return;
    }

    // Accurate path calculation using getBoundingClientRect to handle all transforms/nesting
    const updatePaths = () => {
      const trackRect = track.getBoundingClientRect();

      const getCenter = (el: HTMLElement) => {
        const r = el.getBoundingClientRect();
        return {
          x: (r.left - trackRect.left) + r.width / 2,
          y: (r.top - trackRect.top) + r.height / 2
        };
      };

      const points = [
        getCenter(dot1),
        getCenter(dot2),
        getCenter(dot3),
        getCenter(dot4),
        getCenter(dot5),
        getCenter(dot6),
        getCenter(dot7),
        getCenter(dot8),
        getCenter(dot9Anchor!)
      ];

      const setElbow = (line: SVGPathElement, a: { x: number; y: number }, b: { x: number; y: number }, t: number) => {
        const midX = a.x + (b.x - a.x) * t;
        const d = `M ${a.x} ${a.y} H ${midX} V ${b.y} H ${b.x}`;
        line.setAttribute("d", d);
        line.setAttribute("pathLength", "1");
        return line.getTotalLength();
      };


      const setVHV = (line: SVGPathElement, a: { x: number; y: number }, b: { x: number; y: number }, t: number) => {
        const midY = a.y + (b.y - a.y) * t;
        const d = `M ${a.x} ${a.y} V ${midY} H ${b.x} V ${b.y}`;
        line.setAttribute("d", d);
        line.setAttribute("pathLength", "1");
        return line.getTotalLength();
      };

      // Bend point varies per segment so the elbows don't all turn at the
      // midpoint — the line gets a looser, less mechanical rhythm.
      const tA = 0.42;
      
      const lens = [
        setElbow(line1, points[0], points[1], tA),
        setElbow(line2, points[1], points[2], 0.6),
        setElbow(line3, points[2], points[3], 0.5), // bend right of node 3's photo (photo edge ≈ 0.42 of the gap)
        setElbow(line4, points[3], points[4], 0.55),
        setElbow(line5, points[4], points[5], 0.42),
        setElbow(line6, points[5], points[6], 0.58),
        setElbow(line7, points[6], points[7], 0.45),
        setVHV(line8, points[7], points[8], 0.4)
      ];

      return lens;
    };

    initRaf = requestAnimationFrame(() => {
      let lens = updatePaths();
      if (lens.some((l) => l === 0)) {
        lens = updatePaths();
      }

      const onResize = () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
          updatePaths();
        }, 120);
      };
      window.addEventListener("resize", onResize);
      cleanupFns.push(() => window.removeEventListener("resize", onResize));


      settleTimeout = setTimeout(() => {
        updatePaths();
      }, 220);

      // ANIMATIONS

      // 1. Circle Shrink (Top Layer)
      // Shrinks from full screen to a small dot (12px radius)
      // 1a. Circle Shrink (Clip Path)
      const bgClipAnim = animate(
        circleOverlay,
        // Short hold at full circle so tiny scroll jitter at the boundary
        // (e.g. mobile URL-bar resizes) cannot pulse the shrinking edge.
        { clipPath: ["circle(150% at 50% 50%)", "circle(150% at 50% 50%)", "circle(100px at 50% 50%)", "circle(8px at 50% 50%)", "circle(8px at 50% 50%)"] },
        { ease: "linear", times: [0, 0.003, 0.042, 0.06, 1] }
      );
      cleanupFns.push(scroll(bgClipAnim, { target: section, offset: ["start start", "end end"] }));

      // 1b. Circle Opacity (Hold then Cut)
      // Stays fully opaque until 0.06 (when track appears), then vanishes instantly.
      const bgOpacityAnim = animate(
        circleOverlay,
        { opacity: [1, 1, 0, 0] },
        { ease: "linear", times: [0, 0.06, 0.061, 1] }
      );
      cleanupFns.push(scroll(bgOpacityAnim, { target: section, offset: ["start start", "end end"] }));

      // 2. Fade out title layers AFTER the circle has shrunk
      // Only fade the bottom layer (black text on white) - the overlay already shrinks via clip-path
      const titleBottomFadeAnim = animate(
        titleLayerBottom,
        { opacity: [1, 1, 0, 0] },
        { ease: "linear", times: [0, 0.06, 0.061, 1] }
      );
      cleanupFns.push(scroll(titleBottomFadeAnim, { target: section, offset: ["start start", "end end"] }));

      // 3. Horizontal Pan + Vertical Scroll at end
      // Keep still until 15%, then translate left.
      // At the end, translate up to reveal more vertical line.
            // Mobile browser chrome makes svh < vh. Node tops are svh (with vh
            // fallback), so the final vertical pan must use the same unit or
            // dot-9 misses the expansion-circle center on phones.
            const vUnit = CSS.supports("height", "1svh") ? "svh" : "vh";
            const trackTransformValues = [
                  `translate(0vw, 0${vUnit})`,
                  `translate(0vw, 0${vUnit})`,
                  `translate(-765vw, 0${vUnit})`,
                  `translate(-815vw, 0${vUnit})`,
                  `translate(-915vw, 0${vUnit})`,
                  `translate(-915vw, -83${vUnit})`,
                  `translate(-915vw, -83${vUnit})`
                ];
            const trackTimes = [0, 0.06, 0.62, 0.66, 0.72, 0.94, 1];
      
            const trackAnim = animate(
              track,
              { transform: trackTransformValues },
              { ease: "linear", times: trackTimes }
            );
            cleanupFns.push(scroll(trackAnim, { target: section, offset: ["start start", "end end"] }));
      
            const node9TransformAnim = animate(
              node9,
              { transform: trackTransformValues },
              { ease: "linear", times: trackTimes }
            );
            cleanupFns.push(scroll(node9TransformAnim, { target: section, offset: ["start start", "end end"] }));
      
            // 4. Node 1 Reveal
            // Appears as the circle finishes shrinking
            const node1Anim = animate(
              node1,
              {
                opacity: [0, 0, 1, 1],
                transform: ["translate(-50%, -50%)", "translate(-50%, -50%)", "translate(-50%, -50%)", "translate(-50%, -50%)"]
              },
              { ease: "linear", times: [0, 0.05, 0.06, 1] }
            );
            cleanupFns.push(scroll(node1Anim, { target: section, offset: ["start start", "end end"] }));
      
            // motion v13 attaches WAAPI tracks (opacity/transform) to the native
            // ViewTimeline using the requested offset, but drives JS-only tracks
            // (pathLength -> stroke-dasharray) with the timeline's full cover-range
            // progress. That desyncs the line draw from the pan. Scrub manually from
            // the JS scroll progress so every track shares one correct clock.
            const scrubWithScroll = (anim: { pause(): void; time: number; duration: number }) => {
              anim.pause();
              cleanupFns.push(
                scroll(
                  (progress: number) => {
                    anim.time = progress * anim.duration;
                  },
                  { target: section, offset: ["start start", "end end"] }
                )
              );
            };
      
            // 5. Line 1 Animation
            const line1Anim = animate(
              line1,
              {
                opacity: [0, 1, 1, 1],
                pathLength: [0, 0, 1, 1]
              },
              { ease: "linear", times: [0, 0.06, 0.12, 1] }
            );
            scrubWithScroll(line1Anim);
      
            // Reusable Node Animation Helper
            // Reveals are scroll-scrubbed, not threshold-triggered bursts: each
            // part is a paused animate() whose time is driven by scroll progress
            // in a small window around the node's connect threshold, so partial
            // scroll positions map to partial reveals and scrolling backward
            // plays the reveal in reverse.
            // The original time-based timings (dot 0.6s; photo 0.45s; date +80ms;
            // desc +160ms) are expressed as keyframe times within one shared
            // 0.61s timeline.
            const REVEAL_TOTAL = 0.61;

            function setupNodeAnimation(nodeNum: number, connectAt: number) {
              const dot = document.getElementById(`dot-${nodeNum}`);
              const photo = document.querySelector(`[data-node${nodeNum}-photo]`);
              const date = document.querySelector(`[data-node${nodeNum}-date]`);
              const desc = document.querySelector(`[data-node${nodeNum}-desc]`);
      
              if (!dot) return;
      
              const setHidden = () => {
                dot.style.transform = "scale(0.6)";
                if (photo instanceof HTMLElement) {
                  photo.style.opacity = "0";
                  photo.style.transform = "translateY(18px)";
                }
                if (date instanceof HTMLElement) {
                  date.style.opacity = "0";
                  date.style.transform = "translateY(12px) scale(0.98)";
                }
                if (desc instanceof HTMLElement) {
                  desc.style.opacity = "0";
                  desc.style.transform = "translateY(12px) scale(0.98)";
                }
              };
      
              setHidden();

              const revealAnims: Array<{ pause(): void; time: number; duration: number }> = [];

              // Dot overshoot: scale 0.6 -> 1.35 -> 1.
              revealAnims.push(
                animate(
                  dot,
                  { transform: ["scale(0.6)", "scale(1.35)", "scale(1)", "scale(1)"] },
                  { duration: REVEAL_TOTAL, ease: [EASE_OUT_EXPO, EASE_OUT_EXPO, "linear"], times: [0, 0.492, 0.984, 1] }
                )
              );

              if (photo instanceof HTMLElement) {
                revealAnims.push(
                  animate(
                    photo,
                    {
                      opacity: [0, 1, 1],
                      transform: ["translateY(18px)", "translateY(0px)", "translateY(0px)"]
                    },
                    { duration: REVEAL_TOTAL, ease: [EASE_OUT_EXPO, "linear"], times: [0, 0.738, 1] }
                  )
                );
              }

              if (date instanceof HTMLElement) {
                revealAnims.push(
                  animate(
                    date,
                    {
                      opacity: [0, 0, 1, 1, 1],
                      transform: [
                        "translateY(12px) scale(0.98)",
                        "translateY(12px) scale(0.98)",
                        "translateY(0px) scale(1.04)",
                        "translateY(0px) scale(1)",
                        "translateY(0px) scale(1)"
                      ]
                    },
                    { duration: REVEAL_TOTAL, ease: ["linear", EASE_OUT_EXPO, EASE_OUT_EXPO, "linear"], times: [0, 0.131, 0.5, 0.869, 1] }
                  )
                );
              }

              if (desc instanceof HTMLElement) {
                revealAnims.push(
                  animate(
                    desc,
                    {
                      opacity: [0, 0, 1, 1],
                      transform: [
                        "translateY(12px) scale(0.98)",
                        "translateY(12px) scale(0.98)",
                        "translateY(0px) scale(1.03)",
                        "translateY(0px) scale(1)"
                      ]
                    },
                    { duration: REVEAL_TOTAL, ease: ["linear", EASE_OUT_EXPO, EASE_OUT_EXPO], times: [0, 0.262, 0.631, 1] }
                  )
                );
              }

              // Scrub the reveal around the connect threshold.
              const windowStart = connectAt - 0.01;
              const windowEnd = connectAt + 0.02;
              revealAnims.forEach((anim) => anim.pause());
              cleanupFns.push(
                scroll(
                  (progress: number) => {
                    const local = Math.min(1, Math.max(0, (progress - windowStart) / (windowEnd - windowStart)));
                    revealAnims.forEach((anim) => {
                      anim.time = local * anim.duration;
                    });
                  },
                  { target: section!, offset: ["start start", "end end"] }
                )
              );
            }
      
            // Initialize animations for Nodes 2-9
            setupNodeAnimation(2, 0.12);
            setupNodeAnimation(3, 0.20);
            setupNodeAnimation(4, 0.28);
            setupNodeAnimation(5, 0.36);
            setupNodeAnimation(6, 0.44);
            setupNodeAnimation(7, 0.53);
            setupNodeAnimation(8, 0.62);
            setupNodeAnimation(9, 0.94);
      
            // Line animations (continued)
            const line2Anim = animate(
              line2,
              { opacity: [0, 0, 1, 1, 1], pathLength: [0, 0, 0, 1, 1] },
              { ease: "linear", times: [0, 0.14, 0.15, 0.20, 1] }
            );
            scrubWithScroll(line2Anim);
      
            const line3Anim = animate(
              line3,
              { opacity: [0, 0, 1, 1, 1], pathLength: [0, 0, 0, 1, 1] },
              { ease: "linear", times: [0, 0.22, 0.23, 0.28, 1] }
            );
            scrubWithScroll(line3Anim);
      
            const line4Anim = animate(
              line4,
              { opacity: [0, 0, 1, 1, 1], pathLength: [0, 0, 0, 1, 1] },
              { ease: "linear", times: [0, 0.30, 0.31, 0.36, 1] }
            );
            scrubWithScroll(line4Anim);
      
            const line5Anim = animate(
              line5,
              { opacity: [0, 0, 1, 1, 1], pathLength: [0, 0, 0, 1, 1] },
              { ease: "linear", times: [0, 0.38, 0.39, 0.44, 1] }
            );
            scrubWithScroll(line5Anim);
      
            const line6Anim = animate(
              line6,
              { opacity: [0, 0, 1, 1, 1], pathLength: [0, 0, 0, 1, 1] },
              { ease: "linear", times: [0, 0.46, 0.47, 0.53, 1] }
            );
            scrubWithScroll(line6Anim);
      
            const line7Anim = animate(
              line7,
              { opacity: [0, 0, 1, 1, 1], pathLength: [0, 0, 0, 1, 1] },
              { ease: "linear", times: [0, 0.55, 0.56, 0.62, 1] }
            );
            scrubWithScroll(line7Anim);
      
            const line8Anim = animate(
              line8,
              { 
                opacity: [0, 0, 1, 1, 1, 1, 1], 
                pathLength: [0, 0, 0, 0.22, 0.54, 1, 1] 
              },
              { 
                ease: "linear", 
                times: [0, 0.62, 0.625, 0.64, 0.72, 0.94, 1] 
              }
            );
            scrubWithScroll(line8Anim);
      
            // 10. Circle Expansion (End)
            // Expands from 0% (at dot 3 position) to full screen
            const expansionAnim = animate(
              circleExpansionFill,
              {
                transform: ["scale(0.001)", "scale(0.001)", "scale(1)"]
              },
              { ease: "linear", times: [0, 0.94, 1] }
            );            cleanupFns.push(scroll(expansionAnim, { target: section, offset: ["start start", "end end"] }));    });
  }

  document.addEventListener("astro:page-load", initTimeline);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTimeline);
  } else {
    initTimeline();
  }
</script>
