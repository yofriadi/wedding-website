    // transforms animate; no node or wrapper follows/counters the viewport.
    const ORIGIN_Y: Record<number, Record<string, "top" | "bottom">> = {
      2: { date: "bottom", photo: "top", desc: "top" },
      3: { photo: "bottom", date: "bottom", desc: "top" },
      4: { photo: "bottom", date: "top", desc: "top" },
      5: { photo: "bottom", date: "top", desc: "top" },
      6: { photo: "bottom", date: "top", desc: "top" },
