        getCenter(dot1),
        getCenter(dot2),
        getCenter(dot3),
        getCenter(dot4),
        getCenter(dot5),
        getCenter(dot6),
        getCenter(dot7),
        getCenter(dot8),
        getCenter(dot9Anchor!)
