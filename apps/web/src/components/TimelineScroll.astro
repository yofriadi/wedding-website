<script>
  import { animate, scroll } from "motion";

  // JS twin of the CSS --ease-out-expo token; keep in sync.
  const EASE_OUT_EXPO = [0.16, 1, 0.3, 1] as const;

  // 210vw story gaps (the 280vw original at 3/4, verticals compressed to match)
  // drive the horizontal cruise; the finale keeps the compact 150vw jog before its
  // extended descent. Progress fractions are the phase scroll lengths (see the CSS
  // runway comment) over the 1713vh scrollable distance.
  const INTRO_END = 0.0386;
  // Finale camera route: stop the diagonal halfway across the short 150vw jog,
  // finish the jog horizontally, then spend the longest phase moving straight
  // down. This mirrors line 8's V-H-V turns instead of cutting diagonally to dot 9.
  const FINALE_TURN = 0.8074;  // first turn, directly below dot 8
  const FINALE_MID = 0.8392;   // halfway between the two turns
  const FINALE_CORNER = 0.8681; // second turn, directly above dot 9
  const VERT_END = 0.956;      // long final descent complete
  // Grow the instant the line lands on dot 9 — a real hold here read as a dead
  // scroll gap between the connection and the outward burst. 0.004 (~7vh) is a
  // sub-tick beat so a slow scroll still shows one completed-connection frame.
  const EXPANSION_START = VERT_END + 0.004;
  const EXPANSION_END = 0.994;

  const CONNECT_X = 80;
  const FINALE_ELBOW_T = 0.25;
  const FINALE_NODE_Y = window.matchMedia("(min-width: 768px)").matches ? 188 : 180;
  const FINALE_TURN_Y = 25 + (FINALE_NODE_Y - 25) * FINALE_ELBOW_T;
  const PAN_END_X = -1620;                  // 1670vw dot centered at 50vw
  const PAN_TURN_Y = 50 - FINALE_TURN_Y;    // first/second turn centered vertically
  const PAN_END_Y = 50 - FINALE_NODE_Y;     // final dot centered vertically

  const PAN_KEYFRAMES: Array<{ t: number; x: number; y: number }> = [
    { t: 0, x: 0, y: 0 },
    { t: INTRO_END, x: 0, y: 0 },
    { t: FINALE_TURN, x: -1470, y: 0 },
    { t: FINALE_MID, x: -1545, y: PAN_TURN_Y },
    { t: FINALE_CORNER, x: PAN_END_X, y: PAN_TURN_Y },
    { t: VERT_END, x: PAN_END_X, y: PAN_END_Y },
    { t: 1, x: PAN_END_X, y: PAN_END_Y }
  ];

  // Inverse of panVw over the horizontal ramp: progress at which the track
  // has panned to targetX (vw).
  function progressAtPanX(targetX: number): number {
    for (let i = 1; i < PAN_KEYFRAMES.length; i++) {
      const a = PAN_KEYFRAMES[i - 1];
      const b = PAN_KEYFRAMES[i];
      const lo = Math.min(a.x, b.x);
      const hi = Math.max(a.x, b.x);
      if (targetX >= lo && targetX <= hi && b.x !== a.x) {
        return a.t + ((targetX - a.x) / (b.x - a.x)) * (b.t - a.t);
      }
    }
    return targetX <= PAN_KEYFRAMES[PAN_KEYFRAMES.length - 1].x ? 1 : 0;
  }

