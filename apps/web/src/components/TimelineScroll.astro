    const titleLayerBottom = document.getElementById("title-layer-bottom");
    const circleOverlay = document.getElementById("timeline-circle-overlay");
    const circleExpansion = document.getElementById("timeline-circle-expansion");
    const track = document.getElementById("timeline-track");

    const node1 = document.getElementById("node-1");
    const node2 = document.getElementById("node-2");
    const node3 = document.getElementById("node-3");
    const node4 = document.getElementById("node-4");
    const node5 = document.getElementById("node-5");
    const node6 = document.getElementById("node-6");
    const node7 = document.getElementById("node-7");
    const node8 = document.getElementById("node-8");

    const dot1 = document.getElementById("dot-1");
    const dot2 = document.getElementById("dot-2");
    const dot3 = document.getElementById("dot-3");
    const dot4 = document.getElementById("dot-4");
    const dot5 = document.getElementById("dot-5");
    const dot6 = document.getElementById("dot-6");
    const dot7 = document.getElementById("dot-7");
    const dot8 = document.getElementById("dot-8");
    const dot9 = document.getElementById("dot-9");
    const dot9Anchor = document.getElementById("dot-9-anchor");


    const line1 = document.getElementById("line-1");
    const line2 = document.getElementById("line-2");
    const line3 = document.getElementById("line-3");
    const line4 = document.getElementById("line-4");
    const line5 = document.getElementById("line-5");
    const line6 = document.getElementById("line-6");
    const line7 = document.getElementById("line-7");
    const line8 = document.getElementById("line-8");

