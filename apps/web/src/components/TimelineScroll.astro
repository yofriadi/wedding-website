---
import { variantSrcset } from "../lib/media-candidates";

// `sizes` for the two photo shapes. Derived from the layout boxes rather than
// from a transform: unlike the collage, these photos come to rest at scale(1),
// so the layout box IS the presentation box.
//
// The portrait is height-driven — `h-[360px] sm:h-[400px] md:h-[480px] w-auto
// aspect-[591/1280]` — so its rendered width is that height times 591/1280:
// 166 / 185 / 222 px. The `max-w-[calc(100vw-32px)]` clamp never bites at those
// numbers on any viewport this site supports.
const SIZES_PORTRAIT = "(min-width: 768px) 222px, (min-width: 640px) 185px, 166px";

// The two landscape cards are width-driven — `w-[340px] sm:w-[400px] md:w-[560px]
// max-w-[calc(100vw-32px)]` — and here the clamp does bite on a narrow phone,
// so it stays in the expression.
const SIZES_CARD =
  "(min-width: 768px) min(calc(100vw - 32px), 560px), (min-width: 640px) min(calc(100vw - 32px), 400px), min(calc(100vw - 32px), 340px)";
---

<section id="timeline-section" class="timeline-section relative w-full bg-[color:var(--timeline-bg)]">
  <!-- Ships real src/srcset, with no tier deferral: the timeline story is
       content rather than decoration, and its scrub binding is in the bundle
       regardless — so lite keeps the whole narrative (media-tiering design:
       flattening this story is a non-goal). The loading screen no longer waits
       on them; it gates on the hero alone.

       The photos DO carry device-matched candidate sets now (responsive-media):
       `keluarga-acik` is a 2048px, 463 KB master in a card capped at
       `md:w-[560px]`, and a 390px phone used to download all of it. They are
       also `loading="lazy"` — this track sits far below the fold and is
       scrolled horizontally, so the browser, not a tier observer, should decide
       when to spend the connection. Neither is tier deferral: the real `src`
       ships and the box is reserved by intrinsic dimensions, so no state of
       this component is an empty frame.

       The video below is the one tier-gated element in this component. -->
  <div class="timeline-stage sticky top-0 w-full overflow-hidden">
    
    <!-- 1. Bottom Layer: Title (Black text on White bg) -->
    <!-- Visible outside the shrinking circle. Fades out when timeline starts moving. -->
    <div 
      id="title-layer-bottom"
      class="absolute inset-0 z-0 pointer-events-none"
    >
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
        <div class="relative h-4 w-4">
          <div class="absolute bottom-[calc(100%+12px)] left-1/2 -translate-x-1/2 whitespace-nowrap text-center">
            <h2 class="max-w-[18ch] text-center font-serif tracking-wide text-[color:var(--timeline-ink)] text-4xl md:text-6xl px-6">
              Awal mula
            </h2>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Track Layer: The scrolling timeline -->
    <!-- z-10: Above bottom title, below top circle overlay -->
    <div
      id="timeline-track"
      class="relative z-10 h-[250lvh] w-[1090vw] will-change-transform"
      style="transform: translate(0vw, 0lvh); width: 1090vw;"
    >
      <!-- SVG connectors live INSIDE the track -->
      <svg class="absolute inset-0 z-40 h-full w-full pointer-events-none" xmlns="http://www.w3.org/2000/svg">
        <path id="line-1" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
        <path id="line-2" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
        <path id="line-3" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
        <path id="line-4" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
        <path id="line-5" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
      </svg>

      <!-- Node 1 (left) -->
      <!-- Adjusted to 50vw/50% to match shrinking circle center -->
      <div
        id="node-1"
        class="timeline-node absolute z-30 opacity-0"
        style="left: 50vw; visibility: hidden; transform: translate(-50%, -50%);"
      >
        <div
          id="dot-1"
          class="relative h-4 w-4 rounded-full bg-[color:var(--timeline-dot)]"
        >
          <div
            id="node-1-label"
            class="absolute bottom-[calc(100%+12px)] left-1/2 -translate-x-1/2 whitespace-nowrap text-center text-[color:var(--timeline-ink)]"
          >
            <h2 class="max-w-[18ch] text-center font-serif tracking-wide text-inherit text-4xl md:text-6xl px-6">Awal mula</h2>
          </div>
        </div>
      </div>

      <!-- Node 2 (middle) -->
      <div
        id="node-2"
        class="timeline-node absolute z-30"
        style="left: 260vw; transform: translate(-50%, -50%);"
      >
        <div
          id="dot-2"
          class="h-5 w-5 rounded-full bg-[color:var(--timeline-dot)]"
          style="transform: scale(0.6); transform-origin: center;"
        ></div>

        <!-- Date above the node -->
        <div data-node2-pin class="absolute inset-0">
          <div class="absolute left-1/2 -translate-x-1/2 bottom-[calc(100%+16px)] whitespace-nowrap text-center">
            <div data-node2-date style="opacity: 0; transform: scale(0.6); transform-origin: 100% 100%;">
              <div class="font-serif text-2xl text-[color:var(--timeline-ink)] text-center">Februari 2025</div>
            </div>
          </div>

          <!-- Photo and Text below the node -->
          <div class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+24px)] flex flex-col items-center">
            <div data-node2-photo style="opacity: 0; transform: scale(0.6); transform-origin: 100% 0%;">
              <div class="h-[360px] sm:h-[400px] md:h-[480px] w-auto max-w-[calc(100vw-32px)] aspect-[591/1280] overflow-hidden rounded-xl bg-[color:var(--timeline-photo-frame)] shadow-xl ring-1 ring-[color:var(--timeline-photo-ring)]">
                <picture>
                  <source
                    srcset={variantSrcset("awal-perkenalan", "avif", 591)}
                    sizes={SIZES_PORTRAIT}
                    type="image/avif"
                  />
                  <img
                    src="/awal-perkenalan.webp"
                    srcset={variantSrcset("awal-perkenalan", "webp", 591)}
                    sizes={SIZES_PORTRAIT}
                    alt="Awal perkenalan"
                    width="591"
                    height="1280"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                </picture>
              </div>
            </div>

            <div data-node2-desc class="mt-4 w-[320px] text-center" style="opacity: 0; transform: scale(0.6); transform-origin: 100% 0%;">
              <p class="text-sm leading-relaxed text-[color:var(--timeline-muted)] text-center text-pretty">
                Awal perkenalan
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Node 3 (right, end) -->
      <!-- Uniform 210vw gaps: the 280vw original scaled to 3/4, with the node
           verticals compressed to match, so every connector keeps the same broad
           S-curve and slope. -->
      <div
        id="node-3"
        class="timeline-node absolute z-30"
        style="left: 470vw; transform: translate(-50%, -50%);"
      >
        <div data-node3-pin class="absolute inset-0">
          <!-- Photo and Date above the node -->
          <div class="absolute left-1/2 -translate-x-1/2 bottom-[calc(100%+24px)] flex flex-col items-center">
            <div data-node3-photo style="opacity: 0; transform: scale(0.6); transform-origin: 100% 100%;">
              <div class="w-[340px] sm:w-[400px] md:w-[560px] max-w-[calc(100vw-32px)] h-auto aspect-[1280/591] overflow-hidden rounded-xl bg-[color:var(--timeline-photo-frame)] shadow-xl mb-4 ring-1 ring-[color:var(--timeline-photo-ring)]">
                <picture>
                  <source
                    srcset={variantSrcset("keluarga-yofri", "avif", 1280)}
                    sizes={SIZES_CARD}
                    type="image/avif"
                  />
                  <img
                    src="/keluarga-yofri.webp"
                    srcset={variantSrcset("keluarga-yofri", "webp", 1280)}
                    sizes={SIZES_CARD}
                    alt="Aisha diperkenalkan ke keluarga Yofri"
                    width="1280"
                    height="591"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                </picture>
              </div>
            </div>
            <div data-node3-date style="opacity: 0; transform: scale(0.6); transform-origin: 100% 100%;">
              <div class="whitespace-nowrap font-serif text-2xl text-[color:var(--timeline-ink)] text-center">
                Oktober 2025
              </div>
            </div>
          </div>

          <!-- Text below the node -->
          <div data-node3-desc class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+24px)] w-[320px] text-center" style="opacity: 0; transform: scale(0.6); transform-origin: 100% 0%;">
            <p class="text-sm leading-relaxed text-[color:var(--timeline-muted)] text-center text-pretty">
              Aisha diperkenalkan ke keluarga Yofri
            </p>
          </div>
        </div>

        <div id="dot-3" class="h-5 w-5 rounded-full bg-[color:var(--timeline-dot)]" style="transform: scale(0.6); transform-origin: center;"></div>
      </div>

      <!-- Node 4 -->
      <div
        id="node-4"
        class="timeline-node absolute z-30"
        style="left: 680vw; transform: translate(-50%, -50%);"
      >
        <div id="dot-4" class="h-5 w-5 rounded-full bg-[color:var(--timeline-dot)]" style="transform: scale(0.6); transform-origin: center;"></div>

        <div data-node4-pin class="absolute inset-0">
          <div class="absolute left-1/2 -translate-x-1/2 bottom-[calc(100%+24px)]">
            <div data-node4-photo style="opacity: 0; transform: scale(0.6); transform-origin: 100% 100%;">
              <div class="w-[340px] sm:w-[400px] md:w-[560px] max-w-[calc(100vw-32px)] h-auto aspect-[2048/945] overflow-hidden rounded-xl bg-[color:var(--timeline-photo-frame)] shadow-xl ring-1 ring-[color:var(--timeline-photo-ring)]">
                <picture>
                  <source
                    srcset={variantSrcset("keluarga-acik", "avif", 2048)}
                    sizes={SIZES_CARD}
                    type="image/avif"
                  />
                  <img
                    src="/keluarga-acik.webp"
                    srcset={variantSrcset("keluarga-acik", "webp", 2048)}
                    sizes={SIZES_CARD}
                    alt="Yofri bertemu keluarga Aisha"
                    width="2048"
                    height="945"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                </picture>
              </div>
            </div>
          </div>

          <div class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+22px)] w-[320px] flex flex-col items-center">
            <div data-node4-date style="opacity: 0; transform: scale(0.6); transform-origin: 100% 0%;">
              <div class="font-serif text-2xl text-[color:var(--timeline-ink)] text-center">November 2025</div>
            </div>
            <div data-node4-desc class="text-center" style="opacity: 0; transform: scale(0.6); transform-origin: 100% 0%;">
              <p class="mt-2 text-sm leading-relaxed text-[color:var(--timeline-muted)] text-center text-pretty">
                Yofri bertemu keluarga Aisha
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Node 5 -->
      <div
        id="node-5"
        class="timeline-node absolute z-30"
        style="left: 890vw; transform: translate(-50%, -50%);"
      >
        <div data-node5-pin class="absolute inset-0">
          <div class="absolute bottom-[calc(100%+12px)] left-1/2 -translate-x-[85%] whitespace-nowrap text-center">
              <div data-node5-date style="opacity: 0; transform: scale(0.6); transform-origin: 100% 100%;">
                <div class="font-serif text-2xl text-[color:var(--timeline-ink)] text-center">11 April 2026</div>
              </div>
          </div>

          <!-- Photo and Text stay on the authored right side of the dot. -->
          <div class="absolute left-[50vw] -translate-x-1/2 -top-8 flex flex-col items-center w-[280px] md:w-[340px]">
            <div data-node5-photo style="opacity: 0; transform: scale(0.6); transform-origin: 0% 0%;">
              <div class="h-[320px] md:h-[420px] w-auto aspect-[2/3] overflow-hidden rounded-xl bg-[color:var(--timeline-photo-frame)] shadow-xl mb-4 ring-1 ring-[color:var(--timeline-photo-ring)]">
                <!-- No `autoplay`: that attribute defeated preload="none" and
                     pulled 714 KB at parse time on every network. Playback is
                     tier-driven — see applyVideoTier() at the foot of this
                     component's script. -->
                <video id="timeline-video" loop muted playsinline preload="none" aria-label="Lamaran" class="h-full w-full object-cover" width="478" height="850"><source src="/lamaran.mp4" type="video/mp4" /></video>
              </div>
            </div>
            <div data-node5-desc class="text-center" style="opacity: 0; transform: scale(0.6); transform-origin: 0% 0%;">
              <p class="text-sm leading-relaxed text-[color:var(--timeline-muted)] text-center text-pretty">
                Lamaran
              </p>
            </div>
          </div>
        </div>
        <div id="dot-5" class="h-5 w-5 rounded-full bg-[color:var(--timeline-dot)]" style="transform: scale(0.6); transform-origin: center;"></div>
      </div>

      <!-- Node 6 Anchor: restore the original 150vw turn-to-turn spacing, then
           leave the drama to the much longer final vertical leg. -->
      <div
        id="dot-6-anchor"
        class="absolute"
        style="left: 1040vw; width: 20px; height: 20px; transform: translate(-50%, -50%); visibility: hidden;"
      ></div>
      <!-- Node 6 label (black twin): never revealed in the animated run — the
           expansion sweep's white twin is the title's only appearance. This copy
           exists for the reduced-motion story, where CSS forces it visible. -->
      <div
        id="node-6-label-bottom"
        class="timeline-node absolute z-30"
        style="left: 1040vw; transform: translate(-50%, -50%);"
      >
        <div class="relative h-5 w-5">
          <div class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+24px)] whitespace-nowrap text-center">
            <div data-node6-date-bottom style="opacity: 0; transform: scale(0.9); transform-origin: 50% 0%;">
              <div class="max-w-[18ch] font-serif tracking-wide text-[color:var(--timeline-ink)] text-4xl md:text-6xl px-6 text-center">10 Oktober 2026</div>
              <div class="max-w-[18ch] font-serif tracking-wide text-[color:var(--timeline-ink)] text-4xl md:text-6xl px-6 text-center">Menikah</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Top Layer: Overlay (Black BG + White Title) -->
    <!-- z-30: Topmost. Shrinks via clip-path. Visible inside the circle. -->
    <div
      id="timeline-circle-overlay"
      class="absolute inset-0 z-30 pointer-events-none bg-[color:var(--timeline-overlay)]"
      style="clip-path: circle(100vmax at 50% 50%);"
    >
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
        <div class="relative h-4 w-4">
          <div class="absolute bottom-[calc(100%+12px)] left-1/2 -translate-x-1/2 whitespace-nowrap text-center">
            <h2 class="max-w-[18ch] text-center font-serif tracking-wide text-[color:var(--timeline-overlay-ink)] text-4xl md:text-6xl px-6">
              Awal mula
            </h2>
          </div>
        </div>
      </div>
    </div>

    <!-- 4. Expansion Overlay (End) -->
    <!-- z-40: full-stage black layer revealed by a clip-path circle growing from
         dot 9 — the exact inverse of the opening shrink. The white title inside
         sits beneath the dot, hidden until the growing circle's edge reaches it.
         Authored as a sub-pixel seed (matches keyframe 0 exactly): the module
         that wires the scrub (it imports `motion`) only executes after the
         bundle arrives, and until then the intro overlay (#timeline-circle-overlay,
         also authored open) is the topmost pre-JS card — so a user who reaches
         this point before init sees the intro state, never a finale leak. The
         seed also satisfies the promoted spec's "grows from an infinitesimal
         seed" wording. -->
    <div
      id="timeline-circle-expansion"
      class="absolute inset-0 z-40 pointer-events-none bg-[color:var(--timeline-overlay)]"
      style="clip-path: circle(0.001px at 50% 50%);"
    >
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
        <div class="relative h-5 w-5">
          <div class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+24px)] whitespace-nowrap text-center">
            <div class="max-w-[18ch] font-serif tracking-wide text-[color:var(--timeline-overlay-ink)] text-4xl md:text-6xl px-6 text-center">10 Oktober 2026</div>
            <div class="max-w-[18ch] font-serif tracking-wide text-[color:var(--timeline-overlay-ink)] text-4xl md:text-6xl px-6 text-center">Menikah</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 5. Final Node Overlay -->
    <!-- z-50: visible above the growing black circle until it becomes the fill. -->
    <div
      id="node-6"
      class="timeline-node absolute z-50 pointer-events-none"
      style="left: 0; top: 0; width: 100%; height: 100%; transform: translate(0vw, 0lvh); will-change-transform;"
    >
      <div style="position: absolute; left: 1040vw; transform: translate(-50%, -50%);">
        <div
          id="dot-6"
          class="h-5 w-5 rounded-full bg-[color:var(--timeline-overlay-dot)]"
          style="opacity: 0; transform: scale(0.6); transform-origin: center;"
        ></div>
      </div>
    </div>

  </div>
</section>

<style>
  /* Theme tokens (WeddingFAQ precedent). The timeline swaps colors BETWEEN
     themes: light OS renders the dark world (black canvas, white ink, white
     circle overlays), dark OS renders the authored light world (white
     canvas, black ink, black circle overlays). The shrink/expansion
     animation stays visible in both — each overlay contrasts its canvas. */
  #timeline-section {
    --timeline-bg: #0a0a0a;
    --timeline-ink: #ffffff; /* headings, dates */
    --timeline-muted: #a3a3a3; /* neutral-400: story paragraphs */
    --timeline-dot: #ffffff;
    --timeline-line: #ffffff; /* SVG connectors (CSS stroke beats the
                                stroke="black" presentation attribute) */
    --timeline-photo-frame: #262626; /* neutral-800: behind photos */
    --timeline-photo-ring: rgba(255, 255, 255, 0.14); /* white/14 hairline */
    --timeline-overlay: #ffffff; /* shrinking/expanding circle layers */
    --timeline-overlay-ink: #0a0a0a; /* titles inside the circles */
    --timeline-overlay-dot: #ffffff; /* finale dot rides the overlay (z-50) */
  }

  @media (prefers-color-scheme: dark) {
    #timeline-section {
      --timeline-bg: #ffffff;
      --timeline-ink: #0a0a0a;
      --timeline-muted: #525252; /* neutral-600 */
      --timeline-dot: #0a0a0a;
      --timeline-line: #0a0a0a;
      --timeline-photo-frame: #e5e5e5; /* neutral-200 */
      --timeline-photo-ring: rgba(0, 0, 0, 0.1); /* black/10 hairline */
      --timeline-overlay: #0a0a0a;
      --timeline-overlay-ink: #ffffff;
      --timeline-overlay-dot: #0a0a0a;
    }
  }

  /* SVG connectors: stroke presentation attributes cannot use var(), so the
     color is applied here instead (CSS declarations beat presentation
     attributes without needing !important). */
  #timeline-track path[id^="line-"] {
    stroke: var(--timeline-line);
  }

  /* Pinned runway: 210vw story gaps (the 280vw original cut by a quarter, with
     the node verticals compressed to match so no connector steepens) and the
     same compact 150vw finale jog, on the six-node track. Scrollable = 1149lvh:
     intro 66 + horizontal 753 + jog 104 + descent 150 + expansion 65 + tail 11
     — only the horizontal phase shrank (four gaps at the shipped ≈1.12 vw/vh
     cruise), so every other phase and reveal beat keeps its shipped absolute
     scroll length.

     lvh, not svh: lvh is the viewport with browser chrome HIDDEN, which is the
     only state this section is ever seen in — it starts ~17 viewports down, so the
     URL bar has long since retracted. svh leaves the stage ~70px short of the
     screen for the entire pinned run, exposing page background beneath it and
     preventing the intro/expansion circles from fully covering the viewport.
     Never dvh: dvh re-resolves as the chrome moves, changing the scrub length mid-scroll. */
  .timeline-section {
    height: 1249vh;
    height: 1249lvh;
  }

  /* Stage: vh fallback, lvh so the pinned stage fills the chrome-hidden viewport without bottom gaps. */
  .timeline-stage {
    height: 100vh;
    height: 100lvh;
  }

  #timeline-track {
    height: 250vh;
    height: 250lvh;
  }

  /* Node vertical positions, keyed by id so each can carry its vh -> lvh fallback pair.
     Verticals follow the 3/4 horizontal cut so no connector steepens: each leg's
     rise/fall is ~0.75 of the original (within ~1vh of exact — node 1 stays the
     circle center at 50 and node 5 stays the 25 the untouched finale is built on,
     which forces 6.25vh of the original drop back into the profile). Net effect:
     the old track shape at 3/4 scale, same broad S-curves, same slopes. */
  #node-1 { top: 50vh; top: 50lvh; }
  #node-2 { top: 34vh; top: 34lvh; }
  #node-3 { top: 64vh; top: 64lvh; }
  #node-4 { top: 44vh; top: 44lvh; }
  #node-5 { top: 25vh; top: 25lvh; }
  /* Keep the proven 180lvh finale on mobile. Wider viewports place it a little
     deeper for more clearance beneath the right turn and a longer descent. */
  #dot-6-anchor, #node-6 > div, #node-6-label-bottom { top: 180vh; top: 180lvh; }
  @media (min-width: 768px) {
    #dot-6-anchor, #node-6 > div, #node-6-label-bottom { top: 188vh; top: 188lvh; }
  }

  /* Photo container max-heights: vh fallback, lvh for stability */
  [data-node2-photo] > div {
    max-height: calc(65vh - 84px);
    max-height: calc(65lvh - 84px);
  }
  [data-node3-photo] > div {
    max-height: calc(64vh - 96px);
    max-height: calc(64lvh - 96px);
  }
  [data-node4-photo] > div {
    max-height: calc(44vh - 36px);
    max-height: calc(44lvh - 36px);
  }
  [data-node5-photo] > div {
    max-height: calc(55vh - 96px);
    max-height: calc(55lvh - 96px);
  }

  /* Reduced motion: readable vertical story instead of the pinned scrub sequence. */
  @media (prefers-reduced-motion: reduce) {
    .timeline-section {
      height: auto !important;
    }
    .timeline-stage {
      position: relative !important;
      height: auto !important;
      overflow: visible !important;
    }
    #timeline-track > svg,
    #dot-6-anchor,
    #timeline-circle-overlay,
    #timeline-circle-expansion {
      display: none !important;
    }
    /* The intro "Awal mula" card is authored as an absolute overlay on the
       pinned stage; without this rule it stays absolute inside the reflowed
       (relative, auto-height) stage and paints centered mid-story, over node
       content. Reflow it as the story's opening heading instead. The heading's
       markup nests four levels (centering div > size div > label wrapper > h2),
       so every level needs its own static reset — the label wrapper is the
       one that escapes if missed. */
    #title-layer-bottom,
    #title-layer-bottom > div,
    #title-layer-bottom > div > div,
    #title-layer-bottom > div > div > div {
      position: static !important;
      transform: none !important;
      translate: none !important;
      width: auto !important;
      height: auto !important;
      margin: 0 0 1rem !important;
      text-align: center;
    }
    #title-layer-bottom {
      display: block !important;
      opacity: 1 !important;
      padding: 4rem 1.5rem 0;
    }
    #title-layer-bottom h2 {
      white-space: normal !important;
    }
    #timeline-track {
      width: auto !important;
      height: auto !important;
      position: static !important;
      transform: none !important;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4rem;
      padding: 4rem 1.5rem;
    }
    .timeline-node {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      transform: none !important;
      opacity: 1 !important;
      width: 100%;
      max-width: 36rem;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    /* Tailwind v4 compiles -translate-x-1/2 to the standalone `translate`
       property, which the `transform: none` resets above cannot cancel. Without
       this the reflowed story keeps every centered label shifted half its own
       width to the left — the wide nowrap finale title ends up off-screen. */
    .timeline-node,
    .timeline-node * {
      translate: none !important;
    }
    /* Per-node content blocks were art-directed as absolutes; reflow them as flow items. */
    .timeline-node > div {
      position: static !important;
      left: auto !important;
      top: auto !important;
      right: auto !important;
      bottom: auto !important;
      transform: none !important;
      margin: 0 !important;
    }
    /* Dots keep their Tailwind size (dot-6 lacks the scoping attr, so the */
    /* #id rule below would otherwise win the width cascade with width: auto). */
    .timeline-node div[id^="dot-"] {
      width: 1.25rem !important;
      height: 1.25rem !important;
    }
    #node-6 > div > div[id^="dot-"] {
      width: 1.25rem !important;
      height: 1.25rem !important;
    }
    /* Node 1 / node 6 wrap their dot in an extra positioning div; neutralize the */
    /* remaining absolutely-positioned label wrappers inside them. */
    #node-1 > div > div,
    #node-6 > div > div,
    #node-6-label-bottom > div > div {
      position: static !important;
      transform: none !important;
      width: auto !important;
      margin: 0 0 1rem !important;
      text-align: center;
    }
    /* Content wrappers are static in animated mode; flatten them in the
       reduced-motion document flow. */
    [data-node2-pin], [data-node3-pin], [data-node4-pin], [data-node5-pin],
    [data-node2-pin] > *, [data-node3-pin] > *, [data-node4-pin] > *,
    [data-node5-pin] > * {
      position: static !important;
      transform: none !important;
    }
    /* Dot date/photo/desc stacks keep their column flow and spacing. */
    .timeline-node > div {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    /* Force every hidden-by-attribute piece of content visible. */
    [data-node2-photo], [data-node2-date], [data-node2-desc],
    [data-node3-photo], [data-node3-date], [data-node3-desc],
    [data-node4-photo], [data-node4-date], [data-node4-desc],
    [data-node5-photo], [data-node5-date], [data-node5-desc],
    [data-node6-date-bottom] {
      opacity: 1 !important;
      transform: none !important;
    }
    #node-1 {
      opacity: 1 !important;
      visibility: visible !important;
    }
    #dot-6 {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  import { animate } from "motion";

  // JS twin of the CSS --ease-out-expo token; keep in sync.
  const EASE_OUT_EXPO = [0.16, 1, 0.3, 1] as const;

  // 210vw story gaps (the 280vw original at 3/4, verticals compressed to match)
  // drive the horizontal cruise; the finale keeps the compact 150vw jog before its
  // extended descent. Progress fractions are the phase scroll lengths (see the CSS
  // runway comment) over the 1149vh scrollable distance.
  const INTRO_END = 0.0574;
  // Finale camera route: keep panning right at cruise depth through the jog
  // (no diagonal drop), then descend once the anchor column is centered —
  // right, then down. The line still draws its V-H-V; only the camera holds
  // its depth until the corner.
  const FINALE_TURN = 0.7128;   // story cruise ends; the right-pan jog begins (dot 5 centered)
  const FINALE_CORNER = 0.8033; // anchor column centered; the descent begins
  const VERT_END = 0.9339;      // long final descent complete
  // Grow the instant the line lands on dot 6 — a real hold here read as a dead
  // scroll gap between the connection and the outward burst. 0.004 (~4.6lvh) is
  // a sub-tick beat so a slow scroll still shows one completed-connection frame.
  const EXPANSION_START = VERT_END + 0.004;
  const EXPANSION_END = 0.9904;

  const CONNECT_X = 80;
  // Finale elbow height: the first turn sits at 25 + (anchor−25)×T lvh. The
  // horizontal leg must pass below node 5's (video) card. The video is capped
  // at 55lvh−96px so the card's floor sits ≈65–69lvh on short/mid viewports
  // (the fixed 420px height governs on tall ones), and T=0.30 puts the turn
  // at 73.9lvh desktop / 71.5lvh mobile — ≈5lvh under the card floor at every
  // measured height, with ≈26lvh of runway still below the turn. At the
  // original 0.25 the leg sat at ~65.75lvh and crossed the card on desktop.
  const FINALE_ELBOW_T = 0.30;
  const FINALE_NODE_Y = window.matchMedia("(min-width: 768px)").matches ? 188 : 180;
  const PAN_END_X = -990;                   // 1040vw dot centered at 50vw
  const PAN_END_Y = 50 - FINALE_NODE_Y;     // final dot centered vertically

  const PAN_KEYFRAMES: Array<{ t: number; x: number; y: number }> = [
    { t: 0, x: 0, y: 0 },
    { t: INTRO_END, x: 0, y: 0 },
    { t: FINALE_TURN, x: -840, y: 0 },
    { t: FINALE_CORNER, x: PAN_END_X, y: 0 },   // right-pan at cruise depth, no diagonal
    { t: VERT_END, x: PAN_END_X, y: PAN_END_Y },
    { t: 1, x: PAN_END_X, y: PAN_END_Y }
  ];

  // Inverse of panVw over the horizontal ramp: progress at which the track
  // has panned to targetX (vw).
  function progressAtPanX(targetX: number): number {
    for (let i = 1; i < PAN_KEYFRAMES.length; i++) {
      const a = PAN_KEYFRAMES[i - 1];
      const b = PAN_KEYFRAMES[i];
      const lo = Math.min(a.x, b.x);
      const hi = Math.max(a.x, b.x);
      if (targetX >= lo && targetX <= hi && b.x !== a.x) {
        return a.t + ((targetX - a.x) / (b.x - a.x)) * (b.t - a.t);
      }
    }
    return targetX <= PAN_KEYFRAMES[PAN_KEYFRAMES.length - 1].x ? 1 : 0;
  }

  // Reveal beats in progress units, re-derived over the 1149vh scrollable
  // distance so the pop keeps its shipped absolute scroll length
  // (~21.6svh, ~24vw of pan).
  const REVEAL_WINDOW = 0.0188;
  const STAGGER_DATE = 0.0037;
  const STAGGER_DESC = 0.0075;

  let cleanupFns: Array<() => void> = [];
  let resizeTimeout: ReturnType<typeof setTimeout> | undefined;
  let initRaf: number | undefined;
  let settleTimeout: ReturnType<typeof setTimeout> | undefined;

  function initTimeline() {
    // Reduced motion: the CSS media query reflows the timeline into a readable
    // vertical story; no animate()/scroll() scrub bindings are created at all.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }

    if (initRaf) cancelAnimationFrame(initRaf);
    cleanupFns.forEach((fn) => fn());
    cleanupFns = [];
    clearTimeout(resizeTimeout);
    clearTimeout(settleTimeout);

    const section = document.getElementById("timeline-section");
    const titleLayerBottom = document.getElementById("title-layer-bottom");
    const circleOverlay = document.getElementById("timeline-circle-overlay");
    const circleExpansion = document.getElementById("timeline-circle-expansion");
    const track = document.getElementById("timeline-track");

    const node1 = document.getElementById("node-1");
    const node2 = document.getElementById("node-2");
    const node3 = document.getElementById("node-3");
    const node4 = document.getElementById("node-4");
    const node5 = document.getElementById("node-5");

    const dot1 = document.getElementById("dot-1");
    const dot2 = document.getElementById("dot-2");
    const dot3 = document.getElementById("dot-3");
    const dot4 = document.getElementById("dot-4");
    const dot5 = document.getElementById("dot-5");
    const dot6 = document.getElementById("dot-6");
    const dot6Anchor = document.getElementById("dot-6-anchor");


    const line1 = document.getElementById("line-1");
    const line2 = document.getElementById("line-2");
    const line3 = document.getElementById("line-3");
    const line4 = document.getElementById("line-4");
    const line5 = document.getElementById("line-5");

    if (
      !section ||
      !titleLayerBottom ||
      !circleOverlay ||
      !circleExpansion ||
      !track ||
      !node1 ||
      !node2 ||
      !node3 ||
      !node4 ||
      !node5 ||
      !dot1 ||
      !dot2 ||
      !dot3 ||
      !dot4 ||
      !dot5 ||
      !dot6 ||
      !(line1 instanceof SVGPathElement) ||
      !(line2 instanceof SVGPathElement) ||
      !(line3 instanceof SVGPathElement) ||
      !(line4 instanceof SVGPathElement) ||
      !(line5 instanceof SVGPathElement)
    ) {
      return;
    }

    // Content remains in each node's authored coordinate space. Only the reveal
    // transforms animate; no node or wrapper follows/counters the viewport.
    const ORIGIN_Y: Record<number, Record<string, "top" | "bottom">> = {
      2: { date: "bottom", photo: "top", desc: "top" },
      3: { photo: "bottom", date: "bottom", desc: "top" },
      4: { photo: "bottom", date: "top", desc: "top" },
      5: { date: "bottom", photo: "top", desc: "top" }
    };

    const applyRevealOrigins = () => {
      for (const [nodeNum, origins] of Object.entries(ORIGIN_Y)) {
        for (const [part, y] of Object.entries(origins)) {
          const el = document.querySelector<HTMLElement>(`[data-node${nodeNum}-${part}]`);
          if (el) el.style.transformOrigin = `50% ${y}`;
        }
      }
    };

    // Accurate path calculation using getBoundingClientRect to handle all transforms/nesting
    const updatePaths = () => {
      applyRevealOrigins();
      const trackRect = track.getBoundingClientRect();

      const getCenter = (el: HTMLElement) => {
        const r = el.getBoundingClientRect();
        return {
          x: (r.left - trackRect.left) + r.width / 2,
          y: (r.top - trackRect.top) + r.height / 2
        };
      };

      // Sequence-ordered, matching the renumbered DOM ids 1:1 after the trim:
      // index 4 is #dot-5 and index 5 the finale anchor (#dot-6-anchor), so
      // connect(n) is both the sequence index AND the DOM id — connect(5) is
      // the dot-5 connection.
      const points = [
        getCenter(dot1),
        getCenter(dot2),
        getCenter(dot3),
        getCenter(dot4),
        getCenter(dot5),
        getCenter(dot6Anchor!)
      ];

      // Use the Oktober connector as the single shape language for lines 1–3:
      // one broad S with horizontal tangents and no short turn/straight-tail mix.
      type Pt = { x: number; y: number };

      const setSmooth = (line: SVGPathElement, a: Pt, b: Pt) => {
        const midX = (a.x + b.x) / 2;
        const d = `M ${a.x} ${a.y} C ${midX} ${a.y} ${midX} ${b.y} ${b.x} ${b.y}`;
        line.setAttribute("d", d);
        line.setAttribute("pathLength", "1");
        return line.getTotalLength();
      };

      const setSmoothIntoNode5 = (line: SVGPathElement, a: Pt, b: Pt) => {
        // On the narrowest layout, end the S just before node 5's centered card
        // then approach the dot horizontally; this preserves the same curve feel
        // without putting the stroke behind the photo.
        if (window.innerWidth < 360) {
          const endX = b.x - Math.max(136, window.innerWidth * 0.42);
          const midX = (a.x + endX) / 2;
          line.setAttribute("d", `M ${a.x} ${a.y} C ${midX} ${a.y} ${midX} ${b.y} ${endX} ${b.y} H ${b.x}`);
        } else {
          const midX = (a.x + b.x) / 2;
          line.setAttribute("d", `M ${a.x} ${a.y} C ${midX} ${a.y} ${midX} ${b.y} ${b.x} ${b.y}`);
        }
        line.setAttribute("pathLength", "1");
        return line.getTotalLength();
      };

      const setFinale = (line: SVGPathElement, a: Pt, b: Pt) => {
        // A shallow first drop leaves most of the finale for the dramatic last leg.
        const midY = a.y + (b.y - a.y) * FINALE_ELBOW_T;
        const d = `M ${a.x} ${a.y} V ${midY} H ${b.x} V ${b.y}`;
        line.setAttribute("d", d);
        line.setAttribute("pathLength", "1");
        return line.getTotalLength();
      };

      const lens = [
        setSmooth(line1, points[0], points[1]),
        setSmooth(line2, points[1], points[2]),
        setSmooth(line3, points[2], points[3]),
        setSmoothIntoNode5(line4, points[3], points[4]),
        setFinale(line5, points[4], points[5])
      ];

      return { lens, points };
    };

    initRaf = requestAnimationFrame(() => {
      let { lens, points } = updatePaths();
      if (lens.some((l) => l === 0)) {
        ({ lens, points } = updatePaths());
      }

      // Connect thresholds derived from the measured dot centers (all vw, so
      // viewport-invariant — safe to bake into keyframes at init). connect(n)
      // indexes `points`, whose order matches the renumbered DOM ids 1:1.
      const nodeXVw = points.map((p) => (p.x / window.innerWidth) * 100);
      const connect = (nodeNum: number) => progressAtPanX(-(nodeXVw[nodeNum - 1] - CONNECT_X));
      const NODE5_CONTENT_AT = connect(5);

      // Height-only `resize` events are mobile browser chrome collapsing, not a
      // layout change: every measured coordinate here is vw/lvh-based, so the dot
      // geometry is identical before and after. Recomputing would only burn a
      // full rect/path pass on every URL-bar transition, mid-scroll.
      let lastResizeWidth = window.innerWidth;
      const onResize = () => {
        if (window.innerWidth === lastResizeWidth) return;
        lastResizeWidth = window.innerWidth;
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
          updatePaths();
          measureGeometry();
          lastProgress = -1;
          updateProgress();
        }, 120);
      };
      window.addEventListener("resize", onResize);
      cleanupFns.push(() => window.removeEventListener("resize", onResize));


      settleTimeout = setTimeout(() => {
        updatePaths();
        measureGeometry();
        lastProgress = -1;
        updateProgress();
      }, 220);
      const stage = section.querySelector<HTMLElement>(".timeline-stage");
      const scrubAnims: Array<{ pause(): void; time: number; duration: number }> = [];
      const scrubWithScroll = (anim: { pause(): void; time: number; duration: number }) => {
        anim.pause();
        scrubAnims.push(anim);
      };

      // ANIMATIONS

      // 1. Circle Shrink (Top Layer)
      // Use one continuous radius interpolation: this is the exact inverse
      // visual behavior of the final circle's outward scale, with no midpoint
      // keyframe that can jump when the scroll runway changes.
      const bgClipAnim = animate(
        circleOverlay,
        {
          clipPath: [
            "circle(100vmax at 50% 50%)",
            "circle(8px at 50% 50%)",
            "circle(8px at 50% 50%)"
          ]
        },
        { ease: "linear", times: [0, INTRO_END, 1] }
      );
      scrubWithScroll(bgClipAnim);

      // Once the 8px-radius overlay exactly matches dot 1, hand off to the dot.
      const bgOpacityAnim = animate(
        circleOverlay,
        { opacity: [1, 1, 0, 0] },
        { ease: "linear", times: [0, INTRO_END, INTRO_END + 0.001, 1] }
      );
      scrubWithScroll(bgOpacityAnim);

      // 2. Fade out title layers AFTER the circle has shrunk
      // Only fade the bottom layer (black text on white) - the overlay already shrinks via clip-path
      const titleBottomFadeAnim = animate(
        titleLayerBottom,
        { opacity: [1, 1, 0, 0] },
        { ease: "linear", times: [0, INTRO_END, INTRO_END + 0.001, 1] }
      );
      scrubWithScroll(titleBottomFadeAnim);

      // 3. Horizontal Pan + Vertical Scroll at end
      // Constant cruise slope across the horizontal phase (no node-5 kink),
      // vertical finale pan at the end. Keyframes come from the shared
      // PAN_KEYFRAMES table so the inverse mappings stay in sync.
      // Node tops are lvh (with a vh fallback), so the final vertical pan must use
      // the same unit or dot-6 misses the expansion-circle center on phones.
      const vUnit = CSS.supports("height", "1lvh") ? "lvh" : "vh";
      const trackTransformValues = PAN_KEYFRAMES.map((k) => `translate(${k.x}vw, ${k.y}${vUnit})`);
      const trackTimes = PAN_KEYFRAMES.map((k) => k.t);
      const trackAnim = animate(
        track,
        { transform: trackTransformValues },
        { ease: "linear", times: trackTimes }
      );
      scrubWithScroll(trackAnim);

      // node-6 counters the track pan for the expansion hand-off. It reuses
      // the SAME vw/lvh strings as the track (not px-resolved copies), so a
      // real layout resize (width change, not just chrome collapse) re-resolves
      // both identically, keeping dot-6 pinned to the expansion-circle center
      // across resizes without rebuilding keyframes here. (The legacy px baking
      // desynced after any width change because onResize never rebuilt it.)
      const node6TransformAnim = animate(
        document.getElementById("node-6")!,
        { transform: trackTransformValues },
        { ease: "linear", times: trackTimes }
      );
      scrubWithScroll(node6TransformAnim);
      
      // 4. Node 1 Reveal
      // Fade the authored dot in just before the shrinking background
      // reaches the same 8px radius, making the handoff continuous.
      const node1Anim = animate(
        node1,
        {
          opacity: [0, 0, 1, 1],
          transform: ["translate(-50%, -50%)", "translate(-50%, -50%)", "translate(-50%, -50%)", "translate(-50%, -50%)"]
        },
        { ease: "linear", times: [0, INTRO_END, INTRO_END + 0.001, 1] }
      );
      scrubWithScroll(node1Anim);

      // 5. Line 1 Animation
      // Line-N (dot-N → dot-N+1) completes exactly at connect(N+1);
      // line-1 starts drawing when the intro ends.
      const line1Anim = animate(
        line1,
        {
          opacity: [0, 1, 1, 1],
          pathLength: [0, 0, 1, 1]
        },
        { ease: "linear", times: [0, INTRO_END, connect(2), 1] }
      );
      scrubWithScroll(line1Anim);

      // Reusable Node Animation Helper
      // Reveals are scroll-scrubbed pops: each part pops inside one
      // REVEAL_WINDOW-wide window opening exactly at its connect
      // threshold — nothing is visible before the line reaches the dot.
      // Photo leads; date trails +STAGGER_DATE, desc +STAGGER_DESC.
      // Partial scroll maps to partial pops; backward scroll reverses
      // them. Each block's transform-origin points at its dot and is
      // maintained by applyRevealOrigins().
      const REVEAL_TOTAL = 0.61;
      const allNodeParts: Array<{ start: number; anims: Array<{ pause(): void; time: number; duration: number }> }> = [];

      function setupNodeAnimation(nodeNum: number, connectAt: number, contentConnectAt: number = connectAt) {
        const dot = document.getElementById(`dot-${nodeNum}`);
        const photo = document.querySelector(`[data-node${nodeNum}-photo]`);
        const date = document.querySelector(`[data-node${nodeNum}-date]`);
        const desc = document.querySelector(`[data-node${nodeNum}-desc]`);

        if (!dot) return;

        const setHidden = () => {
          dot.style.opacity = "1";
          dot.style.transform = "scale(0.6)";
          if (photo instanceof HTMLElement) {
            photo.style.opacity = "0";
            photo.style.transform = "scale(0.6)";
          }
          if (date instanceof HTMLElement) {
            date.style.opacity = "0";
            date.style.transform = "scale(0.6)";
          }
          if (desc instanceof HTMLElement) {
            desc.style.opacity = "0";
            desc.style.transform = "scale(0.6)";
          }
        };

        setHidden();

        const parts: Array<{ start: number; anims: Array<{ pause(): void; time: number; duration: number }> }> = [];

        // Normal dots use the existing overshoot.
        parts.push({
          start: connectAt,
          anims: [
            animate(
              dot,
              { opacity: [1, 1, 1, 1], transform: ["scale(0.6)", "scale(1.35)", "scale(1)", "scale(1)"] },
              { duration: REVEAL_TOTAL, ease: [EASE_OUT_EXPO, EASE_OUT_EXPO, "linear"], times: [0, 0.492, 0.984, 1] }
            )
          ]
        });

        // Pop: opacity completes in the first ~40% of the window while
        // the scale overshoots 0.6 → 1.06 and settles back to 1.
        const popAnimate = (el: HTMLElement) =>
          animate(
            el,
            {
              opacity: [0, 1, 1],
              transform: ["scale(0.6)", "scale(1.06)", "scale(1)"]
            },
            { duration: 1, ease: [EASE_OUT_EXPO, EASE_OUT_EXPO], times: [0, 0.4, 1] }
          );

        if (photo instanceof HTMLElement) parts.push({ start: contentConnectAt, anims: [popAnimate(photo)] });
        if (date instanceof HTMLElement) parts.push({ start: contentConnectAt + STAGGER_DATE, anims: [popAnimate(date)] });
        if (desc instanceof HTMLElement) parts.push({ start: contentConnectAt + STAGGER_DESC, anims: [popAnimate(desc)] });

        // Scrub only opacity/scale. Position stays authored on the dot and
        // moves solely with the timeline track—never with a second transform.
        parts.forEach((part) => {
          part.anims.forEach((anim) => anim.pause());
          allNodeParts.push(part);
        });
      }

      // Content stays authored on each dot; node 5 intentionally keeps its side card.
      setupNodeAnimation(2, connect(2));
      setupNodeAnimation(3, connect(3));
      setupNodeAnimation(4, connect(4));
      setupNodeAnimation(5, connect(5), NODE5_CONTENT_AT);

      // Form the final dot while it is still below the viewport. It then enters
      // naturally during the long descent instead of spawning at the landing.
      const finalDotReady = FINALE_CORNER + 0.0566;
      const finalDotAnim = animate(
        dot6,
        {
          opacity: [0, 0, 1, 1],
          transform: ["scale(0.9)", "scale(0.9)", "scale(1)", "scale(1)"]
        },
        {
          ease: ["linear", EASE_OUT_EXPO, "linear"],
          times: [0, FINALE_CORNER, finalDotReady, 1]
        }
      );
      scrubWithScroll(finalDotAnim);

      // Line animations (continued): line-N draws from just after the
      // earlier dot's pop (connect(N) + 0.0373) until its tip meets the
      // next dot exactly at connect(N+1).
      const lineDraw = (line: SVGPathElement, start: number, end: number) => {
        const anim = animate(
          line,
          { opacity: [0, 0, 1, 1, 1], pathLength: [0, 0, 0, 1, 1] },
          { ease: "linear", times: [0, start, start, end, 1] }
        );
        scrubWithScroll(anim);
      };

      lineDraw(line2, connect(2) + 0.0373, connect(3));
      lineDraw(line3, connect(3) + 0.0373, connect(4));
      lineDraw(line4, connect(4) + 0.0373, connect(5));

      // Derive draw fractions from the measured V-H-V path so the tip
      // tracks the L-route camera: the horizontal leg draws at exactly
      // the camera's pan rate through the jog (tip rides the centerline
      // at elbow depth), then the final leg draws during the descent.
      const line5Start = connect(5) + 0.0089;
      const finaleMidY = points[4].y + (points[5].y - points[4].y) * FINALE_ELBOW_T;
      const firstLeg = Math.abs(finaleMidY - points[4].y);
      const horizontalLeg = Math.abs(points[5].x - points[4].x);
      const firstTurnFraction = firstLeg / lens[4];
      const secondTurnFraction = (firstLeg + horizontalLeg) / lens[4];
      const line5Anim = animate(
        line5,
        {
          opacity: [0, 0, 1, 1, 1, 1, 1],
          pathLength: [
            0,
            0,
            0,
            firstTurnFraction,
            secondTurnFraction,
            1,
            1
          ]
        },
        {
          ease: "linear",
          times: [
            0,
            connect(5),
            line5Start,
            FINALE_TURN,
            FINALE_CORNER,
            VERT_END,
            1
          ]
        }
      );
      scrubWithScroll(line5Anim);

      // 10. Circle Expansion (End)
      // The grow begins the moment the line completes on the dot, so the
      // connection reads as the trigger. The title stays hidden until the
      // growing circle's edge reaches it — the clip-path sweep itself is
      // the reveal, the inverse of the opening shrink crossing Awal mula.
      const expansionAnim = animate(
        circleExpansion,
        {
          clipPath: [
            "circle(0.001px at 50% 50%)",
            "circle(0.001px at 50% 50%)",
            "circle(100vmax at 50% 50%)",
            "circle(100vmax at 50% 50%)"
          ]
        },
        { ease: "linear", times: [0, EXPANSION_START, EXPANSION_END, 1] }
      );
      scrubWithScroll(expansionAnim);

      // Unified scrub: drive all animations from static lvh-based scroll progress,
      // completely decoupled from the dynamic viewport (dvh) so mobile browser chrome
      // expanding/retracting on reverse scroll never shifts or jumps the timeline.
      const applyProgress = (progress: number) => {
        for (const anim of scrubAnims) {
          anim.time = progress * anim.duration;
        }
        node1.style.visibility = progress >= INTRO_END ? "visible" : "hidden";
        for (const part of allNodeParts) {
          const local = Math.min(1, Math.max(0, (progress - part.start) / REVEAL_WINDOW));
          for (const anim of part.anims) {
            anim.time = local * anim.duration;
          }
        }
      };

      let lastProgress = -1;
      let sectionTop = 0;
      let travel = 0;

      const measureGeometry = () => {
        if (!stage) return;
        sectionTop = section.getBoundingClientRect().top + window.scrollY;
        travel = section.offsetHeight - stage.offsetHeight;
      };

      measureGeometry();

      let sectionVisible = true;
      const observer = new IntersectionObserver(
        (entries) => {
          sectionVisible = entries.some((e) => e.isIntersecting);
          if (sectionVisible) {
            measureGeometry();
            updateProgress();
          }
        },
        { rootMargin: "100% 0px" }
      );
      observer.observe(section);
      cleanupFns.push(() => observer.disconnect());

      const updateProgress = () => {
        if (!sectionVisible && lastProgress >= 0) return;
        if (travel <= 0) return;
        const scrolled = window.scrollY - sectionTop;
        const progress = Math.min(1, Math.max(0, scrolled / travel));
        if (progress === lastProgress) return;
        lastProgress = progress;
        applyProgress(progress);
      };

      window.addEventListener("scroll", updateProgress, { passive: true });
      cleanupFns.push(() => window.removeEventListener("scroll", updateProgress));

      // Initial scrub to current scroll position
      updateProgress();
    });
  }

  // --- Timeline video: tier-conditional playback ---------------------------
  // The element ships without `autoplay` and at preload="none", so no tier
  // transfers its bytes at parse time. On `full` the video plays while its card
  // is in the viewport and pauses when it leaves; on `lite`/`pending` it
  // exposes native controls and never plays without an explicit guest action.
  // The verdict can change mid-pageview — a `pending` measurement resolving, or
  // a measurement contradicting an API `full` — so both directions re-apply.
  const TIMELINE_VIDEO = "#timeline-video";
  let videoObserver: IntersectionObserver | null = null;

  function mediaTier(): string | null {
    return document.documentElement.getAttribute("data-tier");
  }

  // Only an explicit `lite`/`pending` hands the video to the guest. A MISSING
  // attribute means the head script never ran (rollback, inline-script
  // blocker), and media-tiering D4 requires that case to behave like `full` —
  // otherwise the timeline's one moving element is silently left paused with
  // controls on it.
  function isCollapsedTier(): boolean {
    const tier = mediaTier();
    return tier === "lite" || tier === "pending";
  }

  // Where "in view" begins. A constant because the threshold list and the ratio
  // test below must agree.
  const VISIBLE_RATIO = 0.5;

  function applyVideoTier() {
    const video = document.querySelector<HTMLVideoElement>(TIMELINE_VIDEO);
    if (!video) return;

    // Drop any previous observer first: a stale one would keep playing (or
    // pausing) against the policy that has just been replaced.
    if (videoObserver) {
      videoObserver.disconnect();
      videoObserver = null;
    }

    if (!isCollapsedTier()) {
      video.removeAttribute("controls");
      // Mute state is deliberately left to the markup's `muted` on both
      // branches: unattended playback is muted-only under every engine's
      // media policy, and this clip has no audio track at all, so a
      // tier-conditional unmute would be inert today and would silently
      // flip mid-playback if the asset ever grew a soundtrack.
      const observer = new IntersectionObserver(
        (entries) => {
          // isIntersecting is NOT threshold-derived: it means "touches the root
          // at all". Under a single 0.5 threshold the only exit record ever
          // delivered still carries isIntersecting: true, and the crossing to
          // ratio 0 is never queued at all (same threshold index as the
          // sub-0.5 step) — so a test on isIntersecting plays once and never
          // pauses. Read the ratio, and list 0 so the exit is delivered.
          const visible = entries.some((entry) => entry.intersectionRatio >= VISIBLE_RATIO);
          if (visible) {
            // Muted + playsinline, so this needs no user activation; a
            // rejection (engine policy, missing file) just leaves it paused.
            video.play().catch(() => {
              /* stay paused */
            });
          } else if (!video.paused) {
            video.pause();
          }
        },
        { threshold: [0, VISIBLE_RATIO] }
      );
      observer.observe(video);
      videoObserver = observer;
    } else {
      if (!video.paused) video.pause();
      video.setAttribute("controls", "");
    }
  }

  function boot() {
    initTimeline();
    // Not part of initTimeline: that one returns early on reduced motion, and
    // the video's playback policy is not a scroll-scrub binding — a
    // reduced-motion guest still gets play-in-view on full and controls on lite.
    applyVideoTier();
  }

  window.addEventListener("net-tier:change", applyVideoTier);
  document.addEventListener("astro:page-load", boot);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
</script>
