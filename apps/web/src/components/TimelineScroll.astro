      // Use the 5-April connector as the single shape language for lines 1–7:
      // one broad S with horizontal tangents and no short turn/straight-tail mix.
      type Pt = { x: number; y: number };

      const setSmooth = (line: SVGPathElement, a: Pt, b: Pt) => {
        const midX = (a.x + b.x) / 2;
        const d = `M ${a.x} ${a.y} C ${midX} ${a.y} ${midX} ${b.y} ${b.x} ${b.y}`;
        line.setAttribute("d", d);
        line.setAttribute("pathLength", "1");
        return line.getTotalLength();
      };

      const setSmoothIntoNode8 = (line: SVGPathElement, a: Pt, b: Pt) => {
        // On the narrowest layout, end the S just before node 8's centered card
        // then approach the dot horizontally; this preserves the same curve feel
        // without putting the stroke behind the photo.
        if (window.innerWidth < 360) {
          const endX = b.x - Math.max(136, window.innerWidth * 0.42);
          const midX = (a.x + endX) / 2;
          line.setAttribute("d", `M ${a.x} ${a.y} C ${midX} ${a.y} ${midX} ${b.y} ${endX} ${b.y} H ${b.x}`);
        } else {
          const midX = (a.x + b.x) / 2;
          line.setAttribute("d", `M ${a.x} ${a.y} C ${midX} ${a.y} ${midX} ${b.y} ${b.x} ${b.y}`);
        }
        line.setAttribute("pathLength", "1");
        return line.getTotalLength();
      };

      const setFinale = (line: SVGPathElement, a: Pt, b: Pt) => {
        // A shallow first drop leaves most of the finale for the dramatic last leg.
        const midY = a.y + (b.y - a.y) * FINALE_ELBOW_T;
        const d = `M ${a.x} ${a.y} V ${midY} H ${b.x} V ${b.y}`;
        line.setAttribute("d", d);
        line.setAttribute("pathLength", "1");
        return line.getTotalLength();
      };

