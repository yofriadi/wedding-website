---
---

<section id="timeline-section" class="timeline-section relative w-full bg-[color:var(--timeline-bg)]" data-progressive-section>
  <div class="timeline-stage sticky top-0 w-full overflow-hidden">
    
    <!-- 1. Bottom Layer: Title (Black text on White bg) -->
    <!-- Visible outside the shrinking circle. Fades out when timeline starts moving. -->
    <div 
      id="title-layer-bottom"
      class="absolute inset-0 z-0 pointer-events-none"
    >
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
        <div class="relative h-4 w-4">
          <div class="absolute bottom-[calc(100%+12px)] left-1/2 -translate-x-1/2 whitespace-nowrap text-center">
            <h2 class="max-w-[18ch] text-center font-serif tracking-wide text-[color:var(--timeline-ink)] text-4xl md:text-6xl px-6">
              Mula-mula
            </h2>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Track Layer: The scrolling timeline -->
    <!-- z-10: Above bottom title, below top circle overlay -->
    <div
      id="timeline-track"
      class="relative z-10 h-[250vh] w-[1720vw] will-change-transform"
      style="transform: translate(0vw, 0vh); width: 1720vw;"
    >
      <!-- SVG connectors live INSIDE the track -->
      <svg class="absolute inset-0 z-40 h-full w-full pointer-events-none" xmlns="http://www.w3.org/2000/svg">
        <path id="line-1" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
        <path id="line-2" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
        <path id="line-3" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
        <path id="line-4" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
        <path id="line-5" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
        <path id="line-6" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
        <path id="line-7" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
        <path id="line-8" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0" />
      </svg>

      <!-- Node 1 (left) -->
      <!-- Adjusted to 50vw/50% to match shrinking circle center -->
      <div
        id="node-1"
        class="timeline-node absolute z-30 opacity-0"
        style="left: 50vw; visibility: hidden; transform: translate(-50%, -50%);"
      >
        <div
          id="dot-1"
          class="relative h-4 w-4 rounded-full bg-[color:var(--timeline-dot)]"
        >
          <div
            id="node-1-label"
            class="absolute bottom-[calc(100%+12px)] left-1/2 -translate-x-1/2 whitespace-nowrap text-center text-[color:var(--timeline-ink)]"
          >
            <h2 class="max-w-[18ch] text-center font-serif tracking-wide text-inherit text-4xl md:text-6xl px-6">Mula-mula</h2>
          </div>
        </div>
      </div>

      <!-- Node 2 (middle) -->
      <div
        id="node-2"
        class="timeline-node absolute z-30"
        style="left: 260vw; transform: translate(-50%, -50%);"
      >
        <div
          id="dot-2"
          class="h-5 w-5 rounded-full bg-[color:var(--timeline-dot)]"
          style="transform: scale(0.6); transform-origin: center;"
        ></div>

        <!-- Date above the node -->
        <div data-node2-pin class="absolute inset-0">
          <div class="absolute left-1/2 -translate-x-1/2 bottom-[calc(100%+16px)] whitespace-nowrap">
            <div data-node2-date style="opacity: 0; transform: scale(0.6); transform-origin: 100% 100%;">
              <div class="font-serif text-2xl text-[color:var(--timeline-ink)]">Februari 2025</div>
            </div>
          </div>

          <!-- Photo and Text below the node -->
          <div class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+24px)] flex flex-col items-center">
            <div data-node2-photo style="opacity: 0; transform: scale(0.6); transform-origin: 100% 0%;">
              <div class="h-45 w-[320px] md:h-55 md:w-105 overflow-hidden rounded-xl bg-[color:var(--timeline-photo-frame)] shadow-xl ring-1 ring-[color:var(--timeline-photo-ring)]">
                <picture><source data-srcset="/13.avif" type="image/avif" /><img data-src="/13.webp" alt="Februari 2025" width="540" height="960" class="h-full w-full object-cover" decoding="async" /></picture>
              </div>
            </div>

            <div data-node2-desc class="mt-4 w-[320px]" style="opacity: 0; transform: scale(0.6); transform-origin: 100% 0%;">
              <p class="text-sm leading-relaxed text-[color:var(--timeline-muted)] text-pretty">
                Menjadi bulan pertama kami bertemu dan berkenalan. Sebatas teman, dikenalkan oleh Rahadian,
                kakak Aci. Tidak dekat, tidak berlebihan.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Node 3 (right, end) -->
      <!-- Uniform 210vw gaps: the 280vw original scaled to 3/4, with the node
           verticals compressed to match, so every connector keeps the same broad
           S-curve and slope. -->
      <div
        id="node-3"
        class="timeline-node absolute z-30"
        style="left: 470vw; transform: translate(-50%, -50%);"
      >
        <div data-node3-pin class="absolute inset-0">
          <!-- Photo and Date above the node -->
          <div class="absolute left-1/2 -translate-x-1/2 bottom-[calc(100%+24px)] flex flex-col items-center">
            <div data-node3-photo style="opacity: 0; transform: scale(0.6); transform-origin: 100% 100%;">
              <div class="h-45 w-[320px] md:h-55 md:w-105 overflow-hidden rounded-xl bg-[color:var(--timeline-photo-frame)] shadow-xl mb-4 ring-1 ring-[color:var(--timeline-photo-ring)]">
                <picture><source data-srcset="/13.avif" type="image/avif" /><img data-src="/13.webp" alt="5 April 2025" width="540" height="960" class="h-full w-full object-cover" decoding="async" /></picture>
              </div>
            </div>
            <div data-node3-date style="opacity: 0; transform: scale(0.6); transform-origin: 100% 100%;">
              <div class="whitespace-nowrap font-serif text-2xl text-[color:var(--timeline-ink)]">
                5 April 2025
              </div>
            </div>
          </div>

          <!-- Text below the node -->
          <div data-node3-desc class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+24px)] w-[320px]" style="opacity: 0; transform: scale(0.6); transform-origin: 100% 0%;">
            <p class="text-sm leading-relaxed text-[color:var(--timeline-muted)] text-center text-pretty">
              Menjadi bulan pertama kami bertemu dan berkenalan. Sebatas teman, dikenalkan oleh Rahadian, kakak Aci. Tidak dekat, tidak berlebihan.
            </p>
          </div>
        </div>

        <div id="dot-3" class="h-5 w-5 rounded-full bg-[color:var(--timeline-dot)]" style="transform: scale(0.6); transform-origin: center;"></div>
      </div>

      <!-- Node 4 -->
      <div
        id="node-4"
        class="timeline-node absolute z-30"
        style="left: 680vw; transform: translate(-50%, -50%);"
      >
        <div id="dot-4" class="h-5 w-5 rounded-full bg-[color:var(--timeline-dot)]" style="transform: scale(0.6); transform-origin: center;"></div>

        <div data-node4-pin class="absolute inset-0">
          <div class="absolute left-1/2 -translate-x-1/2 bottom-[calc(100%+24px)]">
            <div data-node4-photo style="opacity: 0; transform: scale(0.6); transform-origin: 100% 100%;">
              <div class="h-45 w-[320px] md:h-55 md:w-105 overflow-hidden rounded-xl bg-[color:var(--timeline-photo-frame)] shadow-xl ring-1 ring-[color:var(--timeline-photo-ring)]">
                <picture><source data-srcset="/0.avif" type="image/avif" /><img data-src="/0.webp" alt="28 Juni 2025" width="960" height="720" class="h-full w-full object-cover" decoding="async" /></picture>
              </div>
            </div>
          </div>

          <div class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+22px)] w-[320px] flex flex-col items-center">
            <div data-node4-date style="opacity: 0; transform: scale(0.6); transform-origin: 100% 0%;">
              <div class="font-serif text-2xl text-[color:var(--timeline-ink)]">28 Juni 2025</div>
            </div>
            <div data-node4-desc style="opacity: 0; transform: scale(0.6); transform-origin: 100% 0%;">
              <p class="mt-2 text-sm leading-relaxed text-[color:var(--timeline-muted)] text-center text-pretty">
                Kali pertama kami jalan berdua saja. Aci pikir, perbedaan hobi dan interest akan menjadi hambatan dari merasa nyaman.
                Namun ternyata, candaan dan obrolan mengalir dengan baik. Bahkan diamnya saja menyenangkan.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Node 5 -->
      <div
        id="node-5"
        class="timeline-node absolute z-30"
        style="left: 890vw; transform: translate(-50%, -50%);"
      >
        <div id="dot-5" class="h-5 w-5 rounded-full bg-[color:var(--timeline-dot)]" style="transform: scale(0.6); transform-origin: center;"></div>

        <div data-node5-pin class="absolute inset-0">
          <!-- Photo above the node -->
          <div class="absolute left-1/2 -translate-x-1/2 bottom-[calc(100%+24px)]">
            <div data-node5-photo style="opacity: 0; transform: scale(0.6); transform-origin: 100% 100%;">
              <div class="h-45 w-[320px] md:h-55 md:w-105 overflow-hidden rounded-xl bg-[color:var(--timeline-photo-frame)] shadow-xl ring-1 ring-[color:var(--timeline-photo-ring)]">
                <picture><source data-srcset="/0.avif" type="image/avif" /><img data-src="/0.webp" alt="26 Oktober 2025" width="960" height="720" class="h-full w-full object-cover" decoding="async" /></picture>
              </div>
            </div>
          </div>

          <!-- Date and Text below the node -->
          <div class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+22px)] w-[320px] flex flex-col items-center">
            <div data-node5-date style="opacity: 0; transform: scale(0.6); transform-origin: 100% 0%;">
              <div class="font-serif text-2xl text-[color:var(--timeline-ink)]">26 Oktober 2025</div>
            </div>
            <div data-node5-desc style="opacity: 0; transform: scale(0.6); transform-origin: 100% 0%;">
              <p class="mt-2 text-sm leading-relaxed text-[color:var(--timeline-muted)] text-center text-pretty">
                Pertama kali kami saling mengungkapkan rasa ketertarikan. Sepulangnya dari kafe, Adi langsung mengajak Aci bertemu Mama Nur.
                Salah satu bentuk yang menunjukkan keseriusan untuk melanjutkan ke jenjang berikutnya.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Node 6 -->
      <div
        id="node-6"
        class="timeline-node absolute z-30"
        style="left: 1100vw; transform: translate(-50%, -50%);"
      >
        <div id="dot-6" class="h-5 w-5 rounded-full bg-[color:var(--timeline-dot)]" style="transform: scale(0.6); transform-origin: center;"></div>

        <div data-node6-pin class="absolute inset-0">
          <div class="absolute left-1/2 -translate-x-1/2 bottom-[calc(100%+24px)]">
            <div data-node6-photo style="opacity: 0; transform: scale(0.6); transform-origin: 100% 100%;">
              <div class="h-45 w-[320px] md:h-55 md:w-105 overflow-hidden rounded-xl bg-[color:var(--timeline-photo-frame)] shadow-xl ring-1 ring-[color:var(--timeline-photo-ring)]">
                <picture><source data-srcset="/0.avif" type="image/avif" /><img data-src="/0.webp" alt="1 November 2025" width="960" height="720" class="h-full w-full object-cover" decoding="async" /></picture>
              </div>
            </div>
          </div>

          <div class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+22px)] w-[320px] text-center">
            <div data-node6-date style="opacity: 0; transform: scale(0.6); transform-origin: 100% 0%;">
              <div class="font-serif text-2xl text-[color:var(--timeline-ink)]">1 November 2025</div>
            </div>
            <div data-node6-desc style="opacity: 0; transform: scale(0.6); transform-origin: 100% 0%;">
              <p class="mt-2 text-sm leading-relaxed text-[color:var(--timeline-muted)] text-pretty">
                Foto berdua kami yang pertama. Kami mulai sore di hari hujan itu dengan bercerita. Tentang diri, tentang pertemanan kami,
                tentang kisah yang lalu, dan rencana-rencana masa depan kami.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Node 7 -->
      <div
        id="node-7"
        class="timeline-node absolute z-30"
        style="left: 1310vw; transform: translate(-50%, -50%);"
      >
        <div id="dot-7" class="h-5 w-5 rounded-full bg-[color:var(--timeline-dot)]" style="transform: scale(0.6); transform-origin: center;"></div>

        <div data-node7-pin class="absolute inset-0">
          <!-- Photo above the node -->
          <div class="absolute left-1/2 -translate-x-1/2 bottom-[calc(100%+24px)]">
            <div data-node7-photo style="opacity: 0; transform: scale(0.6); transform-origin: 100% 100%;">
              <div class="h-45 w-[320px] md:h-55 md:w-105 overflow-hidden rounded-xl bg-[color:var(--timeline-photo-frame)] shadow-xl ring-1 ring-[color:var(--timeline-photo-ring)]">
                <picture><source data-srcset="/0.avif" type="image/avif" /><img data-src="/0.webp" alt="29-30 November 2025" width="960" height="720" class="h-full w-full object-cover" decoding="async" /></picture>
              </div>
            </div>
          </div>

          <!-- Date and Text below the node -->
          <div class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+22px)] w-[320px] text-center">
            <div data-node7-date style="opacity: 0; transform: scale(0.6); transform-origin: 100% 0%;">
              <div class="font-serif text-2xl text-[color:var(--timeline-ink)]">29-30 November 2025</div>
            </div>
            <div data-node7-desc style="opacity: 0; transform: scale(0.6); transform-origin: 100% 0%;">
              <p class="mt-2 text-sm leading-relaxed text-[color:var(--timeline-muted)] text-pretty">
                Aci membawa Adi ke rumah Solo. Mengenalkan kepada orang tua Aci, saudara Aci, keluarga besar. Go public!
                Ditandai dengan unggahan story media sosial. Tanpa penjelasan, cukup foto kami berdua.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Node 8 -->
      <div
        id="node-8"
        class="timeline-node absolute z-30"
        style="left: 1520vw; transform: translate(-50%, -50%);"
      >
        <div data-node8-pin class="absolute inset-0">
          <div class="absolute bottom-[calc(100%+12px)] left-1/2 -translate-x-1/2 whitespace-nowrap text-center">
              <div data-node8-date style="opacity: 0; transform: scale(0.6); transform-origin: 100% 100%;">
                <div class="font-serif text-2xl text-[color:var(--timeline-ink)]">11 April 2026</div>
              </div>
          </div>

          <!-- Photo and Text stay on the authored right side of the dot. -->
          <div class="absolute left-[50vw] -translate-x-1/2 top-4 flex flex-col items-center w-[260px]">
            <div data-node8-photo style="opacity: 0; transform: scale(0.6); transform-origin: 0% 0%;">
              <div class="h-45 w-full overflow-hidden rounded-xl bg-[color:var(--timeline-photo-frame)] shadow-xl mb-4 ring-1 ring-[color:var(--timeline-photo-ring)]">
                <picture><source data-srcset="/0.avif" type="image/avif" /><img data-src="/0.webp" alt="Lamaran" width="960" height="720" class="h-full w-full object-cover" decoding="async" /></picture>
              </div>
            </div>
            <div data-node8-desc style="opacity: 0; transform: scale(0.6); transform-origin: 0% 0%;">
              <p class="text-sm leading-relaxed text-[color:var(--timeline-muted)] text-center text-pretty">
                Momentum besar bagi kami sebagai langkah awal dalam menjalin hubungan yang lebih serius. Lamaran.
              </p>
            </div>
          </div>
        </div>
        <div id="dot-8" class="h-5 w-5 rounded-full bg-[color:var(--timeline-dot)]" style="transform: scale(0.6); transform-origin: center;"></div>
      </div>

      <!-- Node 9 Anchor: restore the original 150vw turn-to-turn spacing, then
           leave the drama to the much longer final vertical leg. -->
      <div
        id="dot-9-anchor"
        class="absolute"
        style="left: 1670vw; width: 20px; height: 20px; transform: translate(-50%, -50%); visibility: hidden;"
      ></div>
      <!-- Node 9 label (black twin): never revealed in the animated run — the
           expansion sweep's white twin is the title's only appearance. This copy
           exists for the reduced-motion story, where CSS forces it visible. -->
      <div
        id="node-9-label-bottom"
        class="timeline-node absolute z-30"
        style="left: 1670vw; transform: translate(-50%, -50%);"
      >
        <div class="relative h-5 w-5">
          <div class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+24px)] whitespace-nowrap text-center">
            <div data-node9-date-bottom style="opacity: 0; transform: scale(0.9); transform-origin: 50% 0%;">
              <div class="max-w-[18ch] font-serif tracking-wide text-[color:var(--timeline-ink)] text-4xl md:text-6xl px-6">10 October 2026</div>
              <div class="max-w-[18ch] font-serif tracking-wide text-[color:var(--timeline-ink)] text-4xl md:text-6xl px-6">Menikah</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Top Layer: Overlay (Black BG + White Title) -->
    <!-- z-30: Topmost. Shrinks via clip-path. Visible inside the circle. -->
    <div
      id="timeline-circle-overlay"
      class="absolute inset-0 z-30 pointer-events-none bg-[color:var(--timeline-overlay)]"
      style="clip-path: circle(100vmax at 50% 50%);"
    >
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
        <div class="relative h-4 w-4">
          <div class="absolute bottom-[calc(100%+12px)] left-1/2 -translate-x-1/2 whitespace-nowrap text-center">
            <h2 class="max-w-[18ch] text-center font-serif tracking-wide text-[color:var(--timeline-overlay-ink)] text-4xl md:text-6xl px-6">
              Mula-mula
            </h2>
          </div>
        </div>
      </div>
    </div>

    <!-- 4. Expansion Overlay (End) -->
    <!-- z-40: full-stage black layer revealed by a clip-path circle growing from
         dot 9 — the exact inverse of the opening shrink. The white title inside
         sits beneath the dot, hidden until the growing circle's edge reaches it.
         Authored as a sub-pixel seed (matches keyframe 0 exactly): the module
         that wires the scrub (it imports `motion`) only executes after the
         bundle arrives, and until then the intro overlay (#timeline-circle-overlay,
         also authored open) is the topmost pre-JS card — so a user who reaches
         this point before init sees the intro state, never a finale leak. The
         seed also satisfies the promoted spec's "grows from an infinitesimal
         seed" wording. -->
    <div
      id="timeline-circle-expansion"
      class="absolute inset-0 z-40 pointer-events-none bg-[color:var(--timeline-overlay)]"
      style="clip-path: circle(0.001px at 50% 50%);"
    >
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
        <div class="relative h-5 w-5">
          <div class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+24px)] whitespace-nowrap text-center">
            <div class="max-w-[18ch] font-serif tracking-wide text-[color:var(--timeline-overlay-ink)] text-4xl md:text-6xl px-6">10 October 2026</div>
            <div class="max-w-[18ch] font-serif tracking-wide text-[color:var(--timeline-overlay-ink)] text-4xl md:text-6xl px-6">Menikah</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 5. Final Node Overlay -->
    <!-- z-50: visible above the growing black circle until it becomes the fill. -->
    <div
      id="node-9"
      class="timeline-node absolute z-50 pointer-events-none"
      style="left: 0; top: 0; width: 100%; height: 100%; transform: translate(0vw, 0vh); will-change-transform;"
    >
      <div style="position: absolute; left: 1670vw; transform: translate(-50%, -50%);">
        <div
          id="dot-9"
          class="h-5 w-5 rounded-full bg-[color:var(--timeline-overlay-dot)]"
          style="opacity: 0; transform: scale(0.6); transform-origin: center;"
        ></div>
      </div>
    </div>

  </div>
</section>

<style>
  /* Theme tokens (WeddingFAQ precedent). The timeline swaps colors BETWEEN
     themes: light OS renders the dark world (black canvas, white ink, white
     circle overlays), dark OS renders the authored light world (white
     canvas, black ink, black circle overlays). The shrink/expansion
     animation stays visible in both — each overlay contrasts its canvas. */
  #timeline-section {
    --timeline-bg: #0a0a0a;
    --timeline-ink: #ffffff; /* headings, dates */
    --timeline-muted: #a3a3a3; /* neutral-400: story paragraphs */
    --timeline-dot: #ffffff;
    --timeline-line: #ffffff; /* SVG connectors (CSS stroke beats the
                                stroke="black" presentation attribute) */
    --timeline-photo-frame: #262626; /* neutral-800: behind photos */
    --timeline-photo-ring: rgba(255, 255, 255, 0.14); /* white/14 hairline */
    --timeline-overlay: #ffffff; /* shrinking/expanding circle layers */
    --timeline-overlay-ink: #0a0a0a; /* titles inside the circles */
    --timeline-overlay-dot: #ffffff; /* finale dot rides the overlay (z-50) */
  }

  @media (prefers-color-scheme: dark) {
    #timeline-section {
      --timeline-bg: #ffffff;
      --timeline-ink: #0a0a0a;
      --timeline-muted: #525252; /* neutral-600 */
      --timeline-dot: #0a0a0a;
      --timeline-line: #0a0a0a;
      --timeline-photo-frame: #e5e5e5; /* neutral-200 */
      --timeline-photo-ring: rgba(0, 0, 0, 0.1); /* black/10 hairline */
      --timeline-overlay: #0a0a0a;
      --timeline-overlay-ink: #ffffff;
      --timeline-overlay-dot: #0a0a0a;
    }
  }

  /* SVG connectors: stroke presentation attributes cannot use var(), so the
     color is applied here instead (CSS declarations beat presentation
     attributes without needing !important). */
  #timeline-track path[id^="line-"] {
    stroke: var(--timeline-line);
  }

  /* Pinned runway: 210vw story gaps (the 280vw original cut by a quarter, with
     the node verticals compressed to match so no connector steepens), the same
     compact 150vw finale jog, a deeper final node, and a deliberately extended
     descent. Scrollable = 1713vh: intro 66 + horizontal 1317 + jog 104 +
     descent 150 + expansion 65 + tail 11 — only the horizontal phase shrank,
     so every other beat keeps its original scroll density.

     lvh, not svh: `lvh` is the viewport with browser chrome HIDDEN, which is the
     only state this section is ever seen in — it starts ~17 viewports down, so the
     URL bar has long since retracted. svh would leave the stage ~70px short of the
     screen for the entire pinned run. Never dvh: it re-resolves as the chrome
     moves, changing the scrub length mid-scroll. */
  .timeline-section {
    height: 1813vh;
    height: 1813lvh;
  }

  /* Stage: vh fallback, lvh so the pinned stage fills the chrome-hidden viewport. */
  .timeline-stage {
    height: 100vh;
    height: 100lvh;
  }

  /* Node vertical positions, keyed by id so each can carry its vh -> lvh fallback pair.
