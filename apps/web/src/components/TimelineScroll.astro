      // layout change: every measured coordinate here is vw/lvh-based, so the dot
      // geometry is identical before and after. Recomputing would only burn a
      // full rect/path pass on every URL-bar transition, mid-scroll.
      let lastResizeWidth = window.innerWidth;
      const onResize = () => {
        if (window.innerWidth === lastResizeWidth) return;
        lastResizeWidth = window.innerWidth;
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
          updatePaths();
