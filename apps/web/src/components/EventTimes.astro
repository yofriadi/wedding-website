---
/**
 * EventTimes — Schedule Cards
 *
 * Stacked cards (above and below) with full-bleed blurred imagery,
 * centered white text with shadow, bold Venue font, and scroll animations:
 * - Stacked cards (Card 1 above, Card 2 below).
 * - Full-bleed background image covering the card with soft blur and scrim.
 * - Text in the center: white with shadow, bold Venue font (font-serif) for title and time.
 * - Bidirectional scroll animation: smooth fade-in and fade-out on scroll back and forth.
 * - No hover effects.
 * - Honors prefers-reduced-motion with instant visibility and no travel.
 */
const EVENTS = [
  {
    short: "Akad",
    name: "Akad Nikah",
    time: "08:00 WIB",
    audience: "Keluarga & Kerabat",
    image: "/event-akad",
    width: 768,
    height: 433,
  },
  {
    short: "Resepsi",
    name: "Resepsi",
    time: "10:00 WIB",
    audience: "Tamu & Undangan",
    image: "/event-resepsi",
    width: 584,
    height: 525,
  },
];
---

<section id="event-times" class="relative z-10 w-full overflow-hidden py-12 md:py-16" aria-label="Rangkaian Acara">
  {/* Section header: Rangkaian Acara in Venue font */}
  <div class="mx-auto max-w-2xl px-6 text-center mb-10 md:mb-14" data-event-header data-scroll-fade>
    <h2 class="font-serif text-3xl font-light text-[color:var(--times-heading)] md:text-4xl">
      Rangkaian Acara
    </h2>
  </div>

  {/* Stacked cards (above and below) */}
  <div class="flex flex-col gap-6 md:gap-8 w-full">
    {
      EVENTS.map((event, i) => (
        <article
          class="event-card relative h-[172px] sm:h-[208px] md:h-[245px] w-full overflow-hidden border-y text-center"
          data-event-card
          data-scroll-fade="card"
          data-index={i}
          aria-label={`${event.name} pukul ${event.time} untuk ${event.audience}`}
        >
          {/* Background image — fully covers the card with soft blur */}
          <picture class="pointer-events-none absolute inset-0">
            <source srcset={`${event.image}.avif`} type="image/avif" />
            <img
              src={`${event.image}.webp`}
              alt=""
              loading="lazy"
              width={event.width}
              height={event.height}
              class="times-img pointer-events-none absolute inset-0 h-full w-full object-cover"
            />
          </picture>

          {/* Scrim: gradient for legibility matching previous component */}
          <span class="pointer-events-none absolute inset-0 bg-[color:var(--times-scrim)]" />

          {/* Centered white text with text shadow */}
          <div class="times-center-text pointer-events-none absolute inset-0 flex flex-col items-center justify-center gap-1.5 sm:gap-2 p-4 sm:p-6 text-center text-white">
            <h3 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white leading-tight times-text-shadow whitespace-nowrap">
              {event.name}
            </h3>
            <span class="font-serif text-xl sm:text-2xl md:text-3xl font-medium tabular-nums text-white times-text-shadow">
              {event.time}
            </span>
            <p class="font-serif text-base sm:text-lg md:text-xl text-white times-text-shadow">
              {event.audience}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  #event-times {
    --times-heading: #f5f5f5;
    --times-border: rgba(255, 255, 255, 0.1);
    --times-border-top: rgba(255, 255, 255, 0.2);
    --times-shadow: 0 4px 24px -2px rgba(0, 0, 0, 0.5);
    --times-scrim: linear-gradient(to top, rgb(0 0 0 / 0.6), rgb(0 0 0 / 0.22));
  }

  @media (prefers-color-scheme: light) {
    #event-times {
      --times-heading: #171717;
      --times-border: rgba(0, 0, 0, 0.08);
      --times-border-top: rgba(255, 255, 255, 0.6);
      --times-shadow: 0 2px 14px rgba(0, 0, 0, 0.06);
      --times-scrim: linear-gradient(to top, rgb(0 0 0 / 0.5), rgb(0 0 0 / 0.16));
    }
  }

  .event-card {
    border-color: var(--times-border);
    border-top-color: var(--times-border-top);
    box-shadow: var(--times-shadow);
    /* No `will-change` here: scroll-fade.ts owns the hint and rents it only
       while the card is actually travelling, then releases the layer. A static
       declaration would pin a compositor layer for the whole session. */
  }

  .times-img {
    filter: blur(2.5px);
    transform: scale(1.08);
    /* Both values are constant — nothing animates this image. Hinting
       `filter` would force a re-rasterized layer for a blur that never
       changes. */
  }

  .times-text-shadow {
    text-shadow:
      0 1px 8px rgba(0, 0, 0, 0.4),
      0 1px 2px rgba(0, 0, 0, 0.5);
  }

  @media (prefers-reduced-motion: reduce) {
    .event-card,
    [data-event-header] {
      opacity: 1 !important;
      transform: none !important;
      will-change: auto !important;
    }
  }
</style>

<script>
  import "../scripts/scroll-fade";
</script>
