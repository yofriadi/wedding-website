---
/**
 * WishMarquee Component
 * Extracted from: https://21st.dev/community/components/jatin-yadav05/design-testimonial/default
 *
 * Displays a scrolling marquee of wish text.
 *
 * Display states (guest-submissions D3; public-wall makes them universal):
 * - 0 real wish texts (any visitor): demo + leading "Be the first to leave a wish ✨" card.
 * - ≥1 real wish text (any visitor): real only (demo evicted), readable styling.
 * The marquee fetches /api/submissions once per load for EVERYONE — the old
 * public zero-request guarantee is retired (public-wall D2); anonymous
 * callers simply get `mine: null`.
 *
 * Marquee speed derives from measured content width (duration = width / speed),
 * harvested from the original WishMarquee mockup — fixed durations would make a
 * single real wish crawl at ~6px/s and look frozen.
 */

const wishes = [
  "Wishing you a lifetime of love and happiness",
  "May your journey together be filled with joy",
  "Congratulations on your wedding day",
  "Here's to a long and happy marriage",
  "Best wishes for a fun-filled future together",
];
---

<div class="marquee-root" data-wish-marquee>
  <script is:inline type="application/json" data-demo-wishes set:html={JSON.stringify(wishes).replace(/</g, "\\u003c")}></script>
  <!-- Row 1 -->
  <div class="marquee-track track-1">
    <div class="marquee-content">
      {wishes.map((text) => (
        <span class="marquee-item">{text}</span>
      ))}
    </div>
    <div class="marquee-content" aria-hidden="true">
      {wishes.map((text) => (
        <span class="marquee-item">{text}</span>
      ))}
    </div>
  </div>

  <!-- Row 2 -->
  <div class="marquee-track track-2">
    <div class="marquee-content">
      {wishes.map((text) => (
        <span class="marquee-item">{text}</span>
      ))}
    </div>
    <div class="marquee-content" aria-hidden="true">
      {wishes.map((text) => (
        <span class="marquee-item">{text}</span>
      ))}
    </div>
  </div>

  <!-- Row 3 -->
  <div class="marquee-track track-3">
    <div class="marquee-content">
      {wishes.map((text) => (
        <span class="marquee-item">{text}</span>
      ))}
    </div>
    <div class="marquee-content" aria-hidden="true">
      {wishes.map((text) => (
        <span class="marquee-item">{text}</span>
      ))}
    </div>
  </div>

  <!-- Row 4 -->
  <div class="marquee-track track-4">
    <div class="marquee-content">
      {wishes.map((text) => (
        <span class="marquee-item">{text}</span>
      ))}
    </div>
    <div class="marquee-content" aria-hidden="true">
      {wishes.map((text) => (
        <span class="marquee-item">{text}</span>
      ))}
    </div>
  </div>
</div>

<style is:global>
  /* is:global because the invitee states rebuild rows with DOM APIs at runtime;
     dynamically created elements cannot carry Astro's scoping attribute. Every
     selector is namespaced under marquee-* (this component is rendered once). */
  .marquee-root {
    /* Layout & Positioning */
    position: relative;
    width: 100%;
    overflow: hidden;
    user-select: none;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem; /* More close spacing */

    /* Visual styles */
    opacity: 0.1;
    transition: opacity 300ms ease;
  }

  /* Invitee states raise readability. Empty state: the demo stays ambient but
     the leading CTA card must be legible. Real state: fully readable and
     pointer-events enabled (only here, per D3). */
  .marquee-root[data-state="empty"] {
    opacity: 0.45;
  }

  .marquee-root[data-state="real"] {
    opacity: 0.9;
    pointer-events: auto;
  }

  /* Real wishes are readable content: pause on hover/focus so a guest can
     actually read one. Demo/empty texture never pauses (nothing to read). */
  .marquee-root[data-state="real"]:hover .marquee-content,
  .marquee-root[data-state="real"]:focus-within .marquee-content {
    animation-play-state: paused;
  }

  .marquee-track {
    display: flex;
    white-space: nowrap;
    overflow: hidden;
    width: 100%;
  }

  .marquee-content {
    display: flex;
    flex-shrink: 0;

    /* Text styles */
    font-size: 1.5rem;
    line-height: 1.25; /* Slightly tighter line height for compactness */
    font-weight: 500;
    letter-spacing: 0.02em;

    /* Animation */
    animation: marquee-scroll 120s linear infinite;
  }

  /* Different start offsets (negative delay) for each row */
  .track-1 .marquee-content {
    animation-delay: 0s;
    animation-duration: 145s;
  }

  .track-2 .marquee-content {
    animation-delay: -20s;
    animation-duration: 200s;
  }

  .track-3 .marquee-content {
    animation-delay: -40s;
    animation-duration: 165s;
  }

  .track-4 .marquee-content {
    animation-delay: -60s;
    animation-duration: 185s;
  }

  .marquee-item {
    margin: 0 1.5rem;
  }

  /* Marquee items: ambient demo texture vs readable real wishes (D3a).
     Colors come from --wishes-* tokens inherited from index.astro's :root
     (rsvp-* precedent) so the band inverts with the OS theme. */
  .marquee-content {
    color: var(--wishes-text);
  }

  /* Real wishes: readable color + visual clamp for long text (D3a). */
  .marquee-root[data-state="real"] .marquee-item {
    color: var(--wishes-real-text);
    max-width: 36rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Leading card for the invitee-with-zero-wishes state. */
  .marquee-root .marquee-cta {
    color: var(--wishes-cta-text);
    font-weight: 500;
    background: var(--wishes-cta-bg);
    border: 1px solid var(--wishes-cta-border);
    border-radius: 9999px;
    padding: 0.3rem 1.1rem;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }

  /* Constant motion is the first thing to go: the wishes stay readable as a
     static texture instead of four looping tracks. */
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
    .marquee-root {
      transition: none;
    }
  }
</style>

<script>
  // Shared, once-per-page-load fetch of GET /api/submissions (also used by
  // the story rail): one request per page load, for every visitor.
  import type { SubmissionsPayload } from "../lib/submissions-client";
  import { loadSubmissions } from "../lib/submissions-client";

  // WishMarquee client states (guest-submissions 2.4; public-wall D2 retires
  // the cookie gate). Built from scratch — this component had no client
  // script before.
  //
  // EVERY visitor fetches /api/submissions and swaps all four rows as a unit
  // (anonymous callers receive mine: null from the public wall):
  //   0 real wish texts (own + wall) → demo + leading CTA card
  //   ≥1 real wish text              → real-only, demo evicted
  // Wish cards are built with createElement/textContent ONLY — never
  // innerHTML — since wish text is guest-supplied.

  const CTA_TEXT = "Be the first to leave a wish ✨";

  // Ambient surface: cap the repeated unit so the loop stays minutes, not
  // hours, once dozens of wishes exist (the API returns newest-first, so the
  // cap keeps the most recent wishes).
  const MAX_UNIT_ITEMS = 24;

  // Per-row speeds in px/s. Ratios preserved from the demo's fixed durations
  // (145/200/165/185s across a ~7kpx copy ≈ 48/35/42/38 px/s); the durations
  // themselves are NOT kept — they are derived from measured content width.
  const ROW_SPEEDS = [48, 35, 42, 38];

  // Loop-phase offsets as a fraction of each row's duration (from the demo's
  // -20/-40/-60s delays), so rebuilt rows keep the staggered look.
  const ROW_PHASES = [0, 0.1, 0.242, 0.324];

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  interface RowConfig {
    track: HTMLElement;
    items: HTMLElement[];
    speed: number;
    phase: number;
    // Widened for D6: the row's live scroll offset (px) captured just before
    // a rebuild clears it, so the rebuilt row resumes from its pixel position
    // instead of restarting at its phase offset. Undefined on first build.
    resumeX?: number;
  }

  let rows: RowConfig[] = [];
  let resizeTimer: number | undefined;
  let resizeAttached = false;
  let loadGeneration = 0; // monotonic guard against stale GETs (see load)

  // All real wish texts: the caller's own (mine) + the wall. The API's wall
  // already excludes the caller's own submission (dedupe by id server-side),
  // so concatenating cannot duplicate it.
  function collectRealWishes(data: SubmissionsPayload): string[] {
    const wishes: string[] = [];
    const own = data.mine?.wishText;
    if (typeof own === "string" && own.length > 0) {
      wishes.push(own);
    }
    const wall = Array.isArray(data.wall?.wishes) ? data.wall?.wishes : [];
    for (const entry of wall) {
      const text = entry?.text;
      if (typeof text === "string" && text.length > 0) {
        wishes.push(text);
      }
    }
    return wishes;
  }

  function readDemoWishes(root: HTMLElement): string[] {
    const el = root.querySelector("script[data-demo-wishes]");
    if (!el?.textContent) return [];
    try {
      const parsed: unknown = JSON.parse(el.textContent);
      if (!Array.isArray(parsed)) return [];
      return parsed.filter((v): v is string => typeof v === "string" && v.length > 0);
    } catch {
      return [];
    }
  }

  function wishItem(text: string): HTMLSpanElement {
    const span = document.createElement("span");
    span.className = "marquee-item";
    span.textContent = text; // guest-supplied text: DOM APIs only, never innerHTML
    return span;
  }

  function ctaItem(): HTMLSpanElement {
    const span = document.createElement("span");
    span.className = "marquee-item marquee-cta";
    span.textContent = CTA_TEXT;
    return span;
  }

  function rebuild(root: HTMLElement, items: HTMLElement[]): void {
    const tracks = Array.from(root.querySelectorAll<HTMLElement>(".marquee-track"));
    rows = tracks.map((track, i) => ({
      track,
      items,
      speed: ROW_SPEEDS[i % ROW_SPEEDS.length] ?? 40,
      phase: ROW_PHASES[i % ROW_PHASES.length] ?? 0,
    }));
    for (const row of rows) {
      rebuildRow(row);
    }
    if (!reducedMotion) {
      attachResizeHandler();
    }
  }

  function rebuildRow(row: RowConfig): void {
    const { track, items, speed, phase } = row;

    // Capture the live transform X BEFORE clearing the track (D6): the CSS
    // animation's current translateX, read from the running copy. Only rows
    // we built before carry an inline animationDuration — SSR content on the
    // first build does not, and falls back to the staggered phase below.
    if (!reducedMotion) {
      const current = track.querySelector<HTMLElement>(".marquee-content");
      if (current?.style.animationDuration) {
        const transform = getComputedStyle(current).transform;
        if (transform && transform !== "none") {
          try {
            row.resumeX = new DOMMatrixReadOnly(transform).m41;
          } catch {
            row.resumeX = undefined; // unparsable matrix: fall back to phase
          }
        } else {
          row.resumeX = 0; // identity transform: the loop is at its start
        }
      }
    }

    while (track.firstChild) {
      track.removeChild(track.firstChild);
    }

    // First copy with a single unit, to measure the unit width. Items are
    // TEMPLATES: every append is a clone — appending an original would move
    // it out of the previous row's DOM (a node has one parent).
    const copy = document.createElement("div");
    copy.className = "marquee-content";
    for (const item of items) {
      copy.appendChild(item.cloneNode(true));
    }
    track.appendChild(copy);

    // Fill-to-width (D3a): repeat the unit until one copy is wider than the
    // track, so a single real wish still fills the row with no blank gap.
    const unitWidth = copy.offsetWidth;
    const trackWidth = track.offsetWidth || window.innerWidth;
    const safeUnit = Math.max(unitWidth, 1);
    const repeats = Math.max(1, Math.ceil((trackWidth + 1) / safeUnit));

    if (repeats > 1) {
      copy.replaceChildren();
      for (let r = 0; r < repeats; r++) {
        for (const item of items) {
          copy.appendChild(item.cloneNode(true));
        }
      }
    }

    // Speed derives from content width — duration = width / speed (harvested
    // from the deleted mockup). Inline style overrides the stylesheet's fixed
    // per-track durations; the resume-aware negative delay (D6) keeps a
    // rebuilt row continuing from its pixel offset, first build staggered.
    if (!reducedMotion) {
      const width = copy.offsetWidth;
      const duration = width / speed;
      copy.style.animationDuration = `${duration}s`;
      // Resume-aware negative delay: continue from the captured pixel offset
      // (|resumeX| mod one loop width, as a fraction of the duration); first
      // build (no capture) keeps the staggered phase offsets.
      const offsetFraction =
        row.resumeX !== undefined
          ? (Math.abs(row.resumeX) % width) / width
          : phase;
      copy.style.animationDelay = `${-offsetFraction * duration}s`;
    }

    // Two-copy structure: the aria-hidden twin keeps the loop seamless.
    const twin = copy.cloneNode(true) as HTMLElement;
    twin.setAttribute("aria-hidden", "true");
    track.appendChild(twin);
  }

  function attachResizeHandler(): void {
    if (resizeAttached) return;
    resizeAttached = true;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        for (const row of rows) {
          rebuildRow(row);
        }
      }, 200);
    });
  }

  async function load(root: HTMLElement): Promise<void> {
    // Shared fetch (submissions-client): the marquee and the rail share ONE
    // request per page load; invalidated after a successful POST.
    //
    // Adversarial-review fix: same stale-response race the rail had — a
    // slow initial GET resolving after a post-submit re-sync would repaint
    // the marquee with the pre-post (demo/empty) state. Monotonic
    // generation: only the latest load applies.
    const generation = ++loadGeneration;
    const data = await loadSubmissions();
    if (!data || generation !== loadGeneration) return;

    const real = collectRealWishes(data);
    if (real.length === 0) {
      root.dataset.state = "empty";
      const demo = readDemoWishes(root);
      rebuild(root, [ctaItem(), ...demo.map((text) => wishItem(text))]);
    } else {
      root.dataset.state = "real";
      rebuild(root, real.slice(0, MAX_UNIT_ITEMS).map((text) => wishItem(text)));
    }
  }

  function init(): void {
    const root = document.querySelector<HTMLElement>("[data-wish-marquee]");
    if (!root) return;

    void load(root); // every visitor fetches: empty wall → demo + CTA, real wishes → real-only
    // Post-submit resync (add-story-flow spec): after a successful POST
    // the marquee swaps per its display states without a page reload.
    window.addEventListener("submissions:posted", () => {
      void load(root);
    });
  }

  init();
</script>
