---
export interface Story {
  id: string;
  type: "image";
  src: string;
  duration?: number;
}

export interface StoryViewerProps {
  stories: Story[];
  username?: string;
  avatar?: string;
  timestamp?: string;
  className?: string;
  mock?: boolean;
}

// Attribution props (story-rail-attribution D4): `username` is the switch.
// With it, the tile label span, the tile's accessible label and the modal's
// author header all name the poster — `avatar` and `timestamp` are OPTIONAL
// extras, because a real guest tile has a first name and a submission time
// but no avatar. Without it the tile is attribution-free: filler label span,
// neutral "View guest story" label, "Guest story" modal placeholder. Mocks
// take that path by design; real tiles take it only when firstName is null.
const { stories, username, avatar, timestamp, className = "", mock = false } = Astro.props as StoryViewerProps;

// Dimensions for 9:16 aspect ratio (minimized)
const WIDTH = 112;
const HEIGHT = 200;

const lastStory = stories[stories.length - 1];

// AVIF sidecars exist only for static /public assets. Guest-submitted photos
// are served from /api/photos/... as WebP/JPEG with no .avif sibling, and a
// <source> that 404s would break the tile instead of falling back.
const isStaticWebp = (src?: string) =>
  !!src && src.startsWith("/") && !src.startsWith("/api/") && src.endsWith(".webp");
---

<story-viewer
  class={`story-viewer ${className}`}
  data-story-viewer
  data-mock={mock ? "" : undefined}
  data-username={username}
  data-label={username ? `View ${username}'s stories` : "View guest story"}
>
  <script is:inline type="application/json" data-stories set:html={JSON.stringify(stories).replace(/</g, "\\u003c")}></script>

  <button
    type="button"
    data-open
    class="relative flex flex-col items-center gap-2 group cursor-pointer bg-transparent border-none outline-none active:scale-[0.97] transition-transform duration-160 ease-out"
    aria-label={username ? `View ${username}'s stories` : "View guest story"}
  >
    <div class={`relative`} style={`width: ${WIDTH}px; height: ${HEIGHT}px;`}>
      <div class="absolute inset-0 rounded-[12px] overflow-hidden bg-[color:var(--memories-frame)] ring-1 ring-[color:var(--memories-frame-ring)]">
          <picture>
            {isStaticWebp(lastStory?.src) && (
              <source data-src={lastStory?.src?.replace(/\.webp$/, ".avif")} type="image/avif" />
            )}
            <img
              data-src={lastStory?.src}
              alt={username ? `${username}'s story` : "Guest story"}
              width="224" height="400"
              class="zoom-cover w-full h-full object-cover"
              decoding="async"
            />
          </picture>
      </div>
    </div>

    {/* The label row always renders so every tile holds the same rail
       geometry: a named tile shows the poster's first name (ellipsised at
       80px), an unnamed tile keeps the transparent filler span. */}
    {username ? (
      <span class="text-xs text-[color:var(--memories-label)] truncate max-w-[80px]">{username}</span>
    ) : (
      <span class="text-xs text-transparent truncate max-w-[80px]" aria-hidden="true">.</span>
    )}
  </button>


  <div
    data-modal
    class="fixed inset-0 z-[9999] bg-black/95 flex items-center justify-center opacity-0 pointer-events-none"
    aria-hidden="true"
  >
    <div
      data-panel
      class="relative w-full h-full max-w-lg mx-auto flex flex-col overflow-hidden bg-black/90"
    >
      <div class="absolute top-0 left-0 right-0 z-20 pt-2 pb-4 bg-gradient-to-b from-black/70 to-transparent">
        <div class="flex gap-1 w-full px-2">
          {stories.map((_, index) => (
            <div
              class="flex-1 h-0.5 bg-white/30 rounded-full overflow-hidden"
              data-progress-item
              data-index={index}
            >
              <div class="h-full bg-white rounded-full w-full" data-progress-bar style="transform: scaleX(0); transform-origin: left;"></div>
            </div>
          ))}
        </div>

        <div class="flex items-center justify-between px-4 mt-3">
          {/* Author block (story-rail-attribution D4): gated on `username`
             alone. A named guest tile has no avatar, so the circle renders
             only when an avatar exists and the timestamp only when one is
             supplied — name + relative time, no invented identity. A
             username-less tile (mocks, and real entries whose firstName is
             null) keeps the neutral placeholder. */}
          {username ? (
            <div class="flex items-center gap-3">
              {avatar && (
                <div class="w-8 h-8 rounded-full overflow-hidden bg-white/10 ring-1 ring-white/10">
                  <picture>
                    {isStaticWebp(avatar) && (
                      <source data-src={avatar?.replace(/\.webp$/, ".avif")} type="image/avif" />
                    )}
                    <img
                      data-src={avatar}
                      alt={username}
                      width="64" height="64"
                      class="w-full h-full object-cover"
                      decoding="async"
                      data-avatar
                    />
                  </picture>
                </div>
              )}
              <div class="flex flex-col">
                <span class="text-white text-sm font-medium" data-username>{username}</span>
                {timestamp && (
                  <span
                    class="text-white/60 text-xs"
                    data-timestamp
                    data-value={timestamp}
                  ></span>
                )}
              </div>
            </div>
          ) : (
            <span class="text-white/60 text-xs" aria-hidden="true">Guest story</span>
          )}

          <div class="flex items-center gap-2">
            <button
              type="button"
              data-close
              class="inline-flex items-center justify-center rounded-md h-10 w-10 text-white hover:bg-white/20 active:scale-[0.97] transition-transform duration-160 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/50 cursor-pointer"
              aria-label="Close"
            >
              <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="m6 6 12 12m0-12-12 12"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div
        class="flex-1 flex items-center justify-center overflow-hidden select-none relative w-full h-full"
        data-stage
      >
        <div class="absolute inset-0 flex items-center justify-center z-10 hidden" data-spinner>
          <svg class="android-spinner" viewBox="0 0 50 50" aria-hidden="true">
            <circle
              class="path"
              cx="25"
              cy="25"
              r="20"
              fill="none"
              stroke-width="4"
            />
          </svg>
        </div>
        <!-- Slides will be injected here -->
      </div>

      <div class="hidden md:flex absolute inset-y-0 left-0 right-0 items-center justify-between pointer-events-none px-4 z-20">
        <button
          type="button"
          data-prev
          class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-white/10 text-white hover:bg-white/20 active:scale-[0.97] transition-transform duration-160 ease-out pointer-events-auto focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/50 cursor-pointer"
          aria-label="Previous story"
        >
          <svg viewBox="0 0 24 24" class="w-6 h-6" aria-hidden="true">
            <path
              fill="currentColor"
              d="m15 6-6 6 6 6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <button
          type="button"
          data-next
          class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-white/10 text-white hover:bg-white/20 active:scale-[0.97] transition-transform duration-160 ease-out pointer-events-auto focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/50 cursor-pointer"
          aria-label="Next story"
        >
          <svg viewBox="0 0 24 24" class="w-6 h-6" aria-hidden="true">
            <path
              fill="currentColor"
              d="m9 6 6 6-6 6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>
    </div>
  </div>
</story-viewer>

<style>
  .story-segment {
    stroke: #ffffff;
    filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.5));
  }

  .story-segment[data-viewed="true"],
  .story-segment[data-viewed="all"] {
    stroke: rgb(148 163 184 / 0.4);
  }

  :global(.android-spinner) {
    animation: rotate 2s linear infinite;
    height: 50px;
    width: 50px;
  }

  :global(.android-spinner) :global(.path) {
    stroke: white;
    stroke-linecap: round;
    animation: dash 1.5s ease-in-out infinite;
  }

  @keyframes rotate {
    100% {
      transform: rotate(360deg);
    }
  }

  @keyframes dash {
    0% {
      stroke-dasharray: 1, 150;
      stroke-dashoffset: 0;
    }
    50% {
      stroke-dasharray: 90, 150;
      stroke-dashoffset: -35;
    }
    100% {
      stroke-dasharray: 90, 150;
      stroke-dashoffset: -124;
    }
  }

  /* Cover zoom is gated on real hover so touch taps never trigger a false grow. */
  :global(.story-viewer .zoom-cover) {
    transition: transform 200ms var(--ease-out-expo);
  }
  @media (hover: hover) and (pointer: fine) {
    :global(.story-viewer [data-open]:hover .zoom-cover) {
      transform: scale(1.1);
    }
  }
</style>

<script>
  // The <story-viewer> custom element lives in its own module — see the header
  // comment in scripts/story-viewer-element.ts for why that matters: Astro
  // emits THIS script only when the component renders, and on a non-empty wall
  // it renders nowhere (D6), while scripts/guest-rail.ts still injects tiles
  // that need the element defined. Importing it here keeps any page that
  // renders a StoryViewer self-sufficient; guest-rail.ts imports it too, Vite
  // dedupes the two into one chunk, and the definition guard makes the double
  // import a no-op.
  import "../scripts/story-viewer-element";
</script>

