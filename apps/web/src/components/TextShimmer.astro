---
interface Props {
  class?: string;
  duration?: number;
  phrases?: string[];
  phraseIntervalMs?: number;
} const { class: className, duration = 2, phrases, phraseIntervalMs = 2000 } = Astro.props;

// Shimmer paint lives on each text layer (not the host) so the crossfade can
// fade the outgoing phrase out: with a single host-level background-clip:text,
// a stacked span's opacity cannot modulate the clipped gradient.
const shimmerLayerClasses = [
  "bg-clip-text text-transparent bg-size-[200%_100%] animate-shimmer",
  // Gradient for Dark Mode (Gray -> White -> Gray)
  "bg-[linear-gradient(110deg,#4b5563,45%,#ffffff,55%,#4b5563)]",
];
---

<text-shimmer
  class:list={[
    "inline-flex relative",
    className
  ]}
  data-phrases={phrases ? JSON.stringify(phrases) : undefined}
  data-phrase-interval-ms={String(phraseIntervalMs)}
>
  <span data-text class:list={shimmerLayerClasses} style={{ animationDuration: `${duration}s` }}><slot /></span>
  <span data-text-out class:list={shimmerLayerClasses} style={{ animationDuration: `${duration}s` }} aria-hidden="true"></span>
</text-shimmer>

<style>
  text-shimmer [data-text-out] {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
</style>

<script is:inline>
  class TextShimmer extends HTMLElement {
    constructor() {
      super();
      this.interval = undefined;
    }

    connectedCallback() {
      const phrasesAttr = this.dataset.phrases;
      if (!phrasesAttr) return;

      let phrases = [];
      try {
        phrases = JSON.parse(phrasesAttr);
      } catch (e) {
        console.error('TextShimmer: Failed to parse phrases', e);
        return;
      }

      if (!phrases.length) return;

      const intervalMs = Number(this.dataset.phraseIntervalMs) || 1000;
      const textEl = this.querySelector('[data-text]');
      const outEl = this.querySelector('[data-text-out]');
      if (!textEl) return;

      let index = 0;
      const CROSSFADE_MS = 150;

      this.interval = window.setInterval(() => {
        index = (index + 1) % phrases.length;

        if (!outEl) {
          textEl.textContent = phrases[index];
          return;
        }

        // Crossfade instead of a hard cut: hand the outgoing phrase to the
        // back layer and blur-fade it out while the incoming phrase fades in.
        outEl.getAnimations().forEach((anim) => anim.cancel());
        outEl.textContent = textEl.textContent;
        outEl.animate(
          [
            { opacity: 1, filter: 'blur(0px)' },
            { opacity: 0, filter: 'blur(2px)' }
          ],
          { duration: CROSSFADE_MS, easing: 'ease-out' }
        ).finished.then(() => {
          outEl.textContent = '';
        }, () => { /* cancelled by a newer crossfade */ });

        textEl.textContent = phrases[index];
        textEl.animate(
          [{ opacity: 0 }, { opacity: 1 }],
          { duration: CROSSFADE_MS, easing: 'ease-out' }
        );
      }, intervalMs);
    }

    disconnectedCallback() {
      if (this.interval) {
        clearInterval(this.interval);
        this.interval = undefined;
      }
    }
  }

  if (!customElements.get('text-shimmer')) {
    customElements.define('text-shimmer', TextShimmer);
  }
</script>
