---
import TextShimmer from "./TextShimmer.astro";
import { shuffleTrail } from "../lib/trail-sequence";
import { LOADING_PHRASES } from "../lib/loading-phrases";

interface Props {
  loadingPhrases?: readonly string[] | string[];
}

const { loadingPhrases = shuffleTrail(LOADING_PHRASES) } = Astro.props;
const phrases = Array.from(loadingPhrases);
---

<div
  id="claim-gate"
  class="claim-surface fixed inset-0 z-45 flex flex-col items-center justify-center select-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="claim-gate-label"
>
  <div id="claim-gate-content" class="w-full max-w-sm px-6 flex flex-col items-center">
    <form
      id="claim-gate-form"
      method="post"
      action="/api/invite/claim"
      class="w-full flex flex-col items-center"
      novalidate
    >
      <!-- Accessible name for modal dialog and native input -->
      <label
        for="claim-gate-input"
        id="claim-gate-label"
        class="sr-only"
      >
        Nama Anda
      </label>

      <div class="claim-input-box relative w-full flex flex-col items-center">
        <!-- Native accessible input behind visual display -->
        <input
          type="text"
          id="claim-gate-input"
          name="displayName"
          class="claim-native-input"
          maxlength="120"
          autocomplete="name"
          spellcheck="false"
          placeholder="Nama Anda"
          required
        />

        <!-- Underline baseline with animated character track -->
        <div class="claim-visual-line relative w-full pb-2 border-b flex items-center justify-center overflow-x-auto overflow-y-hidden cursor-text no-scrollbar" aria-hidden="true">
          <span
            id="claim-gate-placeholder"
            class="claim-placeholder pointer-events-none select-none text-2xl sm:text-3xl font-medium tracking-tight"
          >
            Nama Anda
          </span>
          <div class="claim-char-track inline-flex items-center text-2xl sm:text-3xl font-medium tracking-tight">
          </div>
        </div>
      </div>

      <!-- Action pill container: hidden when empty -->
      <div class="claim-action-container mt-6 flex flex-col items-center">
        <button
          type="submit"
          id="claim-gate-submit"
          class="claim-button"
          tabindex="-1"
          aria-disabled="true"
        >
          Mulai
        </button>
      </div>

      <!-- Inline error / alert notification -->
      <div
        id="claim-gate-error"
        class="hidden mt-4 text-center text-sm"
        role="alert"
      >
        <p id="claim-gate-error-text" class="text-[color:var(--claim-error)] text-pretty"></p>
        <div id="claim-gate-error-actions" class="hidden mt-3 flex items-center justify-center gap-3">
          <button
            type="button"
            id="claim-gate-reload-btn"
            class="claim-sub-button text-xs underline underline-offset-4"
          >
            Muat ulang
          </button>
          <button
            type="button"
            id="claim-gate-continue-btn"
            class="claim-sub-button text-xs underline underline-offset-4"
          >
            Lanjutkan sebagai tamu
          </button>
        </div>
      </div>

      <p id="claim-gate-status" class="sr-only" aria-live="polite"></p>
    </form>
  </div>

  <!-- Loading state shown immediately after clicking "Mulai" -->
  <div
    id="claim-gate-loading"
    class="hidden absolute inset-0 flex flex-col items-center justify-center pointer-events-none select-none"
    aria-hidden="true"
  >
    <div class="flex flex-col items-center">
      <TextShimmer
        class="text-xl font-medium tracking-tight font-[sans-serif]"
        duration={2}
        phrases={phrases}
      >
        {phrases[0]}
      </TextShimmer>
    </div>
  </div>
</div>

<noscript>
  <style>
    #claim-gate {
      display: none !important;
    }
  </style>
</noscript>

<style>
  :root {
    --claim-bg: #0a0a0a;
    --claim-fg: #ededed;
    --claim-muted: #a1a1aa;
    --claim-placeholder: #9ca3af;
    --claim-line: rgba(237, 237, 237, 0.4);
    --claim-cursor: #ededed;
    --claim-error: #f87171;
  }

  @media (prefers-color-scheme: light) {
    :root {
      --claim-bg: #ffffff;
      --claim-fg: #0a0a0a;
      --claim-muted: #71717a;
      --claim-placeholder: #6b7280;
      --claim-line: rgba(10, 10, 10, 0.3);
      --claim-cursor: #0a0a0a;
      --claim-error: #b91c1c;
    }
  }

  :global(.light),
  :global([data-theme="light"]) {
    --claim-bg: #ffffff;
    --claim-fg: #0a0a0a;
    --claim-muted: #71717a;
    --claim-placeholder: #6b7280;
    --claim-line: rgba(10, 10, 10, 0.3);
    --claim-cursor: #0a0a0a;
    --claim-error: #b91c1c;
  }

  #claim-gate {
    background-color: var(--claim-bg);
    color: var(--claim-fg);
    touch-action: manipulation;
    /* 10-second CSS failsafe for unscripted / script-failure visitors */
    animation: claim-failsafe 600ms ease-out 10s forwards;
  }

  @keyframes claim-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  @media (scripting: none) {
    #claim-gate {
      display: none !important;
    }
  }

  .no-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .claim-input-box {
    max-width: 300px;
  }

  @media (min-width: 640px) {
    .claim-input-box {
      max-width: 340px;
    }
  }

  /* Native input covers visual box so taps directly focus it */
  .claim-native-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: text;
    z-index: 2;
    font-size: 16px; /* Prevents iOS auto-zoom on focus */
    text-align: center;
    -webkit-user-select: text;
    user-select: text;
  }

  .claim-visual-line {
    border-bottom: 1px solid var(--claim-line);
    min-height: 2.75rem;
    position: relative;
    z-index: 1;
    justify-content: center;
  }

  .claim-placeholder {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--claim-placeholder);
    opacity: 0.4;
    line-height: 1;
    pointer-events: none;
    transition: opacity 150ms ease, visibility 150ms ease;
  }

  .claim-placeholder[data-hidden="true"] {
    opacity: 0;
    visibility: hidden;
  }
  .claim-char-track {
    white-space: pre;
    color: var(--claim-fg);
    line-height: 1;
  }

  .claim-char-track :global(.claim-char) {
    display: inline-block;
    transform-origin: center bottom;
    animation: char-pop-in 160ms cubic-bezier(0.2, 0, 0, 1) forwards;
  }

  .claim-char-track :global(.claim-char-out) {
    display: inline-block;
    transform-origin: center bottom;
    animation: char-pop-out 140ms ease-in forwards;
  }

  @keyframes char-pop-in {
    from {
      opacity: 0;
      transform: scale(0.35);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes char-pop-out {
    from {
      opacity: 1;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(0.35);
    }
  }

  .claim-char-track :global(.claim-cursor) {
    display: inline-block;
    color: var(--claim-cursor);
    font-weight: 300;
    animation: cursor-blink 1s step-end infinite;
  }

  .claim-char-track :global(.claim-char + .claim-cursor) {
    margin-left: 1px;
  }

  @keyframes cursor-blink {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .claim-action-container {
    height: 3.25rem;
  }

  /* Action button: ghost pill */
  .claim-button {
    padding: 0.625rem 2.25rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--claim-fg);
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    pointer-events: none;
    transition: opacity 250ms ease, transform 250ms ease, visibility 250ms ease, background-color 160ms ease, color 160ms ease;
  }

  @media (min-width: 640px) {
    .claim-button {
      font-size: 1.25rem;
      padding: 0.75rem 2.5rem;
    }
  }

  .claim-button[data-visible="true"] {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .claim-button:hover:not(:disabled) {
    background: color-mix(in srgb, var(--claim-fg) 10%, transparent);
  }

  .claim-button:active:not(:disabled) {
    background: color-mix(in srgb, var(--claim-fg) 15%, transparent);
  }

  .claim-button:disabled {
    cursor: default;
    opacity: 0.55;
  }

  .claim-button:focus-visible {
    outline: 2px solid var(--claim-fg);
    outline-offset: 4px;
  }

  .claim-sub-button {
    background: transparent;
    border: none;
    color: var(--claim-muted);
    cursor: pointer;
    padding: 0.25rem 0.5rem;
  }

  .claim-sub-button:hover {
    color: var(--claim-fg);
  }

  @media (prefers-reduced-motion: reduce) {
    .claim-char-track :global(.claim-char) {
      animation: none !important;
      transform: none !important;
    }
    .claim-char-track :global(.claim-char-out) {
      animation: none !important;
      display: none !important;
    }
    .claim-button {
      transition: none !important;
    }
    .claim-placeholder {
      transition: none !important;
    }
  }

  #claim-gate-loading {
    font-family: sans-serif;
  }

  #claim-gate-loading :global(text-shimmer [data-text]),
  #claim-gate-loading :global(text-shimmer [data-text-out]) {
    background-image: linear-gradient(110deg, #4b5563, 45%, #ffffff, 55%, #4b5563);
    font-family: sans-serif;
  }

  @media (prefers-color-scheme: light) {
    #claim-gate-loading :global(text-shimmer [data-text]),
    #claim-gate-loading :global(text-shimmer [data-text-out]) {
      background-image: linear-gradient(110deg, #a8a29e, 45%, #292524, 55%, #a8a29e);
    }
  }

  :global(.light) #claim-gate-loading :global(text-shimmer [data-text]),
  :global(.light) #claim-gate-loading :global(text-shimmer [data-text-out]),
  :global([data-theme="light"]) #claim-gate-loading :global(text-shimmer [data-text]),
  :global([data-theme="light"]) #claim-gate-loading :global(text-shimmer [data-text-out]) {
    background-image: linear-gradient(110deg, #a8a29e, 45%, #292524, 55%, #a8a29e);
  }
</style>

<script is:inline>
  (function () {
    var gate = document.getElementById('claim-gate');
    if (!gate) return;

    var form = document.getElementById('claim-gate-form');
    var input = document.getElementById('claim-gate-input');
    var charTrack = gate.querySelector('.claim-char-track');
    var submitBtn = document.getElementById('claim-gate-submit');
    var errorContainer = document.getElementById('claim-gate-error');
    var errorText = document.getElementById('claim-gate-error-text');
    var errorActions = document.getElementById('claim-gate-error-actions');
    var reloadBtn = document.getElementById('claim-gate-reload-btn');
    var continueBtn = document.getElementById('claim-gate-continue-btn');
    var statusEl = document.getElementById('claim-gate-status');

    if (!form || !input || !charTrack || !submitBtn) return;

    var contentEl = document.getElementById('claim-gate-content');
    var loadingEl = document.getElementById('claim-gate-loading');
    var shimmerEl = loadingEl ? loadingEl.querySelector('text-shimmer') : null;
    var CLAIM_MIN_DWELL_MS = 1000;

    function restoreForm() {
      if (contentEl && loadingEl) {
        loadingEl.classList.add('hidden');
        loadingEl.setAttribute('aria-hidden', 'true');
        contentEl.classList.remove('hidden');
      }
    }

    // Cancel the 10s CSS failsafe only after confirming all required elements are present
    gate.style.animation = 'none';
    if (typeof gate.getAnimations === 'function') {
      gate.getAnimations().forEach(function (anim) {
        anim.cancel();
      });
    }

    var visualLine = gate.querySelector('.claim-visual-line');
    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var isSubmitting = false;
    var isDismissed = false;
    var isAmbiguousError = false;
    var isFocused = false;
    var previousValue = '';
    var deleteTimeout = null;

    // Outcome UNKNOWN — moved verbatim from RsvpSection.astro:472-473.
    // Behind the documented Caddy deployment a process death or a connection
    // reset between the committed INSERT and the response write surfaces as
    // a 502/504 synthesised by the PROXY, never as a 503 from the app.
    // That is precisely the shape the accepted residual risk takes in production,
    // so matching >= 500 copy prevents blind retries from minting duplicate
    // member rows out of scarce quota while offering reload and guest continue paths.
    var AMBIGUOUS_CLAIM_COPY =
      "Something went wrong and your spot may already be claimed. Please don't keep retrying — reload the page, and if this form is still here, let us know and we'll sort it out.";

    function showError(message, showActions, isAmbiguous) {
      isAmbiguousError = Boolean(isAmbiguous);
      if (!errorContainer || !errorText) return;
      if (!message) {
        errorContainer.classList.add('hidden');
        errorText.textContent = '';
        if (errorActions) errorActions.classList.add('hidden');
        return;
      }
      errorText.textContent = message;
      errorContainer.classList.remove('hidden');
      if (errorActions) {
        if (showActions) {
          errorActions.classList.remove('hidden');
        } else {
          errorActions.classList.add('hidden');
        }
      }
    }

    function syncVisualTrack(animLastChar, deletedChar) {
      if (deleteTimeout) {
        clearTimeout(deleteTimeout);
        deleteTimeout = null;
      }
      var val = input.value;
      var selStart = input.selectionStart != null ? input.selectionStart : val.length;

      var placeholderEl = gate.querySelector('.claim-placeholder');
      if (placeholderEl) {
        if (val.length === 0 && !isFocused) {
          placeholderEl.removeAttribute('data-hidden');
        } else {
          placeholderEl.setAttribute('data-hidden', 'true');
        }
      }

      // Render character spans with cursor at selectionStart (only when focused)
      var chars = val.split('');
      var frag = document.createDocumentFragment();

      for (var i = 0; i < chars.length; i++) {
        if (i === selStart && isFocused) {
          var cursorMid = document.createElement('span');
          cursorMid.className = 'claim-cursor';
          cursorMid.setAttribute('aria-hidden', 'true');
          cursorMid.textContent = '|';
          frag.appendChild(cursorMid);
        }
        var span = document.createElement('span');
        span.className = 'claim-char';
        span.textContent = chars[i];
        if (!animLastChar || i !== chars.length - 1 || reducedMotion) {
          span.style.animation = 'none';
        }
        frag.appendChild(span);
      }

      if (deletedChar && !reducedMotion) {
        var outSpan = document.createElement('span');
        outSpan.className = 'claim-char-out';
        outSpan.textContent = deletedChar;
        frag.appendChild(outSpan);
      }

      if (selStart >= chars.length && isFocused) {
        var cursorEnd = document.createElement('span');
        cursorEnd.className = 'claim-cursor';
        cursorEnd.setAttribute('aria-hidden', 'true');
        cursorEnd.textContent = '|';
        frag.appendChild(cursorEnd);
      }

      charTrack.innerHTML = '';
      charTrack.appendChild(frag);

      // Keep active cursor visible in scrollable track
      if (visualLine) {
        if (charTrack.scrollWidth > visualLine.clientWidth) {
          visualLine.style.justifyContent = 'flex-start';
          var activeCursor = charTrack.querySelector('.claim-cursor');
          if (activeCursor) {
            var offset = activeCursor.offsetLeft;
            var maxScroll = visualLine.scrollWidth - visualLine.clientWidth;
            visualLine.scrollLeft = Math.max(0, Math.min(offset - visualLine.clientWidth + 24, maxScroll));
          }
        } else {
          visualLine.style.justifyContent = 'center';
          visualLine.scrollLeft = 0;
        }
      }
      if (deletedChar && !reducedMotion) {
        deleteTimeout = setTimeout(function () {
          if (input.value === val) {
            syncVisualTrack(false);
          }
        }, 130);
      }

      // Mulai button threshold: trimmed length >= 1
      var trimmed = val.trim();
      var isValidLength = trimmed.length >= 1;
      if (isValidLength) {
        submitBtn.setAttribute('data-visible', 'true');
        submitBtn.removeAttribute('tabindex');
        submitBtn.removeAttribute('aria-disabled');
      } else {
        submitBtn.removeAttribute('data-visible');
        submitBtn.setAttribute('tabindex', '-1');
        submitBtn.setAttribute('aria-disabled', 'true');
      }

      previousValue = val;
    }

    // Input event handler
    input.addEventListener('input', function () {
      isFocused = true;
      if (!isAmbiguousError) showError('', false, false);
      var current = input.value;
      var isSingleAppend = current.length === previousValue.length + 1 && current.startsWith(previousValue);
      var isSingleDelete = current.length === previousValue.length - 1 && previousValue.startsWith(current);
      var deletedChar = isSingleDelete ? previousValue.charAt(previousValue.length - 1) : null;
      syncVisualTrack(isSingleAppend, deletedChar);
    });

    // Caret navigation synchronization
    input.addEventListener('keyup', function (e) {
      isFocused = true;
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight' || e.key === 'Home' || e.key === 'End') {
        syncVisualTrack(false);
      }
    });

    input.addEventListener('focus', function () {
      isFocused = true;
      syncVisualTrack(false);
    });

    input.addEventListener('blur', function () {
      isFocused = false;
      syncVisualTrack(false);
    });

    input.addEventListener('click', function () {
      isFocused = true;
      syncVisualTrack(false);
    });
    // Enter key submits form
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        var trimmed = input.value.trim();
        if (trimmed.length >= 1 && !isSubmitting && !isDismissed) {
          submitClaim();
        }
      }
    });

    function dismissGateSmoothly(claimedName) {
      isDismissed = true;
      if (reducedMotion) {
        if (claimedName) {
          var greetingEl = document.getElementById('gate-greeting');
          if (greetingEl) greetingEl.textContent = claimedName;
          window.dispatchEvent(
            new CustomEvent('claim:success', {
              detail: { displayName: claimedName },
            })
          );
        }
        gate.remove();
        return;
      }

      // Fade out claim gate
      gate.style.transition = 'opacity 400ms ease, transform 400ms ease';
      gate.style.opacity = '0';
      gate.style.transform = 'scale(0.98)';
      gate.style.pointerEvents = 'none';

      if (claimedName) {
        // Dynamically update WelcomeGate greeting
        var greetingEl = document.getElementById('gate-greeting');
        if (greetingEl) {
          greetingEl.textContent = claimedName;
        }

        // Dispatch claim:success identity event on window
        window.dispatchEvent(
          new CustomEvent('claim:success', {
            detail: { displayName: claimedName },
          })
        );
      }

      setTimeout(function () {
        gate.remove();
      }, 420);
    }

    async function submitClaim() {
      if (isSubmitting || isDismissed) return;
      var displayName = input.value.trim();
      if (displayName.length < 1) return;
      isSubmitting = true;
      submitBtn.disabled = true;
      submitBtn.setAttribute('aria-busy', 'true');
      showError('', false);
      if (statusEl) statusEl.textContent = 'Menyimpan nama Anda…';

      // Dismiss mobile virtual keyboard
      input.blur();

      // Immediately show loading phrases so user gets instant visual confirmation
      if (contentEl && loadingEl) {
        contentEl.classList.add('hidden');
        loadingEl.classList.remove('hidden');
        loadingEl.removeAttribute('aria-hidden');
        if (shimmerEl && typeof shimmerEl.restart === 'function') {
          shimmerEl.restart();
        }
      }

      var startTime = performance.now();

      try {
        var res = await fetch('/api/invite/claim', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          cache: 'no-store',
          body: JSON.stringify({ displayName: displayName }),
        });

        var body = null;
        try {
          body = await res.json();
        } catch (_) {}

        if (res.status === 201 || res.status === 200) {
          // Success: smooth handoff to welcome gate with claimed name
          var finalName = (body && body.displayName) || displayName;
          var elapsed = performance.now() - startTime;
          var minDwell = reducedMotion ? 0 : CLAIM_MIN_DWELL_MS;
          var remaining = Math.max(0, minDwell - elapsed);
          setTimeout(function () {
            dismissGateSmoothly(finalName);
          }, remaining);
          return;
        }

        // On errors: restore the form so the error message and retry inputs are visible
        restoreForm();

        if (res.status === 409) {
          var code = body && body.error;
          if (code === 'group_full') {
            isDismissed = true;
            // Concurrency race: last slot taken. Notify and hand off to welcome gate under group identity
            showError('Kuota undangan telah penuh. Membuka undangan…', false, false);
            window.dispatchEvent(new CustomEvent('claim:capacity'));
            setTimeout(function () {
              dismissGateSmoothly(null); // Keep server-rendered group name
            }, 1200);
            return;
          }
          if (code === 'not_a_group') {
            // Stale identity: dismiss to welcome gate without updating name
            dismissGateSmoothly(null);
            return;
          }
        }

        if (res.status === 404) {
          // Stale / not found cookie: dismiss to welcome gate without trapping
          dismissGateSmoothly(null);
          return;
        }

        if (res.status === 403) {
          // Cross-origin failure: retryable
          showError('Tidak dapat memproses permintaan (origin error). Silakan coba lagi.', true, false);
          return;
        }

        if (res.status === 400) {
          var err = body && body.error;
          if (err === 'display_name_too_long') {
            showError('Nama terlalu panjang (maksimal 120 karakter).', false);
          } else {
            showError('Silakan masukkan nama yang valid.', false, false);
          }
          return;
        }

        if (res.status >= 500) {
          showError(AMBIGUOUS_CLAIM_COPY, true, true);
          return;
        }

        // Other unexpected errors
        showError('Terjadi kesalahan. Silakan coba lagi.', false);
      } catch (err) {
        // Network drop: treat as ambiguous outcome
        restoreForm();
        showError(AMBIGUOUS_CLAIM_COPY, true, true);
      } finally {
        if (!isDismissed) {
          isSubmitting = false;
          submitBtn.disabled = false;
          submitBtn.removeAttribute('aria-busy');
          if (statusEl) statusEl.textContent = '';
        }
      }
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      submitClaim();
    });

    if (reloadBtn) {
      reloadBtn.addEventListener('click', function () {
        window.location.reload();
      });
    }

    if (continueBtn) {
      continueBtn.addEventListener('click', function () {
        dismissGateSmoothly(null);
      });
    }

    // Focus containment loop for Tab key inside modal claim gate
    gate.addEventListener('keydown', function (e) {
      if (e.key === 'Tab') {
        var focusable = Array.prototype.filter.call(
          gate.querySelectorAll('button, input'),
          function (el) {
            return !el.disabled && el.tabIndex !== -1 && el.getClientRects().length > 0;
          }
        );
        if (focusable.length === 0) return;
        var first = focusable[0];
        var last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    // No autofocus on load — cursor starts unfocused
    syncVisualTrack(false);
  })();
</script>
