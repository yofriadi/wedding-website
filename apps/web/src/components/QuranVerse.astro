---
---

<section class="relative min-h-screen min-h-lvh bg-[color:var(--verse-bg)] flex flex-col items-center justify-center py-24 px-6 overflow-hidden" id="verse-container">
  <!-- Ambient Background Effect -->
  <div class="absolute inset-0 z-0 pointer-events-none verse-ambient">
    <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_50%,var(--verse-ambient-core),transparent_70%)] animate-pulse-slow"></div>
    <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-[color:var(--verse-ambient-blob)] rounded-full blur-3xl animate-float"></div>
  </div>

  <div class="max-w-3xl mx-auto text-center space-y-10 md:space-y-12 relative z-10">
    
    <!-- Arabic Text (BlurReveal — staggered word-by-word) -->
    <div class="arabic-container text-center w-full">
      <p id="arabic-verse" class="text-[clamp(1.9rem,3.6vw,3.4rem)] leading-[1.8] font-serif text-[color:var(--verse-arabic)] text-shadow-glow text-center w-full" dir="rtl" lang="ar">
        وَمِنْ اٰيٰتِهٖٓ اَنْ خَلَقَ لَكُمْ مِّنْ اَنْفُسِكُمْ اَزْوَاجًا لِّتَسْكُنُوْٓا اِلَيْهَا وَجَعَلَ بَيْنَكُمْ مَّوَدَّةً وَّرَحْمَةً ۗاِنَّ فِيْ ذٰلِكَ لَاٰيٰتٍ لِّقَوْمٍ يَّتَفَكَّرُوْنَ
      </p>
    </div>
    <!-- Bahasa Indonesia Translation (BlurReveal — staggered phrase-by-phrase) -->
    <div class="translation-container">
      <p class="translation-text text-[clamp(0.95rem,1.5vw,1.15rem)] leading-loose text-[color:var(--verse-translation)] font-medium italic tracking-wide text-pretty">
        Dan di antara tanda-tanda (kebesaran)-Nya ialah Dia menciptakan pasangan-pasangan untukmu dari jenismu sendiri, agar kamu cenderung dan merasa tenteram kepadanya, dan Dia menjadikan di antaramu rasa kasih dan sayang. Sungguh, pada yang demikian itu benar-benar terdapat tanda-tanda (kebesaran Allah) bagi kaum yang berpikir.
      </p>
    </div>
    
    <!-- Reference (intentionally delayed for dramatic effect) -->
    <div class="reference-container">
      <p class="reference-text text-xs sm:text-sm tracking-[0.45em] text-[color:var(--verse-reference)] uppercase font-medium">
        QS. Ar-Ruum 30:21
      </p>
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&display=swap');

  .font-serif {
    font-family: 'Amiri', serif;
  }

  /* Theme tokens (WeddingFAQ/SlideToConfirm precedent): dark is the authored
     default, the light scheme inverts the same black/white pair via the OS
     preference. The section paints --verse-bg itself because body/main stay
     bg-neutral-950 in either scheme. */
  #verse-container {
    --verse-bg: #0a0a0a; /* neutral-950 */
    --verse-arabic: rgba(255, 251, 235, 0.9); /* amber-50/90 */
    --verse-translation: #a3a3a3; /* neutral-400 */
    --verse-reference: #ffffff;
    --verse-text-shadow: rgba(251, 191, 36, 0.15); /* amber-500 glow */
    --verse-ambient-core: rgba(120, 60, 0, 0.08);
    --verse-ambient-blob: rgba(146, 64, 14, 0.1); /* amber-900/10 */
  }

  @media (prefers-color-scheme: light) {
    #verse-container {
      --verse-bg: #ffffff;
      --verse-arabic: #0a0a0a; /* neutral-950 */
      --verse-translation: #525252; /* neutral-600: holds contrast on white */
      --verse-reference: #0a0a0a;
      --verse-text-shadow: rgba(146, 64, 14, 0.14); /* warm, not neon, on white */
    }

    /* The amber haze that reads as depth on black turns into an orange wash
       on white, so the whole ambient layer is dropped rather than re-tinted.
       display: none also stops float/pulse-slow from running for nothing. */
    .verse-ambient {
      display: none;
    }
  }

  .text-shadow-glow {
    text-shadow: 0 0 20px var(--verse-text-shadow);
  }

  /*
   * BlurReveal — faithful port of badtzx0/blur-reveal (21st.dev).
   * initial: opacity 0, blur(10px), y 20%
   * animate: opacity 1, blur(0),  y 0%
   * duration: 1s, ease: [0.25, 0.1, 0.25, 1] (framer-motion default easeOut)
   * Each segment staggers via its own `transition-delay`.
   */
  :global(.blur-reveal) {
    display: inline-block;
    opacity: 0;
    filter: blur(10px);
    transform: translateY(20%);
    will-change: opacity, filter, transform;
    transition:
      opacity var(--blur-reveal-duration, 0.5s) var(--ease-blur-reveal),
      filter var(--blur-reveal-duration, 0.5s) var(--ease-blur-reveal),
      transform var(--blur-reveal-duration, 0.5s) var(--ease-blur-reveal);
    transition-delay: var(--blur-reveal-delay, 0ms);
  }
  :global(.reference-text.blur-reveal) {
    transition:
      opacity 1.4s var(--ease-out-expo),
      filter 1.4s var(--ease-out-expo),
      transform 1.4s var(--ease-out-expo);
    transition-delay: var(--blur-reveal-delay, 0ms);
  }
  /* When applied to block-level elements, keep them block */
  :global(p.blur-reveal),
  :global(div.blur-reveal) {
    display: block;
  }

  :global(.in-view) :global(.blur-reveal) {
    opacity: 1;
    filter: blur(0px);
    transform: translateY(0%);
    /* The hint did its job during the reveal; release the compositor layers */
    /* (D10) so ~30 word spans don't hold them for the rest of the session. */
    will-change: auto;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-20px, -20px); }
  }
  
  @keyframes pulse-slow {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 0.8; }
  }

  .animate-float { animation: float 10s ease-in-out infinite; }
  .animate-pulse-slow { animation: pulse-slow 8s ease-in-out infinite; }

  /* Reduced motion: instant/gentle appearance without blur computation */
  @media (prefers-reduced-motion: reduce) {
    :global(.blur-reveal) {
      transform: none !important;
      filter: none !important;
      opacity: 1 !important;
      transition: opacity 0.2s ease !important;
      transition-delay: 0ms !important;
    }
    .animate-float,
    .animate-pulse-slow {
      animation: none !important;
    }
  }
</style>

<script>
  function initVerseObserver() {
    const section = document.getElementById('verse-container');
    const arabicP = document.getElementById('arabic-verse');
    const translationP = document.querySelector<HTMLElement>('.translation-text');
    const referenceP = document.querySelector<HTMLElement>('.reference-text');
    
    if (!section || !arabicP) return;

    // Timing constants (ms)
    const WORD_STAGGER = 50;         // Stagger per Arabic word
    const TRANSLATION_DURATION = 500; // Duration for translation to reveal
    const DRAMATIC_PAUSE = 750;       // Dramatic breath after translation settles before citation emerges
    let delay = 0;

    // 1. Arabic verse — split into words, each a BlurReveal segment
    if (!arabicP.dataset.split) {
      const text = arabicP.textContent?.trim() || '';
      const words = text.split(/\s+/).filter(Boolean);
      
      arabicP.innerHTML = words.map((word) => {
        const d = delay;
        delay += WORD_STAGGER;
        return `<span class="blur-reveal mx-[0.08em]" style="--blur-reveal-delay: ${d}ms;">${word}</span>`;
      }).join(' ');
      
      arabicP.dataset.split = 'true';
    } else {
      // Already split — recover the accumulated delay from the DOM
      const wordCount = arabicP.querySelectorAll('.blur-reveal').length;
      delay = wordCount * WORD_STAGGER;
    }

    // 2. Translation — single BlurReveal unit (inline-block chunks break text wrapping)
    if (translationP && !translationP.dataset.split) {
      translationP.classList.add('blur-reveal');
      translationP.style.setProperty('--blur-reveal-delay', `${delay}ms`);
      translationP.dataset.split = 'true';
    }
    // Allow the full translation transition to complete before counting the pause
    delay += TRANSLATION_DURATION;

    // 3. Reference — QS Ar Ruum, intentionally delayed and slowed for dramatic effect
    if (referenceP && !referenceP.dataset.split) {
      delay += DRAMATIC_PAUSE;
      referenceP.classList.add('blur-reveal');
      referenceP.style.setProperty('--blur-reveal-delay', `${delay}ms`);
      referenceP.dataset.split = 'true';
    }
    // Intersection Observer
    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          section.classList.add('in-view');
          obs.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.25,
      rootMargin: "0px 0px -40px 0px"
    });

    observer.observe(section);
  }

  document.addEventListener('astro:page-load', initVerseObserver);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVerseObserver);
  } else {
    initVerseObserver();
  }
</script>
