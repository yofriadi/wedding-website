---

<section class="relative min-h-[80dvh] bg-neutral-950 flex flex-col items-center justify-center py-24 px-6 overflow-hidden" id="verse-container">
  <!-- Ambient Background Effect -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_50%,rgba(120,60,0,0.08),transparent_70%)] animate-pulse-slow"></div>
    <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-amber-900/10 rounded-full blur-3xl animate-float"></div>
  </div>

  <div class="max-w-3xl mx-auto text-center space-y-12 relative z-10">
    
    <!-- Arabic Text -->
    <div class="stagger-container text-center w-full">
      <p class="text-[clamp(1.9rem,3.6vw,3.4rem)] leading-[1.75] font-serif text-amber-50/90 text-shadow-glow text-center w-full" dir="rtl" lang="ar">
        وَمِنْ اٰيٰتِهٖٓ اَنْ خَلَقَ لَكُمْ مِّنْ اَنْفُسِكُمْ اَزْوَاجًا لِّتَسْكُنُوْٓا اِلَيْهَا وَجَعَلَ بَيْنَكُمْ مَّوَدَّةً وَّرَحْمَةً ۗاِنَّ فِيْ ذٰلِكَ لَاٰيٰتٍ لِّقَوْمٍ يَّتَفَكَّرُوْنَ
      </p>
    </div>
    
    <!-- Decorative Divider -->
    <div class="reveal-simple opacity-0 translate-y-8 transition-[transform,opacity] duration-1000 ease-out delay-[500ms]">
      <div class="w-20 h-px bg-gradient-to-r from-transparent via-amber-800/50 to-transparent mx-auto"></div>
    </div>

    <!-- Translation -->
    <div class="stagger-container">
      <p class="text-[clamp(0.95rem,1.5vw,1.15rem)] leading-loose text-neutral-400 font-light italic tracking-wide text-pretty">
        Dan di antara tanda-tanda (kebesaran)-Nya ialah Dia menciptakan pasangan-pasangan untukmu dari jenismu sendiri, agar kamu cenderung dan merasa tenteram kepadanya, dan Dia menjadikan di antaramu rasa kasih dan sayang. Sungguh, pada yang demikian itu benar-benar terdapat tanda-tanda (kebesaran Allah) bagi kaum yang berpikir.
      </p>
    </div>
    
    <!-- Reference -->
    <div class="reveal-simple opacity-0 translate-y-8 transition-[transform,opacity] duration-1000 ease-out delay-[1000ms]">
      <p class="text-xs tracking-[0.4em] text-amber-500/60 uppercase font-medium">
        QS. Ar-Ruum 30:21
      </p>
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&display=swap');

  .font-serif {
    font-family: 'Amiri', serif;
  }

  .text-shadow-glow {
    text-shadow: 0 0 20px rgba(251, 191, 36, 0.15);
  }

  /* Word Animation Base Styles */
  :global(.word-span) {
    display: inline-block;
    opacity: 0;
    transform: translateY(30px);
    transition: transform 1.5s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 1.5s cubic-bezier(0.2, 0.8, 0.2, 1);
    white-space: pre-wrap;
  }

  /* Triggered State */
  :global(.in-view) :global(.word-span) {
    opacity: 1;
    transform: translateY(0);
  }

  /* Simple Reveal Elements */
  :global(.in-view) .reveal-simple {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-20px, -20px); }
  }
  
  @keyframes pulse-slow {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 0.8; }
  }

  .animate-float { animation: float 10s ease-in-out infinite; }
  .animate-pulse-slow { animation: pulse-slow 8s ease-in-out infinite; }
</style>

<script>
  function initObserver() {
    const section = document.getElementById('verse-container');
    const staggerContainers = document.querySelectorAll('.stagger-container p');
    
    if (!section) return;

    // 1. Split text into words
    staggerContainers.forEach(container => {
      const text = container.textContent?.trim() || '';
      // Split by space
      const words = text.split(/\s+/);
      
      container.innerHTML = words.map((word, index) => {
        // Add transition delay based on index
        // For RTL (Arabic), we might want to reverse flow, but index-based stagger 
        // usually looks fine as "appearing from start of sentence".
        // To strictly follow RTL reading direction for visual reveal:
        // Arabic is RTL, so first word in DOM is visually rightmost.
        // So simple index stagger works perfectly (reveals Right -> Left).
        
        // Accelerating curve: Start slow, end fast
        const delay = 200 + (Math.pow(index, 0.7) * 120); 
        // Added mx-1 for better word spacing since inline-block can collapse natural spaces
        return `<span class="word-span mx-[0.15em]" style="transition-delay: ${delay}ms">${word}</span>`;
      }).join('');
    });

    // 2. Intersection Observer
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          section.classList.add('in-view');
        }
      });
    }, {
      threshold: 0.3, 
      rootMargin: "0px"
    });

    observer.observe(section);
  }

  document.addEventListener('astro:page-load', initObserver);
  document.addEventListener('DOMContentLoaded', initObserver);
</script>
