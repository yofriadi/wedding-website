---
import { existsSync } from "node:fs";
import TextShimmer from "./TextShimmer.astro";
import DotPattern from "./DotPattern.astro";

interface Props {
  displayName?: string | null;
}

const { displayName = null } = Astro.props;

// Couple-supplied gate background slot. AVIF is preferred in the markup,
// with WebP retained as the compatibility fallback. The existence check uses
// the AVIF variant so the gate only renders when the local asset is deployed.
const GATE_BG_SRC = "/gate/gate-bg";
const GATE_BG_AVIF = `${GATE_BG_SRC}.avif`;
const GATE_BG_WEBP = `${GATE_BG_SRC}.webp`;

function gateBgAssetExists(src: string) {
  // Dev: this component lives under src/components (public/ is ../../public).
  // Build: compiled modules sit two levels under dist/ and public assets are
  // bundled into dist/client — presence there reflects what the adapter serves.
  const candidates = [
    new URL(`../../public${src}`, import.meta.url),
    new URL(`../../client${src}`, import.meta.url),
  ];
  return candidates.some((url) => existsSync(url));
}

const hasGateBg = gateBgAssetExists(GATE_BG_AVIF);
---

<!--
  Welcome gate: SSR'd between loader and hero. Stacked below #loading-screen
  (z-50) so the loader fade IS the black->bright transition, above all page
  content. The greeting is rendered server-side, verbatim (auto-escaped).
-->
<div id="welcome-gate" class="gate-surface fixed inset-0 z-40">
  <div class="absolute inset-0" aria-hidden="true">
    {
      hasGateBg && (
        <picture>
          <source src={GATE_BG_AVIF} type="image/avif" />
          <source src={GATE_BG_WEBP} type="image/webp" />
          <img
            src={GATE_BG_WEBP}
            alt=""
            class="block h-full w-full object-cover"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      )
    }
  </div>

  {
    !hasGateBg && (
      <DotPattern class="h-full w-full text-neutral-400/40" />
    )
  }

  <!-- Audio notice: top edge opposite of swipe prompt -->
  <div class="absolute inset-x-0 top-12 flex justify-center px-6 md:top-16">
    <p class="gate-audio-hint flex items-center gap-1.5 text-xs font-normal tracking-wider opacity-75">
      <span>Music will play upon opening</span>
    </p>
  </div>

  <!-- Greeting: invitee's name styled with Aceternity shooting-stars gradient:
       sans-serif, tight tracking, medium weight.
       Dark theme: grey to white. Light theme: grey to black.
       Anonymous visitors render the element empty (spec: no placeholder). -->
  <div class="relative flex h-full items-center justify-center px-6">
    <div
      id="gate-greeting"
      class="gate-guest-name max-w-5xl text-balance text-center text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl md:leading-none bg-clip-text text-transparent"
    >
      {displayName}
    </div>
  </div>

  <div class="absolute inset-x-0 bottom-24 flex justify-center md:bottom-28">
    <TextShimmer
      class="text-xl font-medium tracking-tight"
      duration={2}
    >
      Swipe up to open
    </TextShimmer>
  </div>
</div>

<!--
  Safari has not shipped the `scripting` media feature, so the @media rule
  below alone leaves the gate rendered for no-JS Safari guests (and its
  CSS `touch-action: none` would deaden the viewport until the failsafe).
  This <noscript> style hides the gate whenever scripting is off, on every
  browser, with zero cost for JS users. Composes with the failsafe.
-->
<noscript>
  <style>
    #welcome-gate {
      display: none;
    }
  </style>
</noscript>


<style>
  #welcome-gate {
    /* The gesture owns the whole surface while armed: no scroll chaining or
       iOS rubber-band may leak through to the page behind. */
    touch-action: none;
    overscroll-behavior: none;
    user-select: none;
    -webkit-user-select: none;
    /* Transform-only reveal: keep the exit on the compositor. */
    will-change: transform;
    /* Failsafe (D6): if the inline gesture script never arms, the gate must
       not trap the page — fade it out after a bounded delay. The script
       cancels this animation the moment it arms. 15s is margin over the
       loader's 8s ceiling plus its 300ms fade and the commit choreography —
       the 25s value existed only to outlast the retired below-fold media
       gate. */
    animation: gate-failsafe 600ms ease-out 15s forwards;
  }

  @keyframes gate-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  /* No scripting, no gate: the homepage stays fully usable. */
  @media (scripting: none) {
    #welcome-gate {
      display: none;
    }
  }

  /* Device theme, Vercel style: near-black in dark mode, white in light.
     Pure CSS so it live-follows an OS theme flip; the surface variables sit
     on .gate-surface so a couple-supplied background image above could still
     override the paint. */
  :root {
    --gate-bg: #0a0a0a;            /* dark fallback (neutral-950) */
    --gate-fg: #ededed;            /* Vercel foreground on black */
    --gate-dots: #3f3f46;          /* neutral-700 */
    --gate-hint: #a1a1aa;          /* neutral-400 */
    --gate-name-gradient: linear-gradient(to bottom, #262626 0%, #ffffff 50%, #ffffff 100%);
  }

  @media (prefers-color-scheme: light) {
    :root {
      --gate-bg: #ffffff;
      --gate-fg: #0a0a0a;
      --gate-dots: #d4d4d4;          /* neutral-300 */
      --gate-hint: #71717a;          /* neutral-500 */
      --gate-name-gradient: linear-gradient(to bottom, #9ca3af 0%, #000000 75%, #000000 100%);
    }
  }

  :global(.light),
  :global([data-theme="light"]) {
    --gate-bg: #ffffff;
    --gate-fg: #0a0a0a;
    --gate-dots: #d4d4d4;
    --gate-hint: #71717a;
    --gate-name-gradient: linear-gradient(to bottom, #9ca3af 0%, #000000 75%, #000000 100%);
  }
  .gate-surface {
    background-color: var(--gate-bg);
    color: var(--gate-fg);
  }

  .gate-audio-hint {
    color: var(--gate-hint);
  }

  /* No music promise until the verdict is `full`. On `lite` the soundtrack is
     not preloaded, not played at commit, and not armed on a later gesture, so
     this note would advertise something the page will not deliver. `pending`
     hides it too, because there the verdict is simply unknown: the gate arms at
     2.6s while a `pending` tier may still be unresolved, and a note shown
     before the page knows whether it can deliver music is a promise it may not
     keep. Media-tiering D4 already treats `pending` as collapsed for the
     collage; the note follows the same reading.
     What the warm-cache rule changed here: the once-common unresolved case — a
     returning Safari guest whose burst transfers no payload — now resolves to
     `full` at window `load` on locality evidence, rather than falling to `lite`
     at the 7s failsafe. So the note usually appears while the loader is still
     up. That is not guaranteed (`load` can be pushed past the dwell by a
     stalled subresource), which is why this keys on the attribute and never
     assumes when resolution happened.
     Keyed on the explicit values, never on `:not([data-tier="full"])`, so a
     rolled-back build without the head script keeps today's behavior. */
  :global(html[data-tier="lite"]) .gate-audio-hint,
  :global(html[data-tier="pending"]) .gate-audio-hint {
    display: none;
  }

  /* The pattern SVG lives in DotPattern's scope, so only the #welcome-gate
     ancestor carries this component's scope hash. */
  #welcome-gate :global(svg.dot-pattern-background circle) {
    fill: var(--gate-dots);
  }

  /* Swipe hint = the loading screen's cycling-phrases shimmer, verbatim:
     same classes/size/duration on the element and the same two gradients
     here — white-centered in dark mode, dark-centered in light. */
  #welcome-gate :global(text-shimmer [data-text]),
  #welcome-gate :global(text-shimmer [data-text-out]) {
    background-image: linear-gradient(110deg, #4b5563, 45%, #ffffff, 55%, #4b5563);
  }

  @media (prefers-color-scheme: light) {
    #welcome-gate :global(text-shimmer [data-text]),
    #welcome-gate :global(text-shimmer [data-text-out]) {
      background-image: linear-gradient(110deg, #a8a29e, 45%, #292524, 55%, #a8a29e);
    }
  }

  /* --- Greeting text ------------------------------------------------------ */

  /* Greeting text styled like Aceternity's Shooting Stars and Stars Background:
     bold sans-serif, tight tracking, large display scale (up to text-6xl / 60px).
     Dark theme: high-contrast dark charcoal to bright white (matches Aceternity).
     Light theme: visible grey to solid black. */
  .gate-guest-name {
    overflow-wrap: anywhere;              /* long names wrap instead of clipping */
    font-size: 2.25rem;                   /* 36px (text-4xl) */
    line-height: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    background-image: var(--gate-name-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @media (min-width: 640px) {
    .gate-guest-name {
      font-size: 3rem;                    /* 48px (text-5xl) */
      line-height: 1.15;
    }
  }

  @media (min-width: 768px) {
    .gate-guest-name {
      font-size: 3.75rem;                 /* 60px (text-6xl) */
      line-height: 1.1;
    }
  }

  @media (prefers-color-scheme: light) {
    .gate-guest-name {
      background-image: var(--gate-name-gradient, linear-gradient(to bottom, #9ca3af 0%, #000000 75%, #000000 100%));
    }
  }

  :global(.light) .gate-guest-name,
  :global([data-theme="light"]) .gate-guest-name {
    background-image: linear-gradient(to bottom, #9ca3af 0%, #000000 75%, #000000 100%);
  }
</style>

<script is:inline>
  (function () {
    var gate = document.getElementById('welcome-gate');
    if (!gate) return;

    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var armed = false;
    var committed = false;
    var tracking = false;
    var metricFired = false;

    var startY = 0;
    var currentY = 0;
    var lastY = 0;
    var lastT = 0;
    var velocity = 0; // px/ms, upward positive

    // Tunables — the spec pins the behavior classes, not the constants.
    var COMMIT_DISTANCE = 0.28; // fraction of viewport height
    var COMMIT_VELOCITY = 0.5; // px/ms upward flick
    var COMMIT_MS = 400;
    var SPRING_MS = 250;
    var STALE_VELOCITY_MS = 100;
    var TAP_THRESHOLD = 10; // px displacement: movement below this is treated as a tap
    var BOUNCE_PEAK = 54; // px upward peek on tap
    var BOUNCE_MS = 520;
    // iOS-like drawer curve for both non-tracking transitions (commit sweep and
    // snap-back) — a full-viewport physical surface earns more than bare ease-out.
    var GATE_EASE = 'cubic-bezier(0.32, 0.72, 0, 1)';

    var touchStartClientY = 0;
    var dragDistance = 0;
    // Identifier of the finger that owns the current drag (see onTouchStart).
    var activeTouchId = null;
    var lastPointerEndTime = 0;
    var bounceAnim = null;

    // Root-only scroll lock, deliberately NOT `<body>` as well.
    //
    // Overflow propagation (CSS Overflow §3.5): the root's `hidden` is applied to
    // the viewport and the root itself computes to `visible`. With `<body>` also
    // set to `hidden` there is nothing left to propagate, so body keeps its own
    // `hidden` and becomes a scroll container whose scrollable overflow is zero.
    // The hero then resolves its nearest scroll container to that non-scrollable
    // body, its `view-timeline` goes INACTIVE, the animation stops applying, and
    // HeroZoom falls back to its static base styles — which are the fully revealed
    // (zoomed-OUT) hero. That is the frame the swipe uncovers, snapping back to
    // scale(2.8) once the lock is released.
    //
    // Locking the root alone leaves the viewport as the hero's scroll container
    // (still scrollable overflow, just not user-scrollable), so the hero holds its
    // scroll-zero state through the whole reveal. Touch is held by the gate's own
    // `touch-action: none` + non-passive `preventDefault()` in onTouchMove, which
    // is what actually stops iOS panning regardless of this lock.
    function lockScroll() {
      document.documentElement.style.overflow = 'hidden';
    }

    function unlockScroll() {
      document.documentElement.style.overflow = '';
    }

    // Keep the content behind the gate out of the a11y/focus tree while armed,
    // so keyboard/AT users can't Tab into a visually covered page. inert is a
    // no-op where unsupported, degrading gracefully to the previous behavior.
    function setMainInert(inert) {
      var main = document.querySelector('main');
      if (!main) return false;
      if (inert) {
        main.setAttribute('inert', '');
      } else {
        main.removeAttribute('inert');
      }
      return true;
    }

    // This inline script runs before <main> is parsed (the gate sits above it
    // in the markup), so applying inert at arm time can miss. Apply it now and
    // re-assert once <main> exists (DOMContentLoaded) while the gate is armed.
    function applyInert() {
      if (setMainInert(true)) return;
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function onReady() {
          if (armed && !committed) setMainInert(true);
        }, { once: true });
      }
    }

    function fireOpenMetric() {
      if (metricFired) return;
      // Cookie-identified, once per pageview, fire-and-forget: the reveal is
      // never delayed or failed by this request.
      if (!/(?:^|;\s*)ww_invite_id=/.test(document.cookie)) return;
      metricFired = true;
      try {
        fetch('/api/invite/opened', { method: 'POST', keepalive: true });
      } catch (err) {
        // Best-effort metric: swallow transport-level failures too.
      }
    }

    function startMusicNow() {
      // startMusic lives in the homepage inline script; calling it
      // synchronously inside the committing gesture keeps playback
      // policy-compliant on mobile (transient activation window).
      if (typeof window.startMusic === 'function') {
        try {
          window.startMusic();
        } catch (err) {
          // Music is non-critical; never break the reveal for it.
        }
      }
    }

    function finishReveal() {
      // Release the background from inert before the gate leaves the tree.
      setMainInert(false);
      gate.remove();
      unlockScroll();
    }

    function commit() {
      if (committed) return;
      committed = true;
      if (bounceAnim) {
        bounceAnim.cancel();
        bounceAnim = null;
      }
      disarm();

      startMusicNow();
      fireOpenMetric();

      if (reducedMotion) {
        // No tracking, no slide: instant dismissal.
        finishReveal();
        return;
      }

      var finished = false;
      var finish = function () {
        if (finished) return;
        finished = true;
        finishReveal();
      };

      gate.style.transition = 'transform ' + COMMIT_MS + 'ms ' + GATE_EASE;
      gate.style.transform = 'translateY(-100%)';
      gate.addEventListener('transitionend', finish, { once: true });
      // Safety net: transitionend can be dropped (hidden tab, interrupted).
      setTimeout(finish, COMMIT_MS + 100);
    }

    // --- Motion interruption & bounce --------------------------------------

    function stopMotion() {
      if (bounceAnim) {
        try {
          var style = window.getComputedStyle(gate);
          var transform = style.transform;
          if (transform && transform !== 'none') {
            var m = new DOMMatrixReadOnly(transform);
            currentY = m.m42;
          } else {
            currentY = 0;
          }
        } catch (err) {
          currentY = 0;
        }
        bounceAnim.cancel();
        bounceAnim = null;
      } else {
        try {
          var s = window.getComputedStyle(gate);
          var t = s.transform;
          if (t && t !== 'none') {
            var matrix = new DOMMatrixReadOnly(t);
            currentY = matrix.m42;
          } else {
            currentY = 0;
          }
        } catch (err) {
          currentY = 0;
        }
      }
      gate.style.transition = 'none';
      gate.style.transform = 'translateY(' + currentY + 'px)';
    }

    function triggerTapBounce() {
      if (committed || tracking) return;
      if (bounceAnim) {
        bounceAnim.cancel();
        bounceAnim = null;
      }
      gate.style.transition = 'none';

      // Original iPhone-like lockscreen tap bounce:
      // The curtain hops up a little (-54px) against gravity (ease-out),
      // drops to bottom under gravity (ease-in), bounces up to -14px, drops,
      // micro-rebounds to -3.5px, and settles at rest (translateY(0)).
      var startTransform = currentY < 0 ? 'translateY(' + currentY + 'px)' : 'translateY(0px)';
      var targetPeak = Math.min(-BOUNCE_PEAK, currentY - 20);
      var keyframes = [
        { transform: startTransform, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
        { transform: 'translateY(' + targetPeak + 'px)', offset: 0.30, easing: 'cubic-bezier(0.55, 0, 0.9, 0.4)' },
        { transform: 'translateY(0px)', offset: 0.58, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
        { transform: 'translateY(-14px)', offset: 0.76, easing: 'cubic-bezier(0.55, 0, 0.9, 0.4)' },
        { transform: 'translateY(0px)', offset: 0.88, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
        { transform: 'translateY(-3.5px)', offset: 0.95, easing: 'cubic-bezier(0.55, 0, 0.9, 0.4)' },
        { transform: 'translateY(0px)', offset: 1 }
      ];

      if (typeof gate.animate === 'function') {
        bounceAnim = gate.animate(keyframes, {
          duration: BOUNCE_MS,
          fill: 'forwards'
        });
        bounceAnim.onfinish = function () {
          gate.style.transform = 'translateY(0)';
          if (bounceAnim) {
            bounceAnim.cancel();
            bounceAnim = null;
          }
          currentY = 0;
        };
      } else {
        gate.style.transition = 'transform 250ms ' + GATE_EASE;
        gate.style.transform = 'translateY(-' + BOUNCE_PEAK + 'px)';
        setTimeout(function () {
          if (committed || tracking) return;
          gate.style.transition = 'transform 250ms ' + GATE_EASE;
          gate.style.transform = 'translateY(0)';
          currentY = 0;
        }, 250);
      }
    }

    // --- Swiped up release: turn back and bounce based on pull distance ---

    function triggerPullBounce(pullDistance, vel) {
      if (committed || tracking) return;
      if (bounceAnim) {
        bounceAnim.cancel();
        bounceAnim = null;
      }
      gate.style.transition = 'none';

      var dist = Math.max(1, pullDistance);
      var downwardVel = (typeof vel === 'number' && vel < 0) ? -vel : 0;
      var impactBoost = Math.min(80, downwardVel * 100);
      var effectiveDist = dist + impactBoost;

      // Restitution factor: rebound height is directly proportional to how far
      // the curtain was pulled up before release.
      var RESTITUTION = 0.28;
      var b1 = Math.round(effectiveDist * RESTITUTION * 10) / 10;
      var b2 = Math.round(b1 * RESTITUTION * 10) / 10;
      var b3 = Math.round(b2 * RESTITUTION * 10) / 10;

      // Durations derived from square-root physical kinematics (px -> ms)
      var tFall = Math.max(80, Math.min(240, Math.round(70 + Math.sqrt(dist) * 10)));
      var tB1 = Math.max(40, Math.min(140, Math.round(30 + Math.sqrt(b1) * 12)));
      var tB2 = b1 >= 5 ? Math.max(30, Math.min(90, Math.round(20 + Math.sqrt(b2) * 12))) : 0;
      var tB3 = b2 >= 4 ? Math.max(20, Math.min(60, Math.round(15 + Math.sqrt(b3) * 12))) : 0;

      var totalMs = tFall + 2 * tB1 + (tB2 ? 2 * tB2 : 0) + (tB3 ? 2 * tB3 : 0);

      var keyframes = [];
      var elapsed = 0;

      // Start: from the pulled-up position, accelerating downward to floor under gravity
      keyframes.push({
        transform: 'translateY(' + currentY + 'px)',
        offset: 0,
        easing: 'cubic-bezier(0.55, 0, 0.9, 0.4)'
      });

      // Impact 1 at floor
      elapsed += tFall;
      keyframes.push({
        transform: 'translateY(0px)',
        offset: Math.min(0.99, Math.round((elapsed / totalMs) * 1000) / 1000),
        easing: 'cubic-bezier(0.22, 1, 0.36, 1)'
      });

      // Rebound 1 apex
      elapsed += tB1;
      keyframes.push({
        transform: 'translateY(-' + b1 + 'px)',
        offset: Math.min(0.99, Math.round((elapsed / totalMs) * 1000) / 1000),
        easing: 'cubic-bezier(0.55, 0, 0.9, 0.4)'
      });

      // Impact 2 at floor
      elapsed += tB1;
      keyframes.push({
        transform: 'translateY(0px)',
        offset: tB2 ? Math.min(0.99, Math.round((elapsed / totalMs) * 1000) / 1000) : 1,
        easing: tB2 ? 'cubic-bezier(0.22, 1, 0.36, 1)' : undefined
      });

      if (tB2) {
        // Rebound 2 apex
        elapsed += tB2;
        keyframes.push({
          transform: 'translateY(-' + b2 + 'px)',
          offset: Math.min(0.99, Math.round((elapsed / totalMs) * 1000) / 1000),
          easing: 'cubic-bezier(0.55, 0, 0.9, 0.4)'
        });

        // Impact 3 at floor
        elapsed += tB2;
        keyframes.push({
          transform: 'translateY(0px)',
          offset: tB3 ? Math.min(0.99, Math.round((elapsed / totalMs) * 1000) / 1000) : 1,
          easing: tB3 ? 'cubic-bezier(0.22, 1, 0.36, 1)' : undefined
        });
      }

      if (tB3) {
        // Rebound 3 apex
        elapsed += tB3;
        keyframes.push({
          transform: 'translateY(-' + b3 + 'px)',
          offset: Math.min(0.99, Math.round((elapsed / totalMs) * 1000) / 1000),
          easing: 'cubic-bezier(0.55, 0, 0.9, 0.4)'
        });

        keyframes.push({
          transform: 'translateY(0px)',
          offset: 1
        });
      }

      if (typeof gate.animate === 'function') {
        bounceAnim = gate.animate(keyframes, {
          duration: totalMs,
          fill: 'forwards'
        });
        bounceAnim.onfinish = function () {
          gate.style.transform = 'translateY(0)';
          if (bounceAnim) {
            bounceAnim.cancel();
            bounceAnim = null;
          }
          currentY = 0;
        };
      } else {
        gate.style.transition = 'transform ' + totalMs + 'ms ' + GATE_EASE;
        gate.style.transform = 'translateY(0)';
        currentY = 0;
      }
    }

    // --- Touch: Level-2 finger-tracked swipe -------------------------------

    function onTouchStart(e) {
      if (committed || tracking || e.touches.length !== 1) return;
      stopMotion();
      tracking = true;
      var touch = e.touches[0];
      // Latch THIS finger. `touches[0]` is not stable: a second finger landing
      // (or the first lifting while another is down) re-points index 0 at a
      // different contact, which would teleport the gate mid-gesture.
      activeTouchId = touch.identifier;
      var clientY = touch.clientY;
      touchStartClientY = clientY;
      startY = clientY - currentY;
      dragDistance = 0;
      lastY = currentY;
      lastT = e.timeStamp;
      velocity = 0;
    }

    /** The latched finger, or null once it has left the screen. */
    function trackedTouch(list) {
      for (var i = 0; i < list.length; i++) {
        if (list[i].identifier === activeTouchId) return list[i];
      }
      return null;
    }

    function onTouchMove(e) {
      if (!tracking || committed) return;
      var touch = trackedTouch(e.touches);
      // Extra fingers are ignored outright rather than allowed to steer.
      if (!touch) return;
      // Non-passive listener: stop scroll chaining / rubber-band leak.
      e.preventDefault();
      var clientY = touch.clientY;
      dragDistance = Math.max(dragDistance, Math.abs(clientY - touchStartClientY));
      // 1:1 upward tracking, clamped — the gate never travels downward.
      var y = Math.min(0, clientY - startY);
      currentY = y;
      var dt = e.timeStamp - lastT;
      if (dt > 0) {
        velocity = (lastY - y) / dt;
        lastY = y;
        lastT = e.timeStamp;
      }
      gate.style.transform = 'translateY(' + y + 'px)';
    }

    function onTouchEnd(e) {
      if (!tracking || committed) return;
      // Only the finger that started the drag can end it: lifting a second,
      // incidental finger must not commit or abort someone's swipe.
      //
      // Deliberately NOT guarded by `activeTouchId !== null`. This check must
      // fail CLOSED: if the latch were ever missing while tracking, an
      // `activeTouchId !== null &&` prefix would let any stray finger-lift
      // commit the gate — precisely the bug this guard exists to prevent.
      // With no latch, trackedTouch() returns null and the handler no-ops.
      //
      // The `touches.length === 0` escape below keeps that from stranding the
      // gesture: when the screen is empty there is nothing left to track, so
      // the drag is released even if the owning finger's id never appeared in
      // changedTouches (a dropped contact with no touchcancel).
      if (!trackedTouch(e.changedTouches) && e.touches.length > 0) return;
      tracking = false;
      activeTouchId = null;
      lastPointerEndTime = Date.now();

      // A finger that rested before release carries no flick.
      if (e.timeStamp - lastT > STALE_VELOCITY_MS) velocity = 0;

      var threshold = window.innerHeight * COMMIT_DISTANCE;
      if (-currentY >= threshold || velocity >= COMMIT_VELOCITY) {
        // The committing touchend already starts the music synchronously;
        // stop it bubbling to the homepage's document-level armed-gesture
        // listener so startMusic isn't invoked twice in one window.
        e.stopPropagation();
        commit();
      } else if (dragDistance < TAP_THRESHOLD && -currentY < TAP_THRESHOLD) {
        // Tapping does not open the gate: hop up a little and bounce to the bottom
        triggerTapBounce();
      } else {
        // Swiped up and released below threshold:
        // Turn back and bounce at the bottom, with hardness based on pulled length
        triggerPullBounce(-currentY, velocity);
      }
    }

    function onTouchCancel() {
      if (!tracking) return;
      tracking = false;
      activeTouchId = null;
      window.removeEventListener('mousemove', onMouseMove);
      window.removeEventListener('mouseup', onMouseUp);
      if (-currentY >= TAP_THRESHOLD) {
        triggerPullBounce(-currentY, 0);
      } else {
        gate.style.transition = 'transform ' + SPRING_MS + 'ms ' + GATE_EASE;
        gate.style.transform = 'translateY(0)';
        currentY = 0;
      }
    }

    // --- Mouse: Desktop click and drag -------------------------------------

    function onMouseDown(e) {
      if (committed || tracking || e.button !== 0) return;
      // Ignore synthesized mouse events after touch
      if (Date.now() - lastPointerEndTime < 500) return;
      e.preventDefault();
      stopMotion();
      tracking = true;
      var clientY = e.clientY;
      touchStartClientY = clientY;
      startY = clientY - currentY;
      dragDistance = 0;
      lastY = currentY;
      lastT = e.timeStamp;
      velocity = 0;

      window.addEventListener('mousemove', onMouseMove);
      window.addEventListener('mouseup', onMouseUp);
    }

    function onMouseMove(e) {
      if (!tracking || committed) return;
      var clientY = e.clientY;
      dragDistance = Math.max(dragDistance, Math.abs(clientY - touchStartClientY));
      var y = Math.min(0, clientY - startY);
      currentY = y;
      var dt = e.timeStamp - lastT;
      if (dt > 0) {
        velocity = (lastY - y) / dt;
        lastY = y;
        lastT = e.timeStamp;
      }
      gate.style.transform = 'translateY(' + y + 'px)';
    }

    function onMouseUp(e) {
      if (!tracking) return;
      tracking = false;
      window.removeEventListener('mousemove', onMouseMove);
      window.removeEventListener('mouseup', onMouseUp);
      lastPointerEndTime = Date.now();

      if (committed) return;
      if (e.timeStamp - lastT > STALE_VELOCITY_MS) velocity = 0;

      var threshold = window.innerHeight * COMMIT_DISTANCE;
      if (-currentY >= threshold || velocity >= COMMIT_VELOCITY) {
        commit();
      } else if (dragDistance < TAP_THRESHOLD && -currentY < TAP_THRESHOLD) {
        triggerTapBounce();
      } else {
        triggerPullBounce(-currentY, velocity);
      }
    }

    function onClick() {
      if (committed) return;
      // If pointer interaction (touch or mouse) just completed, the tap bounce
      // or commit was already handled.
      if (Date.now() - lastPointerEndTime < 500) return;
      triggerTapBounce();
    }

    // --- Desktop: functional dismissal (wheel / keydown) -------------------

    function dismissIfArmed(e) {
      if (committed) return;
      // A stray keypress while the (possibly long-loading) loader still covers
      // the gate must not burn the envelope reveal behind it.
      if (e && e.type === 'keydown' && document.getElementById('loading-screen')) return;
      commit();
    }

    // --- Arming --------------------------------------------------------------

    function disarm() {
      if (bounceAnim) {
        bounceAnim.cancel();
        bounceAnim = null;
      }
      gate.removeEventListener('touchstart', onTouchStart);
      gate.removeEventListener('touchmove', onTouchMove);
      gate.removeEventListener('touchend', onTouchEnd);
      gate.removeEventListener('touchcancel', onTouchCancel);
      gate.removeEventListener('mousedown', onMouseDown);
      window.removeEventListener('mousemove', onMouseMove);
      window.removeEventListener('mouseup', onMouseUp);
      gate.removeEventListener('click', onClick);
      gate.removeEventListener('wheel', dismissIfArmed);
      gate.removeEventListener('click', dismissIfArmed);
      gate.removeEventListener('touchend', dismissIfArmed);
      gate.removeEventListener('pointerup', dismissIfArmed);
      window.removeEventListener('keydown', dismissIfArmed);
    }

    function arm() {
      if (armed) return;
      armed = true;

      // The gesture is live: cancel the CSS failsafe auto-dismiss.
      if (typeof gate.getAnimations === 'function') {
        gate.getAnimations().forEach(function (anim) {
          anim.cancel();
        });
      }

      lockScroll();
      applyInert();

      if (reducedMotion) {
        // A reduced-motion finger swipe does not synthesize `click`, so bind
        // touchend/pointerup as well — any release dismisses instantly.
        gate.addEventListener('click', dismissIfArmed, { passive: true });
        gate.addEventListener('touchend', dismissIfArmed, { passive: true });
        gate.addEventListener('pointerup', dismissIfArmed, { passive: true });
        window.addEventListener('keydown', dismissIfArmed, { passive: true });
        return;
      }

      gate.addEventListener('touchstart', onTouchStart, { passive: true });
      gate.addEventListener('touchmove', onTouchMove, { passive: false });
      gate.addEventListener('touchend', onTouchEnd, { passive: true });
      gate.addEventListener('touchcancel', onTouchCancel, { passive: true });
      gate.addEventListener('mousedown', onMouseDown);
      gate.addEventListener('click', onClick);
      // Wheel carries no user activation; music stays on the homepage's
      // armed-gesture fallback for desktop.
      gate.addEventListener('wheel', dismissIfArmed, { passive: true });
      window.addEventListener('keydown', dismissIfArmed, { passive: true });
    }

    // The "scroll 0 by construction" assumption breaks on reload / bfcache
    // scroll restoration — pin it explicitly before locking.
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    window.scrollTo(0, 0);

    // Arm only after the loading screen has faded and been removed. Do not
    // poll with queueMicrotask here: a self-rescheduling microtask starves the
    // event loop, so the loader's timer/module code can never run and the
    // browser remains permanently stuck before DOMContentLoaded.
    const loader = document.getElementById('loading-screen');
    if (!loader) {
      arm();
    } else {
      const loaderParent = loader.parentNode;
      const observer = new MutationObserver(function () {
        if (loader.isConnected) return;
        observer.disconnect();
        arm();
      });
      observer.observe(loaderParent || document.documentElement, {
        childList: true,
      });
    }
  })();
</script>
