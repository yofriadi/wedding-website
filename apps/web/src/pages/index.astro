---
import Layout from "../layouts/Layout.astro";
import HeroZoom from "../components/HeroZoom.astro";
import QuranVerse from "../components/QuranVerse.astro";
import FamiliesReveal from "../components/FamiliesReveal.astro";
import ZoomParallax from "../components/ZoomParallax.astro";
import TimelineScroll from "../components/TimelineScroll.astro";
import MagneticImageTrail from "../components/MagneticImageTrail.astro";
import AddImageButton from "../components/AddImageButton.astro";
import WeddingFAQ from '../components/WeddingFAQ.astro';
import TextShimmer from "../components/TextShimmer.astro";
import WelcomeGate from "../components/WelcomeGate.astro";
import ClaimMemberGate from "../components/ClaimMemberGate.astro";
import RsvpSection from "../components/RsvpSection.astro";
import VenueMap from "../components/VenueMap.astro";
import EventTimes from "../components/EventTimes.astro";
import DesktopGate from "../components/DesktopGate.astro";
import { db } from "@wedding-website/db";
import { invites, rsvps } from "@wedding-website/db/schema";
import { eq } from "drizzle-orm";

import { inviteIdFromCookies, readGroupQuota } from "../lib/invite-session";
import { HERO_SIZES, HERO_SRCSET_AVIF } from "../lib/hero-media";

// Personalized greeting + RSVP controls (server-rendered; read-only — metrics
// stay exclusive to /{id}).
let inviteDisplayName: string | null = null;
let inviteRsvpAttending: boolean | null = null;
let inviteKind: "individual" | "member" | "group" | null = null;
let inviteGroupQuota: { maxMembers: number; claimedCount: number } | null = null;
const inviteCookieValue = inviteIdFromCookies(Astro.cookies);
if (inviteCookieValue) {
  try {
    const inviteRow = await db
      .select({
        id: invites.id,
        displayName: invites.displayName,
        attending: rsvps.attending,
        type: invites.type,
        parentId: invites.parentId,
        maxMembers: invites.maxMembers,
      })
      .from(invites)
      .leftJoin(rsvps, eq(rsvps.inviteId, invites.id))
      .where(eq(invites.id, inviteCookieValue))
      .limit(1);
    const row = inviteRow[0];
    inviteDisplayName = row?.displayName ?? null;
    inviteRsvpAttending = row?.attending ?? null;
    const parentId = row?.parentId ?? null;
    // Derived exactly as resolveInvite derives it — this page keeps its own
    // inline query rather than sharing that helper.
    inviteKind = !row
      ? null
      : parentId !== null
        ? "member"
        : row.type === "group"
          ? "group"
          : "individual";
    if (row && inviteKind === "group") {
      // Groups pay one extra COUNT; members pay one for the PARENT's quota. Both
      // go through readGroupQuota, which derives claimedCount from the member rows
      // so it can never drift. Errors propagate to the outer catch here ON
      // PURPOSE: the quota decides whether to offer the claim form at all, so
      // failing closed to anonymous is the safer degrade — offering a claim form on
      // unknown quota would let a full group loop submit -> 409 -> reload.
      const quota = await readGroupQuota(row.id);
      if (quota) {
        inviteGroupQuota = quota;
      } else {
        // Unreachable in practice: readGroupQuota's non-group branch is dead
        // (nothing UPDATEs invites.type — only seen_*/opened_* metrics ever move)
        // and a group WITH members cannot be deleted, because the self-FK refuses.
        // The only residual trigger is a hand-run DELETE of a memberless group
        // racing this render. Reset rather than throw: the same fail-closed outcome
        // (no group UI, so no claim form on unknown quota) without manufacturing an
        // exception that would read as a bug in the container log.
        inviteKind = null;
        inviteDisplayName = null;
        inviteRsvpAttending = null;
        inviteGroupQuota = null;
      }
    }
  } catch (err) {
    // The page must never break on a lookup failure — degrade to anonymous.
    console.error("[invite-greeting] lookup failed:", err);
    inviteDisplayName = null;
    inviteRsvpAttending = null;
    inviteKind = null;
    inviteGroupQuota = null;
  }
}

const canClaimAtEntry =
  inviteKind === "group" &&
  inviteGroupQuota !== null &&
  inviteGroupQuota.claimedCount < inviteGroupQuota.maxMembers;

// Homepage HTML is personalized per invite; never let a shared cache serve it.
Astro.response.headers.set("Cache-Control", "no-store");

---

<Layout title="Yofriadi Yahya & Aisha Amalia">
  {/*
    LCP hint (responsive-media: "The largest contentful paint image is
    prioritised"). Routed through Layout's `head` slot rather than written into
    Layout, because Layout is shared and only this page renders a hero.

    `imagesrcset`/`imagesizes` mirror HeroZoom's AVIF `<source>` — both read the
    same constants, so they cannot drift. A bare `href` would fetch a candidate
    the `<picture>` then discards. `type="image/avif"` lets a non-AVIF engine
    skip the hint instead of fetching bytes it will throw away.

    `fetchpriority="high"` MATCHES the `<img>`'s, deliberately. The
    `responsive-media` "exactly one image" rule counts `img` elements and a
    `<link>` is not one; Chrome's guidance for a preloaded LCP image is that the
    hint and its consumer agree, and a preload left at default priority is queued
    BELOW the font preload that Layout emits first in document order — so the
    hint would not deliver the prioritisation this comment block claims, and
    Chrome reports the mismatch.
  */}
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset={HERO_SRCSET_AVIF}
    imagesizes={HERO_SIZES}
    fetchpriority="high"
  />
  {/* Predicate kept in sync with DesktopGate.astro and DESKTOP_MEDIA_QUERY */}
  <script is:inline slot="head">
    if (window.matchMedia('(min-width: 768px) and (min-height: 600px)').matches) {
      document.documentElement.setAttribute('data-desktop', '');
    }
  </script>
  {/*
    Basemap tile hints for `<VenueMap />`, rendered unconditionally further down
    this page. They live here rather than inside the component because a
    `<link rel="preconnect">` in the body is an HTML conformance error — the
    Standard permits a body `<link>` only with `itemprop` — and engines honour it
    there only as a quirk. This page is the map's only consumer, so a head-level
    hint ships exactly when the map does.

    COUNT: one `preconnect`, three `dns-prefetch` — not four `preconnect`s. The
    map is below the fold AND lazily initialized (IntersectionObserver, then a
    dynamic `import("./venue-map")`), so its first tile request is seconds away;
    four TCP+TLS handshakes opened during parse would be four idle sockets held
    for a widget the guest may never scroll to. `venue-map.ts:518,523` sets
    `subdomains: "abcd"` and Leaflet round-robins them by tile coordinate, so no
    single host is guaranteed to carry the first tile: `a` gets the full
    handshake and b/c/d get DNS only, which is the expensive half of a cold
    cross-origin lookup at a fraction of the socket cost.

    Tiles are plain `<img>` fetches (no `crossOrigin` on the Leaflet TileLayer),
    so these are no-CORS hints — adding `crossorigin` would warm the wrong pool.
    They follow the hero and font preloads in document order, so they cannot
    displace the LCP path on the throttled link this change exists to protect.
  */}
  <link slot="head" rel="preconnect" href="https://a.basemaps.cartocdn.com" />
  <link slot="head" rel="dns-prefetch" href="https://b.basemaps.cartocdn.com" />
  <link slot="head" rel="dns-prefetch" href="https://c.basemaps.cartocdn.com" />
  <link slot="head" rel="dns-prefetch" href="https://d.basemaps.cartocdn.com" />
  <!-- Loading Overlay -->
  <div id="loading-screen" class="fixed inset-0 z-50 flex items-center justify-center transition-opacity duration-300 ease-out">
    <div class="flex flex-col items-center">
      <TextShimmer
        class="text-xl font-medium tracking-tight font-[sans-serif]"
        duration={2}
        phrases={[
          "nyari titik koma yang ilang…",
          "konsultasi sama kerang ajaib…",
          "nyenyenyenyenye…",
          "ndasmu…",
          "Di desa ngga pakai dolar…",
          "sorry yee…",
          "sodara-sodara…",
          "Kompilasi 1 dan 0 jadi cerita kami…",
          "Dikit lagi beres, siap-siap takjub…",
        ]}
      >
        nyari titik koma yang ilang…
      </TextShimmer>
    </div>
  </div>

  {/*
    No-script escape (progressive-enhancement: "An overlay never traps a
    no-script guest"). This layer is `fixed inset-0 z-50` and opaque, and
    `doHideLoadingScreen` below is the only thing that removes it — so without
    scripting a guest sits behind it permanently. `WelcomeGate` already
    establishes the idiom (its own <noscript> plus an `@media (scripting:
    none)` twin, because Safari has not shipped the `scripting` feature):
    SUPPRESS the overlay without script, never invert it. The loader still ships
    rendered, so the scripted path — which fades and removes it — is untouched.
  */}
  <noscript>
    <style>
      #loading-screen {
        display: none;
      }
    </style>
  </noscript>

  {/* Entry claim gate: presented before WelcomeGate for eligible group invites */}
  {canClaimAtEntry && <ClaimMemberGate />}

  <!-- Welcome gate: the loader fade reveals it; swipe up opens the site. -->
  <WelcomeGate displayName={inviteDisplayName} />

  <!-- Background Music: ships at preload="none". The tier decides whether the
       3.1 MB file is ever fetched — see the soundtrack block in the inline
       script below (media-tiering: "Soundtrack is tier-conditional"). -->
  <audio id="hero-music" loop preload="none">
    <source src="/Lee Soo Young - ONE - ENGLISH Version.mp3" type="audio/mpeg" />
  </audio>

  <DesktopGate />

  <main class="relative">
    <HeroZoom />
    <QuranVerse />
    <FamiliesReveal />
    <ZoomParallax />
    <!-- Collage promoter (media-tiering). Inline and here, not in a module:
         it must run the instant the collage markup above has parsed, so a
         `full` verdict starts every collage fetch as early as a shipped `src`
         would. `lite` is left to ZoomParallax's per-image approach observer.
         Promotion is idempotent — a second pass over promoted markup is a no-op. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (root.hasAttribute('data-desktop')) return;
        var PENDING = '#zoom-parallax-container img[data-src]:not([data-promoted])';

        function promote() {
          var images = document.querySelectorAll(PENDING);
          for (var i = 0; i < images.length; i++) {
            var img = images[i];
            var picture = img.closest('picture');
            if (picture) {
              // <source> first: setting the <img> src makes the <picture>
              // re-resolve, and the other order would fetch the WebP fallback
              // and then the AVIF over it.
              //
              // No `:not([srcset])` clause. Every collage <source> now ships a
              // LIVE low-fidelity srcset, so a presence test would never match:
              // the <source> would stay on the placeholder and, because
              // <picture> resolves to the first matching <source>, every
              // AVIF-capable engine would keep the 32px image forever.
              var sources = picture.querySelectorAll('source[data-srcset]');
              for (var j = 0; j < sources.length; j++) {
                sources[j].setAttribute('srcset', sources[j].getAttribute('data-srcset'));
              }
            }
            // Candidate swap, not a source addition: both attributes are
            // OVERWRITTEN, srcset before src so the promoted AVIF <source> wins
            // the re-resolution and the WebP fallback is never fetched.
            var deferredSet = img.getAttribute('data-srcset');
            if (deferredSet) img.setAttribute('srcset', deferredSet);
            var deferred = img.getAttribute('data-src');
            if (deferred) img.setAttribute('src', deferred);
            // The marker is the SOLE idempotency mechanism: every image has a
            // live src from the moment it parses, so `:not([src])` no longer
            // discriminates anything. Set last, so a throw mid-promotion leaves
            // the element eligible for the next pass.
            img.setAttribute('data-promoted', '');
          }
        }

        // Polarity matches the CSS and other consumers: only an explicit `lite`
        // defers. A missing attribute means the head script never ran (rollback,
        // script blocker), degrading to full rather than an unpromoted collage.
        var tier = root.getAttribute('data-tier');
        if (tier !== 'lite') {
          promote();
        }
      })();
    </script>
    <TimelineScroll />

    <!-- Public memories, with an invitation-only posting control. Keep the
         stage unclipped so native sticky positioning can park the CTA below
         the trail instead of following visitors into unrelated sections. -->
    <section id="memories-section" class="relative pt-12" aria-labelledby="memories-heading">
      <div class="mx-auto max-w-7xl px-6 mb-6 text-center" data-scroll-fade>
        <h2 id="memories-heading" class="font-serif text-3xl font-light text-[color:var(--memories-heading)] text-balance">
          Bagikan kenanganmu bersama kami
        </h2>
      </div>
      <div class="relative" data-photo-trail-section>
        <MagneticImageTrail />
        <AddImageButton />
      </div>
    </section>

    <!-- Venue map (venue-map-routes) -->
    <VenueMap />

    <!-- Event Times -->
    <EventTimes />

    <!-- Event Details -->
    <div id="rsvp-section" class="relative z-10 px-6 py-12">
      <div class="mx-auto max-w-2xl text-center space-y-10">
        <RsvpSection
          inviteDisplayName={inviteDisplayName}
          rsvpAttending={inviteRsvpAttending}
          inviteKind={inviteKind}
          groupQuota={inviteGroupQuota}
        />
      </div>
    </div>

    <WeddingFAQ />
  </main>

  <script is:inline>
    (function () {
      // Viewport predicate kept in sync with DesktopGate.astro and head script
      var DESKTOP_MEDIA_QUERY = '(min-width: 768px) and (min-height: 600px)';
      var wasGated = false;

      function setElementInert(el, inert) {
        if (!el) return;
        if (inert) {
          el.setAttribute('inert', '');
        } else {
          el.removeAttribute('inert');
        }
      }

      function applyInert(matches) {
        var root = document.documentElement;
        var main = document.querySelector('main');
        var claimGate = document.getElementById('claim-gate');
        var welcomeGate = document.getElementById('welcome-gate');

        if (matches) {
          wasGated = true;
          root.setAttribute('data-desktop', '');
          root.style.overflow = 'hidden';
          setElementInert(main, true);
          setElementInert(claimGate, true);
          setElementInert(welcomeGate, true);
        } else {
          var unGating = wasGated;
          wasGated = false;
          root.removeAttribute('data-desktop');
          if (!welcomeGate || !welcomeGate.isConnected) {
            root.style.overflow = '';
            setElementInert(main, false);
          }
          setElementInert(claimGate, false);
          setElementInert(welcomeGate, false);
          if (typeof window.welcomeGateTryArm === 'function') {
            window.welcomeGateTryArm();
          }
          if (unGating) {
            window.dispatchEvent(new CustomEvent('desktop-gate:release'));
          }
        }
      }

      var mql = window.matchMedia(DESKTOP_MEDIA_QUERY);
      applyInert(mql.matches);
      mql.addEventListener('change', function (e) {
        applyInert(e.matches);
      });
    })();
  </script>

<script is:inline>
  // Background music — tier-conditional (media-tiering).
  //
  // The element ships at preload="none". On `full`, eager preloading begins
  // after an initial 1200ms delay (so LCP hero image and fonts have exclusive bandwidth)
  // and starts playback at the welcome gate's commit gesture. `lite` never downloads
  // it: no preload, no commit playback, and no gesture-armed fallback.
  const heroMusic = document.getElementById('hero-music');
  let hasStarted = false;
  let gestureArmed = false;
  // A swipe-up ends in `touchend`, which browsers accept as a user gesture for
  // audio. Desktop wheel/trackpad scroll does NOT count, so click/key are armed too.
  const gestureEvents = ['touchend', 'pointerup', 'click', 'keydown'];

  function tierIsFull() {
    // Missing attribute degrades to `full` (failsafe).
    return document.documentElement.getAttribute('data-tier') !== 'lite';
  }

  function enableSoundtrack() {
    if (document.documentElement.hasAttribute('data-desktop')) return;
    if (!heroMusic || hasStarted || heroMusic.preload === 'auto') return;
    heroMusic.preload = 'auto';
    // Changing `preload` alone does not restart resource selection on an
    // element that never started loading; load() does.
    heroMusic.load();
  }

  function startMusic() {
    if (document.documentElement.hasAttribute('data-desktop')) return;
    if (!tierIsFull()) return;
    if (!hasStarted && heroMusic) {
      heroMusic.volume = 0.3;
      heroMusic.play()
        .then(() => {
          hasStarted = true;
          disarmMusicGesture();
        })
        .catch(err => {
          console.log('Audio playback failed:', err);
          armMusicGesture();
        });
    }
  }

  function startMusicFromGesture() {
    disarmMusicGesture();
    startMusic();
  }

  function armMusicGesture() {
    if (gestureArmed || hasStarted) return;
    gestureArmed = true;
    for (const event of gestureEvents) {
      document.addEventListener(event, startMusicFromGesture, { once: true, passive: true });
    }
  }

  function disarmMusicGesture() {
    gestureArmed = false;
    for (const event of gestureEvents) {
      document.removeEventListener(event, startMusicFromGesture);
    }
  }

  // Loading screen logic
  //
  // Minimum dwell: on a warm cache / fast connection the media gate resolves
  // in a few hundred ms and the loader would flash for less time than it takes
  // to read one phrase. Hold it up at least LOADER_MIN_DWELL_MS (measured from
  // first paint) so the buffering beat — phrases cycling, then fade into the
  // welcome gate — stays legible on any device.
  const LOADER_MIN_DWELL_MS = 2600;
  // Hard ceiling: the loader is a progress beat, not a gate. Whatever happens
  // to the hero (missing file, decode failure, a connection that stalls), the
  // page must still open. Back to 8s — the 16s value existed only to give the
  // below-fold collage gate runway, and that gate is gone: below-fold
  // readiness is the media tier's job now (Layout.astro's head script).
  const LOADER_MAX_WAIT_MS = 8000;
  const loaderShownAt = performance.now();

  const hideLoadingScreen = () => {
    const elapsed = performance.now() - loaderShownAt;
    const wait = Math.max(0, LOADER_MIN_DWELL_MS - elapsed);
    setTimeout(doHideLoadingScreen, wait);
  };

  const doHideLoadingScreen = () => {
    const loader = document.getElementById('loading-screen');
    if (!loader) return;

    loader.style.opacity = '0';
    setTimeout(() => {
      loader.remove();
    }, 300);

    // NOTE: no startMusic() here. The loader predates the welcome gate; audio
    // unlock now belongs to the gate's commit gesture (WelcomeGate calls
    // window.startMusic() synchronously inside the committing touchend). An
    // uninvited play() with no user activation either throws NotAllowedError
    // or silently violates autoplay policy depending on engine heuristics.
  };

  const waitForHeroZoomLoaded = async () => {
    const heroMedia = document.querySelector('#hero-container [data-hero-media]');
    if (!heroMedia) {
      return;
    }

    if (!heroMedia.complete) {
      await new Promise((resolve) => {
        const onDone = () => resolve();
        heroMedia.addEventListener('load', onDone, { once: true });
        heroMedia.addEventListener('error', onDone, { once: true });
      });
    }

    if (heroMedia.naturalWidth > 0 && typeof heroMedia.decode === 'function') {
      try {
        await heroMedia.decode();
      } catch {
        // Ignore decode failures and continue.
      }
    }
  };

  // Delay soundtrack preloading so the hero LCP image and fonts have exclusive
  // initial bandwidth, while ensuring at least 1.4s of buffering before the
  // loading screen's 2.6s minimum dwell finishes and the gate arms.
  const SOUNDTRACK_START_MS = 1200;
  setTimeout(() => {
    if (tierIsFull()) enableSoundtrack();
  }, SOUNDTRACK_START_MS);
  window.addEventListener('desktop-gate:release', () => {
    if (tierIsFull()) enableSoundtrack();
  });

  const initLoadingScreen = async () => {
    const deadline = new Promise((resolve) => setTimeout(resolve, LOADER_MAX_WAIT_MS));
    try {
      await Promise.race([waitForHeroZoomLoaded(), deadline]);
    } catch {
      // Ignore errors.
    } finally {
      hideLoadingScreen();
    }
  };
  initLoadingScreen();

</script>

<script>
  import "../scripts/scroll-fade";
</script>

<style>
  :root {
    --loading-bg: #0a0a0a; /* dark mode fallback (neutral-950) */

    /* RSVP section (rsvp-star-confirm D5): dark is the baseline, light inverts.
       The section's own component reads these by inheritance — #rsvp-section
       lives here, so this is the file that owns them. */
    --rsvp-bg: #0a0a0a; /* neutral-950 */
    --rsvp-fg: #fafafa; /* neutral-50: counter digits, name, strong copy */
    --rsvp-muted: #a3a3a3; /* neutral-400: labels, note, guidance line */
    --rsvp-error: #f87171; /* red-400 */

    /* Memories section theme; the photo trail owns its own presentation. */
    --memories-bg: #0a0a0a;
    --memories-heading: #d4d4d4;
  }

  /* Light theme */
  @media (prefers-color-scheme: light) {
    :root {
      --loading-bg: #ffffff;
      --rsvp-bg: #ffffff;
      --rsvp-fg: #0a0a0a;
      --rsvp-muted: #525252; /* neutral-600 — holds contrast on white */
      --rsvp-error: #b91c1c; /* red-700 */

      --memories-bg: #ffffff;
      --memories-heading: #404040; /* neutral-700 — readable on white */
    }
  }

  /* Loading screen theme-aware background and default browser font (prevents font shift mid-flight) */
  #loading-screen {
    background-color: var(--loading-bg);
    font-family: sans-serif;
  }

  /* No-script escape, Chromium twin of the <noscript> block above: Safari has
     not shipped the `scripting` media feature, so neither mechanism alone
     covers every engine. Does not match when scripting is enabled. */
  @media (scripting: none) {
    #loading-screen {
      display: none;
    }
  }

  /* RSVP section background (was a hard-coded bg-neutral-950 utility) */
  #rsvp-section {
    background-color: var(--rsvp-bg);
  }

  main {
    background-color: #0a0a0a;
  }
  @media (prefers-color-scheme: light) {
    main {
      background-color: #ffffff;
    }
  }

  /* Memories section background — same rsvp-* treatment: the section owns
     its chrome so it inverts with the OS theme instead of inheriting main's */
  #memories-section {
    background-color: var(--memories-bg);
    margin-top: -1px;
  }

  /* Theme-aware text shimmer gradients for dark mode (white shimmer) */
  #loading-screen :global(text-shimmer [data-text]),
  #loading-screen :global(text-shimmer [data-text-out]) {
    background-image: linear-gradient(110deg, #4b5563, 45%, #ffffff, 55%, #4b5563);
    font-family: sans-serif;
  }

  /* Theme-aware text shimmer gradients for light mode (dark shimmer) */
  @media (prefers-color-scheme: light) {
    #loading-screen :global(text-shimmer [data-text]),
    #loading-screen :global(text-shimmer [data-text-out]) {
      background-image: linear-gradient(110deg, #a8a29e, 45%, #292524, 55%, #a8a29e);
    }
  }

</style>
</Layout>
