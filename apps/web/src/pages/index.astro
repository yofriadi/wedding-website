<Layout title="Save the Date | Yofri & Aisha">
  <!-- Loading Overlay -->
  <div id="loading-screen" class="fixed inset-0 z-50 flex items-center justify-center bg-neutral-950 transition-opacity duration-500">
    <TextShimmer 
      class="text-xl font-medium tracking-tight"
      phrases={[
        "Pre-heating the server…",
        "Converting coffee into code…", 
        "Discombobulating…", 
        "Wrangling…", 
        "Symbioting…", 
        "Perambulating…", 
        "Shenaninganing…"
      ]}
    >
      Pre-heating the server…
    </TextShimmer>
  </div>

  <!-- Background Music -->
  <audio id="hero-music" loop preload="auto">
    <source src="/Lee Soo Young - ONE - ENGLISH Version.mp3" type="audio/mpeg" />
  </audio>

  <main class="relative bg-neutral-950">
    <HeroZoom />
    <QuranVerse />
    <ZoomParallax />
    <TimelineScroll />

    <section class="relative overflow-hidden">
      <div class="mx-auto max-w-7xl px-6">
        <h2 class="text-xl font-light text-center mb-4 text-neutral-300 text-balance">Show Our Memories Together</h2>
      </div>
      <div class="flex gap-2 overflow-x-auto pb-2 no-scrollbar snap-x">
        <div class="snap-center flex-shrink-0 flex flex-col items-center gap-2 pl-6">
          <label class="relative w-[112px] h-[200px] rounded-[12px] border-2 border-dashed border-white/20 flex flex-col items-center justify-center hover:bg-white/5 active:scale-[0.96] transition-[transform,colors] duration-200 cursor-pointer group">
            <input
              type="file"
              accept="image/*"
              multiple
              class="hidden"
              onchange="(() => { const input = this; const selected = input.files; if (!selected) return; if (selected.length > 5) { alert('Maximum 5 images allowed.'); input.value = ''; return; } if (selected.length > 0) { alert('Selected ' + selected.length + ' images. Upload logic to be implemented.'); } })()"
            />
            <div class="absolute inset-0 rounded-[12px] border border-neutral-900/50"></div>
            <svg 
              xmlns="http://www.w3.org/2000/svg" 
              width="40" 
              height="40" 
              viewBox="0 0 24 24" 
              fill="none" 
              stroke="currentColor" 
              stroke-width="1.5" 
              stroke-linecap="round" 
              stroke-linejoin="round" 
              class="text-neutral-400 group-hover:text-white transition-colors mb-2"
            >
              <path d="M5 12h14" />
              <path d="M12 5v14" />
            </svg>
            <span class="text-[10px] text-neutral-500 text-center leading-tight px-2 group-hover:text-neutral-400 transition-colors">Up to 5<br/>images</span>
          </label>
          <span class="text-xs text-slate-500">Add Story</span>
        </div>


        {storyUsers.map((user, index) => (
          <div class={`snap-center flex-shrink-0 ${index === storyUsers.length - 1 ? 'pr-6' : ''}`}>
            <StoryViewer
              stories={user.stories}
              username={user.username}
              avatar={user.avatar}
              timestamp="2026-02-03T16:45:00Z"
            />
          </div>
        ))}
      </div>
    </section>
    <section class="relative py-4 overflow-hidden space-y-12">
      <TestimonialMarquee />
      <!-- <WishMarquee /> -->
    </section>

    <!-- Event Details -->
    <div class="relative z-10 bg-neutral-950 px-6 py-24 md:py-32">
      <div class="mx-auto max-w-2xl text-center space-y-12">

        <div class="space-y-6 text-neutral-300 font-light">
          <p class="text-lg text-neutral-400">
            The Grand Estate<br/>
            San Francisco, California
          </p>
        </div>

        <div class="pt-12">
          <button class="px-8 py-3 border border-white/20 hover:bg-white hover:text-black transition-[transform,colors] duration-300 tracking-widest text-sm uppercase active:scale-[0.96] cursor-pointer">
            RSVP Coming Soon
          </button>
        </div>

        <div class="pt-32 pb-12 opacity-50 text-xs tracking-widest text-neutral-600">
          <p>Formal Invitation to Follow</p>
        </div>
      </div>
    </div>

    <WeddingFAQ />
  </main>

<script is:inline>
  // Background music
  const heroMusic = document.getElementById('hero-music');
  let hasStarted = false;

  function startMusic() {
    if (!hasStarted && heroMusic) {
      heroMusic.volume = 0.3;
      heroMusic.play()
        .then(() => {
          hasStarted = true;
        })
        .catch(err => {
          console.log('Audio playback failed:', err);
        });
    }
  }

  // Loading screen logic
  const hideLoadingScreen = () => {
    const loader = document.getElementById('loading-screen');
    if (!loader) return;

    loader.style.opacity = '0';
    setTimeout(() => {
      loader.remove();
    }, 500);
    
    // Start music when loading screen begins to fade
    startMusic();
  };

  const waitForHeroZoomLoaded = async () => {
    const heroMedia = document.querySelector('#hero-container [data-hero-media]');
    if (!heroMedia) {
      return;
    }

    if (heroMedia.complete && heroMedia.naturalWidth > 0) {
      if (typeof heroMedia.decode === 'function') {
        try {
          await heroMedia.decode();
        } catch {
          // Ignore decode failures and continue.
        }
      }
      return;
    }

    await new Promise((resolve) => {
      const onDone = () => resolve();
      heroMedia.addEventListener('load', onDone, { once: true });
      heroMedia.addEventListener('error', onDone, { once: true });
    });
  };

  const waitForAudioLoaded = async () => {
    if (!heroMusic) return;

    // Check if already loaded
    if (heroMusic.readyState >= 2) {
      return;
    }

    // Wait for audio to be loaded
    await new Promise((resolve) => {
      const onDone = () => {
        heroMusic.removeEventListener('canplay', onDone);
        heroMusic.removeEventListener('error', onDone);
        resolve();
      };
      heroMusic.addEventListener('canplay', onDone, { once: true });
      heroMusic.addEventListener('error', onDone, { once: true });
    });
  };

  const initLoadingScreen = async () => {
    await Promise.all([waitForHeroZoomLoaded(), waitForAudioLoaded()]);
    hideLoadingScreen();
  };

  initLoadingScreen();

  document.addEventListener('story-viewer-end', (e) => {
    const currentViewer = e.target;
    const viewers = Array.from(document.querySelectorAll('[data-story-viewer]'));
    const currentIndex = viewers.indexOf(currentViewer);
    
    if (currentIndex >= 0 && currentIndex < viewers.length - 1) {
      e.preventDefault();
      const nextViewer = viewers[currentIndex + 1];
      
      if (nextViewer && typeof nextViewer.openStory === 'function') {
        nextViewer.openStory({ animate: true });
        
        setTimeout(() => {
          if (typeof currentViewer.closeStory === 'function') {
            currentViewer.closeStory({ animate: false });
          }
        }, 300);
      }
    }
  });

  document.addEventListener('story-viewer-prev', (e) => {
    const currentViewer = e.target;
    const viewers = Array.from(document.querySelectorAll('[data-story-viewer]'));
    const currentIndex = viewers.indexOf(currentViewer);
    
    if (currentIndex > 0) {
      e.preventDefault();
      const prevViewer = viewers[currentIndex - 1];
      
      if (prevViewer && typeof prevViewer.openStory === 'function') {
        prevViewer.openStory({ animate: true, startIndex: 'last' });
        
        setTimeout(() => {
          if (typeof currentViewer.closeStory === 'function') {
            currentViewer.closeStory({ animate: false });
          }
        }, 300);
      }
    }
  });
</script>

<style>
  .animate-fade-up {
    animation: fade-up 1s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }

  @keyframes fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
</Layout>
