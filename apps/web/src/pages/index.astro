// Couple-supplied teaser tiles (up to three); missing assets are skipped so the
// rail degrades gracefully until the images land.
const storyTeaserAssets = [
  "/teasers/story-teaser-1.webp",
  "/teasers/story-teaser-2.webp",
  "/teasers/story-teaser-3.webp",
].filter((src) => teaserAssetExists(src));

function teaserAssetExists(src: string) {
  // Dev: the page module lives under src/pages (public/ is ../../public).
  // Build: the module lives under dist/server (public assets are bundled
  // into dist/client — presence there reflects what the adapter will serve).
  const candidates = [
    new URL(`../../public${src}`, import.meta.url),
    new URL(`../../client${src}`, import.meta.url),
  ];
  return candidates.some((url) => existsSync(url));
}
---

<Layout title="Save the Date | Yofri & Aisha">
  <!-- Loading Overlay -->
  <div id="loading-screen" class="fixed inset-0 z-50 flex items-center justify-center bg-neutral-950 transition-opacity duration-300 ease-out">
    <div class="flex flex-col items-center">
      <div
        id="invite-greeting"
        class:list={["text-lg font-light tracking-wide text-neutral-200 text-balance text-center", { "mb-4": inviteDisplayName !== null }]}
      >
        {inviteDisplayName}
      </div>
      <TextShimmer 
        class="text-xl font-medium tracking-tight"
        phrases={[
          "Pre-heating the server…",
          "Converting coffee into code…", 
          "Discombobulating…", 
          "Wrangling…", 
          "Symbioting…", 
          "Perambulating…", 
          "Shenaninganing…"
        ]}
      >
        Pre-heating the server…
      </TextShimmer>
    </div>
  </div>

  <!-- Background Music -->
  <audio id="hero-music" loop preload="auto">
    <source src="/Lee Soo Young - ONE - ENGLISH Version.mp3" type="audio/mpeg" />
  </audio>

  <main class="relative bg-neutral-950">
    <HeroZoom />
    <QuranVerse />
    <ZoomParallax />
    <TimelineScroll />

    <section class="relative overflow-hidden">
      <div class="mx-auto max-w-7xl px-6">
        <h2 class="text-xl font-light text-center mb-4 text-neutral-300 text-balance">Show Our Memories Together</h2>
      </div>
      <div class="flex gap-2 overflow-x-auto pb-2 no-scrollbar snap-x">
        {storyTeaserAssets.map((src, teaserIndex) => (
          <div class="snap-center flex-shrink-0 pl-6 animate-fade-up" style={`animation-delay: ${teaserIndex * 60}ms`}>
            <img
              src={src}
              alt=""
              width="112"
              height="200"
              loading="lazy"
              decoding="async"
              class="block h-[200px] w-[112px] rounded-[12px] object-cover"
            />
          </div>
        ))}

        {storyUsers.map((user, index) => (
          <div class={`snap-center flex-shrink-0 animate-fade-up ${index === storyUsers.length - 1 ? 'pr-6' : ''}`} style={`animation-delay: ${(storyTeaserAssets.length + index) * 60}ms`}>
            <StoryViewer
              stories={user.stories}
              username={user.username}
              avatar={user.avatar}
              timestamp="2026-02-03T16:45:00Z"
            />
          </div>
        ))}
      </div>
    </section>
    <section class="relative py-4 overflow-hidden space-y-12">
      <TestimonialMarquee />
      <!-- <WishMarquee /> -->
    </section>

    <!-- Event Details -->
    <div class="relative z-10 bg-neutral-950 px-6 py-24 md:py-32">
      <div class="mx-auto max-w-2xl text-center space-y-12">

        <div class="space-y-6 text-neutral-300 font-light">
          <p class="text-lg text-neutral-400">
            The Grand Estate<br/>
            San Francisco, California
          </p>
        </div>

        <div class="pt-12">
          <button class="px-8 py-3 border border-white/20 hover:bg-white hover:text-black transition-[transform,background-color,color] duration-160 ease-out tracking-widest text-sm uppercase active:scale-[0.97] cursor-pointer">
            RSVP Coming Soon
          </button>
        </div>

        <div class="pt-32 pb-12 opacity-50 text-xs tracking-widest text-neutral-600">
          <p>Formal Invitation to Follow</p>
        </div>
      </div>
    </div>

    <WeddingFAQ />
  </main>

<script is:inline>
  // Background music
  const heroMusic = document.getElementById('hero-music');
  let hasStarted = false;

  function startMusic() {
    if (!hasStarted && heroMusic) {
      heroMusic.volume = 0.3;
      heroMusic.play()
        .then(() => {
          hasStarted = true;
        })
        .catch(err => {
          console.log('Audio playback failed:', err);
        });
    }
  }

  // Loading screen logic
  const hideLoadingScreen = () => {
    const loader = document.getElementById('loading-screen');
    if (!loader) return;

    loader.style.opacity = '0';
    setTimeout(() => {
      loader.remove();
    }, 300);
    
    // Start music when loading screen begins to fade
    startMusic();
  };

  const waitForHeroZoomLoaded = async () => {
    const heroMedia = document.querySelector('#hero-container [data-hero-media]');
    if (!heroMedia) {
      return;
    }

    if (heroMedia.complete && heroMedia.naturalWidth > 0) {
      if (typeof heroMedia.decode === 'function') {
        try {
          await heroMedia.decode();
        } catch {
          // Ignore decode failures and continue.
        }
      }
      return;
    }

    await new Promise((resolve) => {
      const onDone = () => resolve();
      heroMedia.addEventListener('load', onDone, { once: true });
      heroMedia.addEventListener('error', onDone, { once: true });
    });
  };

  const waitForAudioLoaded = async () => {
    if (!heroMusic) return;

    // Check if already loaded
    if (heroMusic.readyState >= 2) {
      return;
    }

    // Wait for audio to be loaded
    await new Promise((resolve) => {
      const onDone = () => {
        heroMusic.removeEventListener('canplay', onDone);
        heroMusic.removeEventListener('error', onDone);
        resolve();
      };
      heroMusic.addEventListener('canplay', onDone, { once: true });
      heroMusic.addEventListener('error', onDone, { once: true });
    });
  };

  const initLoadingScreen = async () => {
    await Promise.all([waitForHeroZoomLoaded(), waitForAudioLoaded()]);
    hideLoadingScreen();
  };

  initLoadingScreen();

  document.addEventListener('story-viewer-end', (e) => {
    const currentViewer = e.target;
    const viewers = Array.from(document.querySelectorAll('[data-story-viewer]'));
    const currentIndex = viewers.indexOf(currentViewer);
    
    if (currentIndex >= 0 && currentIndex < viewers.length - 1) {
      e.preventDefault();
      const nextViewer = viewers[currentIndex + 1];
      
      if (nextViewer && typeof nextViewer.openStory === 'function') {
        const closeCurrent = () => {
          if (typeof currentViewer.closeStory === 'function') {
            currentViewer.closeStory({ animate: false });
          }
        };
        // Close the outgoing viewer when the incoming viewer's first slide is
        // actually ready (event-driven, no black flash); the timeout is only a
        // safety net for a readiness signal that never arrives.
        const fallback = setTimeout(closeCurrent, 800);
        nextViewer.openStory({
          animate: true,
          onFirstSlideReady: () => {
            clearTimeout(fallback);
            closeCurrent();
          },
        });
      }
    }
  });

  document.addEventListener('story-viewer-prev', (e) => {
    const currentViewer = e.target;
    const viewers = Array.from(document.querySelectorAll('[data-story-viewer]'));
    const currentIndex = viewers.indexOf(currentViewer);
    
    if (currentIndex > 0) {
      e.preventDefault();
      const prevViewer = viewers[currentIndex - 1];
      
      if (prevViewer && typeof prevViewer.openStory === 'function') {
        const closeCurrent = () => {
          if (typeof currentViewer.closeStory === 'function') {
            currentViewer.closeStory({ animate: false });
          }
        };
        // Same event-driven hand-off as the next direction, opening the
        // previous viewer at its last story.
        const fallback = setTimeout(closeCurrent, 800);
        prevViewer.openStory({
          animate: true,
          startIndex: 'last',
          onFirstSlideReady: () => {
            clearTimeout(fallback);
            closeCurrent();
          },
        });
      }
    }
  });
</script>

<style>
  .animate-fade-up {
    animation: fade-up 0.6s var(--ease-out-expo) forwards;
    opacity: 0;
    transform: translateY(20px);
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fade-up {
      animation: fade 0.2s ease;
    }
  }

  @keyframes fade {
    to {
      opacity: 1;
    }
  }

  @keyframes fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
</Layout>
