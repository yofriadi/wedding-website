---
import Layout from "../layouts/Layout.astro";
import HeroZoom from "../components/HeroZoom.astro";
import QuranVerse from "../components/QuranVerse.astro";
import FamiliesReveal from "../components/FamiliesReveal.astro";
import ZoomParallax from "../components/ZoomParallax.astro";
import TimelineScroll from "../components/TimelineScroll.astro";
import MagneticImageTrail from "../components/MagneticImageTrail.astro";
import AddImageButton from "../components/AddImageButton.astro";
import WeddingFAQ from '../components/WeddingFAQ.astro';
import TextShimmer from "../components/TextShimmer.astro";
import WelcomeGate from "../components/WelcomeGate.astro";
import ClaimMemberGate from "../components/ClaimMemberGate.astro";
import RsvpSection from "../components/RsvpSection.astro";
import VenueMap from "../components/VenueMap.astro";
import EventTimes from "../components/EventTimes.astro";
import DesktopGate from "../components/DesktopGate.astro";
import { db } from "@wedding-website/db";
import { invites, rsvps } from "@wedding-website/db/schema";
import { eq } from "drizzle-orm";

import { inviteIdFromCookies, readGroupQuota } from "../lib/invite-session";
import { HERO_SIZES, HERO_SRCSET_AVIF } from "../lib/hero-media";
import { shuffleTrail } from "../lib/trail-sequence";
import { LOADING_PHRASES } from "../lib/loading-phrases";
import { CENTER_FOCUS_VERSION, masterSrc } from "../lib/media-candidates";

/**
 * Head-hint URL for the collage centre's AVIF master. Derived, never written as
 * a literal: the hint MUST name the same URL the promoted `<img>` selects, or
 * the entry sequence's largest asset is downloaded twice — the failure
 * `hero-media.ts` exists to prevent. ZoomParallax builds its centre candidate
 * from the same `CENTER_FOCUS_VERSION`.
 */
const CENTER_FOCUS_PRELOAD_AVIF = masterSrc("center-focus", "avif", CENTER_FOCUS_VERSION);

// Personalized greeting + RSVP controls (server-rendered; read-only — metrics
// stay exclusive to /{id}).
let inviteDisplayName: string | null = null;
let inviteRsvpAttending: boolean | null = null;
let inviteKind: "individual" | "member" | "group" | null = null;
let inviteGroupQuota: { maxMembers: number; claimedCount: number } | null = null;
const inviteCookieValue = inviteIdFromCookies(Astro.cookies);
if (inviteCookieValue) {
  try {
    const inviteRow = await db
      .select({
        id: invites.id,
        displayName: invites.displayName,
        attending: rsvps.attending,
        type: invites.type,
        parentId: invites.parentId,
        maxMembers: invites.maxMembers,
      })
      .from(invites)
      .leftJoin(rsvps, eq(rsvps.inviteId, invites.id))
      .where(eq(invites.id, inviteCookieValue))
      .limit(1);
    const row = inviteRow[0];
    inviteDisplayName = row?.displayName ?? null;
    inviteRsvpAttending = row?.attending ?? null;
    const parentId = row?.parentId ?? null;
    // Derived exactly as resolveInvite derives it — this page keeps its own
    // inline query rather than sharing that helper.
    inviteKind = !row
      ? null
      : parentId !== null
        ? "member"
        : row.type === "group"
          ? "group"
          : "individual";
    if (row && inviteKind === "group") {
      // Groups pay one extra COUNT; members pay one for the PARENT's quota. Both
      // go through readGroupQuota, which derives claimedCount from the member rows
      // so it can never drift. Errors propagate to the outer catch here ON
      // PURPOSE: the quota decides whether to offer the claim form at all, so
      // failing closed to anonymous is the safer degrade — offering a claim form on
      // unknown quota would let a full group loop submit -> 409 -> reload.
      const quota = await readGroupQuota(row.id);
      if (quota) {
        inviteGroupQuota = quota;
      } else {
        // Unreachable in practice: readGroupQuota's non-group branch is dead
        // (nothing UPDATEs invites.type — only seen_*/opened_* metrics ever move)
        // and a group WITH members cannot be deleted, because the self-FK refuses.
        // The only residual trigger is a hand-run DELETE of a memberless group
        // racing this render. Reset rather than throw: the same fail-closed outcome
        // (no group UI, so no claim form on unknown quota) without manufacturing an
        // exception that would read as a bug in the container log.
        inviteKind = null;
        inviteDisplayName = null;
        inviteRsvpAttending = null;
        inviteGroupQuota = null;
      }
    }
  } catch (err) {
    // The page must never break on a lookup failure — degrade to anonymous.
    console.error("[invite-greeting] lookup failed:", err);
    inviteDisplayName = null;
    inviteRsvpAttending = null;
    inviteKind = null;
    inviteGroupQuota = null;
  }
}

const canClaimAtEntry =
  inviteKind === "group" &&
  inviteGroupQuota !== null &&
  inviteGroupQuota.claimedCount < inviteGroupQuota.maxMembers;

// Homepage HTML is personalized per invite; never let a shared cache serve it.
Astro.response.headers.set("Cache-Control", "no-store");

const loadingPhrases = shuffleTrail(LOADING_PHRASES);

---

<Layout title="Yofriadi Yahya & Aisha Amalia">
  {/*
    LCP hint (responsive-media: "The largest contentful paint image is
    prioritised"). Routed through Layout's `head` slot rather than written into
    Layout, because Layout is shared and only this page renders a hero.

    `imagesrcset`/`imagesizes` mirror HeroZoom's AVIF `<source>` — both read the
    same constants, so they cannot drift. A bare `href` would fetch a candidate
    the `<picture>` then discards. `type="image/avif"` lets a non-AVIF engine
    skip the hint instead of fetching bytes it will throw away.

    `fetchpriority="high"` MATCHES the `<img>`'s, deliberately. The
    `responsive-media` "exactly one image" rule counts `img` elements and a
    `<link>` is not one; Chrome's guidance for a preloaded LCP image is that the
    hint and its consumer agree, and a preload left at default priority is queued
    BELOW the font preload that Layout emits first in document order — so the
    hint would not deliver the prioritisation this comment block claims, and
    Chrome reports the mismatch.
  */}
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset={HERO_SRCSET_AVIF}
    imagesizes={HERO_SIZES}
    fetchpriority="high"
  />
  {/*
    Collage-centre preload — `full` tier only.

    The centre slot is the one image the scroll-zoom magnifies until it covers
    the whole stage, so on `full` it earns a head start: this hint fires during
    head parse while the body — gate, audio, hero, two more sections — is still
    streaming, and the entry loader waits on exactly these bytes before it can
    lift. See CENTER_FOCUS_PRELOAD_AVIF for why the URL is derived.

    A COLLAPSED collage gets NO hint — `lite`, and `prefers-reduced-motion` on
    any tier. Both render it as a static one-viewport bento grid whose centre
    cell is one 33vw column; ZoomParallax rewrites that slot's `sizes` to the
    bento claim before promoting it, so candidate selection lands on a generated
    variant (~30 KB) instead of the 2176px master (~536 KB, the single largest
    asset in the entry sequence). Preloading the master there would spend a
    Save-Data guest's budget — and its connection, ahead of the hero LCP — on
    bytes the page never displays.

    Inserted by script because the verdict lives in `html[data-tier]`, which
    Layout's head script writes before this slot runs. A static `<link>` cannot
    see it: `media` takes a media query, not an attribute selector, and by the
    time a script could retract a static hint the request is already queued.
    `define:vars` keeps the value derived from the frontmatter module rather than
    restated as a literal here.

    `type="image/avif"` mirrors the static hero hint above, so a non-AVIF engine
    skips the hint instead of fetching bytes its `<picture>` would discard.
  */}
  <script is:inline slot="head" define:vars={{ centerFocusAvif: CENTER_FOCUS_PRELOAD_AVIF }}>
    (function () {
      // Skip when nothing will magnify the centre slot: `lite`, or a
      // `prefers-reduced-motion` guest on ANY tier — both collapse the collage to
      // the same static bento grid in CSS, and ZoomParallax claims bento sizes for
      // it there, so the master this hint names is never displayed. The predicate
      // is duplicated at three more sites (the parse-time promoter and the loader
      // gate below, plus `scrubsCollage()` in ZoomParallax) because each runs in
      // its own script scope. They must agree: an early promoter that disagrees
      // selects the master under the scrubbed claim and the later sizes swap
      // re-selects, so the guest pays for both.
      if (document.documentElement.getAttribute('data-tier') === 'lite') return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var hint = document.createElement('link');
      hint.rel = 'preload';
      hint.as = 'image';
      hint.type = 'image/avif';
      hint.href = centerFocusAvif;
      document.head.appendChild(hint);
    })();
  </script>
  {/* Predicate kept in sync with DesktopGate.astro and DESKTOP_MEDIA_QUERY */}
  <script is:inline slot="head">
    if (window.matchMedia('(min-width: 768px) and (min-height: 600px)').matches) {
      document.documentElement.setAttribute('data-desktop', '');
    }
  </script>
  {/*
    Basemap tile hints for `<VenueMap />`, rendered unconditionally further down
    this page. They live here rather than inside the component because a
    `<link rel="preconnect">` in the body is an HTML conformance error — the
    Standard permits a body `<link>` only with `itemprop` — and engines honour it
    there only as a quirk. This page is the map's only consumer, so a head-level
    hint ships exactly when the map does.

    COUNT: one `preconnect`, three `dns-prefetch` — not four `preconnect`s. The
    map is below the fold AND lazily initialized (IntersectionObserver, then a
    dynamic `import("./venue-map")`), so its first tile request is seconds away;
    four TCP+TLS handshakes opened during parse would be four idle sockets held
    for a widget the guest may never scroll to. `venue-map.ts:518,523` sets
    `subdomains: "abcd"` and Leaflet round-robins them by tile coordinate, so no
    single host is guaranteed to carry the first tile: `a` gets the full
    handshake and b/c/d get DNS only, which is the expensive half of a cold
    cross-origin lookup at a fraction of the socket cost.

    Tiles are plain `<img>` fetches (no `crossOrigin` on the Leaflet TileLayer),
    so these are no-CORS hints — adding `crossorigin` would warm the wrong pool.
    They follow the hero and font preloads in document order, so they cannot
    displace the LCP path on the throttled link this change exists to protect.
  */}
  <link slot="head" rel="preconnect" href="https://a.basemaps.cartocdn.com" />
  <link slot="head" rel="dns-prefetch" href="https://b.basemaps.cartocdn.com" />
  <link slot="head" rel="dns-prefetch" href="https://c.basemaps.cartocdn.com" />
  <link slot="head" rel="dns-prefetch" href="https://d.basemaps.cartocdn.com" />
  <!-- Loading Overlay -->
  <div id="loading-screen" class="fixed inset-0 z-50 flex items-center justify-center transition-opacity duration-300 ease-out">
    <div class="flex flex-col items-center">
      <TextShimmer
        class="text-xl font-medium tracking-tight font-[sans-serif]"
        duration={2}
        phrases={loadingPhrases}
      >
        {loadingPhrases[0]}
      </TextShimmer>
    </div>
  </div>

  {/*
    No-script escape (progressive-enhancement: "An overlay never traps a
    no-script guest"). This layer is `fixed inset-0 z-50` and opaque, and
    `doHideLoadingScreen` below is the only thing that removes it — so without
    scripting a guest sits behind it permanently. `WelcomeGate` already
    establishes the idiom (its own <noscript> plus an `@media (scripting:
    none)` twin, because Safari has not shipped the `scripting` feature):
    SUPPRESS the overlay without script, never invert it. The loader still ships
    rendered, so the scripted path — which fades and removes it — is untouched.
  */}
  <noscript>
    <style>
      #loading-screen {
        display: none;
      }
    </style>
  </noscript>

  {/* Entry claim gate: presented before WelcomeGate for eligible group invites */}
  {canClaimAtEntry && <ClaimMemberGate loadingPhrases={loadingPhrases} />}

  <!-- Welcome gate: the loader fade reveals it; swipe up opens the site. -->
  <WelcomeGate displayName={inviteDisplayName} />

  <!-- Background Music: ships at preload="none". The tier decides whether the
       3.1 MB file is ever fetched — see the soundtrack block in the inline
       script below (media-tiering: "Soundtrack is tier-conditional"). -->
  <audio id="hero-music" loop preload="none">
    <source src="/Lee Soo Young - ONE - ENGLISH Version.mp3" type="audio/mpeg" />
  </audio>

  <DesktopGate />

  <main class="relative">
    <HeroZoom />
    <QuranVerse />
    <FamiliesReveal />
    <ZoomParallax />
    <!-- Collage promoter (media-tiering). Inline and here, not in a module:
         it must run the instant the collage markup above has parsed, so a
         `full` verdict starts every collage fetch as early as a shipped `src`
         would. `lite` is left to ZoomParallax's per-image approach observer:
         the entry loader gates on first-view media only there, and that
         component sizes the centre slot for the bento grid before promoting it,
         so an early promotion would only fetch a candidate `lite` never shows.
         Promotion is idempotent — a second pass over promoted markup is a no-op. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var PENDING = '#zoom-parallax-container img[data-src]:not([data-promoted])';

        function promote() {
          var images = document.querySelectorAll(PENDING);
          for (var i = 0; i < images.length; i++) {
            var img = images[i];
            var picture = img.closest('picture');
            if (picture) {
              // <source> first: setting the <img> src makes the <picture>
              // re-resolve, and the other order would fetch the WebP fallback
              // and then the AVIF over it.
              //
              // No `:not([srcset])` clause. Every collage <source> now ships a
              // LIVE low-fidelity srcset, so a presence test would never match:
              // the <source> would stay on the placeholder and, because
              // <picture> resolves to the first matching <source>, every
              // AVIF-capable engine would keep the 32px image forever.
              var sources = picture.querySelectorAll('source[data-srcset]');
              for (var j = 0; j < sources.length; j++) {
                sources[j].setAttribute('srcset', sources[j].getAttribute('data-srcset'));
              }
            }
            // Candidate swap, not a source addition: both attributes are
            // OVERWRITTEN, srcset before src so the promoted AVIF <source> wins
            // the re-resolution and the WebP fallback is never fetched.
            var deferredSet = img.getAttribute('data-srcset');
            if (deferredSet) img.setAttribute('srcset', deferredSet);
            var deferred = img.getAttribute('data-src');
            if (deferred) img.setAttribute('src', deferred);
            // The marker is the SOLE idempotency mechanism: every image has a
            // live src from the moment it parses, so `:not([src])` no longer
            // discriminates anything. Set last, so a throw mid-promotion leaves
            // the element eligible for the next pass.
            img.setAttribute('data-promoted', '');
          }
        }

        // Exposed for the end-of-body loader, which promotes the same markup
        // again on `full` (its gate covers the whole collage, and promoting here
        // keeps that check independent of the component module's execution
        // order). Two hand-maintained copies of this ordering — <source> before
        // <img>, marker set LAST — is a footgun; one definition with two callers
        // is not. The component module keeps its own typed copy because it must
        // still work when inline scripts are blocked, in which case `data-tier`
        // is absent too and it degrades to `full`.
        window.__promoteCollageImages = promote;

        // Polarity matches the CSS and other consumers: only an explicit `lite`
        // defers. A missing attribute means the head script never ran (rollback,
        // script blocker), degrading to full rather than an unpromoted collage.
        //
        // `prefers-reduced-motion` defers too, on any tier. The CSS collapses the
        // pin to the same static bento grid, so ZoomParallax claims bento sizes
        // for the centre slot — but it does that in its module, which runs AFTER
        // this inline pass. Promoting here would select the 2176px master first
        // and re-select the small variant after the swap: two fetches, the larger
        // one wasted. Leaving it to the module costs a few milliseconds of parse
        // time and nothing else, because no gate waits on these bytes while the
        // collage is static.
        if (root.hasAttribute('data-desktop')) return;
        var tier = root.getAttribute('data-tier');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (tier !== 'lite' && !reduce) {
          promote();
        }
      })();
    </script>
    <TimelineScroll />

    <!-- Public memories, with an invitation-only posting control. Keep the
         stage unclipped so native sticky positioning can park the CTA below
         the trail instead of following visitors into unrelated sections. -->
    <section id="memories-section" class="relative pt-12" aria-labelledby="memories-heading">
      <div class="mx-auto max-w-7xl px-6 mb-6 text-center" data-scroll-fade>
        <h2 id="memories-heading" class="font-serif text-3xl font-light text-[color:var(--memories-heading)] text-balance">
          Bagikan kenanganmu bersama kami
        </h2>
      </div>
      <div class="relative" data-photo-trail-section>
        <MagneticImageTrail isInvited={Boolean(inviteDisplayName)} />
        <AddImageButton />
      </div>
    </section>

    <!-- Venue map (venue-map-routes) -->
    <VenueMap />

    <!-- Event Times -->
    <EventTimes />

    <!-- Event Details -->
    <div id="rsvp-section" class="relative z-10 px-6 py-12">
      <div class="mx-auto max-w-2xl text-center space-y-10">
        <RsvpSection
          inviteDisplayName={inviteDisplayName}
          rsvpAttending={inviteRsvpAttending}
          inviteKind={inviteKind}
          groupQuota={inviteGroupQuota}
        />
      </div>
    </div>

    <WeddingFAQ />
  </main>

  <script is:inline>
    (function () {
      // Viewport predicate kept in sync with DesktopGate.astro and head script
      var DESKTOP_MEDIA_QUERY = '(min-width: 768px) and (min-height: 600px)';
      var wasGated = false;

      function setElementInert(el, inert) {
        if (!el) return;
        if (inert) {
          el.setAttribute('inert', '');
        } else {
          el.removeAttribute('inert');
        }
      }

      function applyInert(matches) {
        var root = document.documentElement;
        var main = document.querySelector('main');
        var claimGate = document.getElementById('claim-gate');
        var welcomeGate = document.getElementById('welcome-gate');

        if (matches) {
          wasGated = true;
          root.setAttribute('data-desktop', '');
          root.style.overflow = 'hidden';
          setElementInert(main, true);
          setElementInert(claimGate, true);
          setElementInert(welcomeGate, true);
        } else {
          var unGating = wasGated;
          wasGated = false;
          root.removeAttribute('data-desktop');
          if (!welcomeGate || !welcomeGate.isConnected) {
            root.style.overflow = '';
            setElementInert(main, false);
          }
          setElementInert(claimGate, false);
          setElementInert(welcomeGate, false);
          if (typeof window.welcomeGateTryArm === 'function') {
            window.welcomeGateTryArm();
          }
          if (unGating) {
            window.dispatchEvent(new CustomEvent('desktop-gate:release'));
          }
        }
      }

      var mql = window.matchMedia(DESKTOP_MEDIA_QUERY);
      applyInert(mql.matches);
      mql.addEventListener('change', function (e) {
        applyInert(e.matches);
      });
    })();
  </script>

<script is:inline>
  // Background music — tier-conditional (media-tiering).
  //
  // The element ships at preload="none". On `full`, eager preloading begins
  // after an initial 1200ms delay (so LCP hero image and fonts have exclusive bandwidth)
  // and starts playback at the welcome gate's commit gesture. `lite` never downloads
  // it: no preload, no commit playback, and no gesture-armed fallback.
  const heroMusic = document.getElementById('hero-music');
  let hasStarted = false;
  let gestureArmed = false;
  // A swipe-up ends in `touchend`, which browsers accept as a user gesture for
  // audio. Desktop wheel/trackpad scroll does NOT count, so click/key are armed too.
  const gestureEvents = ['touchend', 'pointerup', 'click', 'keydown'];

  function tierIsFull() {
    // Missing attribute degrades to `full` (failsafe).
    return document.documentElement.getAttribute('data-tier') !== 'lite';
  }

  // Is a scroll-driven transform going to magnify the collage? Only then can an
  // unpromoted or under-resolved slot be SEEN as a blur mid-scroll, so only then
  // is it worth gating the loader on those bytes. Mirrors `scrubsCollage()` in
  // ZoomParallax.astro and the two inline checks above it; a missing `data-tier`
  // still degrades to the scrubbed behaviour, exactly like `tierIsFull()`.
  function scrubsCollage() {
    return tierIsFull() && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function enableSoundtrack() {
    if (document.documentElement.hasAttribute('data-desktop')) return;
    if (!heroMusic || hasStarted || heroMusic.preload === 'auto') return;
    heroMusic.preload = 'auto';
    // Changing `preload` alone does not restart resource selection on an
    // element that never started loading; load() does.
    heroMusic.load();
  }

  function startMusic() {
    if (document.documentElement.hasAttribute('data-desktop')) return;
    if (!tierIsFull()) return;
    if (!hasStarted && heroMusic) {
      heroMusic.volume = 0.3;
      heroMusic.play()
        .then(() => {
          hasStarted = true;
          disarmMusicGesture();
        })
        .catch(err => {
          console.log('Audio playback failed:', err);
          armMusicGesture();
        });
    }
  }

  function startMusicFromGesture() {
    disarmMusicGesture();
    startMusic();
  }

  function armMusicGesture() {
    if (gestureArmed || hasStarted) return;
    gestureArmed = true;
    for (const event of gestureEvents) {
      document.addEventListener(event, startMusicFromGesture, { once: true, passive: true });
    }
  }

  function disarmMusicGesture() {
    gestureArmed = false;
    for (const event of gestureEvents) {
      document.removeEventListener(event, startMusicFromGesture);
    }
  }

  // Loading screen logic
  //
  // BOTH bounds are measured from NAVIGATION START, not from this script's
  // evaluation. `performance.now()` is already relative to the time origin, so
  // subtracting it — rather than a timestamp captured here — is what makes the
  // ceiling bound the guest's actual wait. This script sits at the end of
  // <body>: measuring from here stacks the entire HTML-streaming time on top of
  // the bound, and on a slow link that difference is seconds.
  //
  // Minimum dwell: the overlay is a SIGNAL that the page is still working, not a
  // beat anyone is meant to read — so this floor is not sized for a phrase. It
  // exists only to stop a warm-cache load flashing the overlay for less time than
  // it takes to register, which reads as a glitch rather than a transition; it is
  // matched to LOADER_FADE_MS so the shortest possible appearance is one coherent
  // fade. The floor only ever BINDS on a fast load — a cold one is held by the
  // media gate itself — so every extra millisecond here is a tax on precisely the
  // returning guest whose photos are already cached and who has nothing left to
  // buffer. Both bounds are measured from navigation start, so HTML streaming
  // time usually satisfies this floor before the gate can even resolve.
  const LOADER_MIN_DWELL_MS = 300;
  // Hard ceiling: the loader is a bounded entry gate. On `full` the initial
  // visual sequence runs from HeroZoom through ZoomParallax, so give its
  // promoted collage images enough runway to fetch and decode before the welcome
  // gate can arm; `lite` gates on the hero alone and settles far sooner. A
  // failed/stalled asset still settles at this deadline.
  const LOADER_MAX_WAIT_MS = 16000;
  // The overlay fades for this long before it is removed, and only its removal
  // lets the welcome gate arm — so the real worst case from navigation is
  // LOADER_MAX_WAIT_MS + LOADER_FADE_MS. This constant and the `duration-300`
  // class on #loading-screen are two halves of one duration, and Tailwind cannot
  // take a computed class name — so changing one means editing the other by
  // hand. The welcome gate's CSS failsafe delay is sized against that worst case
  // (see WelcomeGate.astro); it must stay larger than it.
  const LOADER_FADE_MS = 300;

  const hideLoadingScreen = () => {
    const wait = Math.max(0, LOADER_MIN_DWELL_MS - performance.now());
    setTimeout(doHideLoadingScreen, wait);
  };

  const doHideLoadingScreen = () => {
    const loader = document.getElementById('loading-screen');
    if (!loader) return;

    loader.style.opacity = '0';
    setTimeout(() => {
      loader.remove();
    }, LOADER_FADE_MS);

    // NOTE: no startMusic() here. The loader predates the welcome gate; audio
    // unlock now belongs to the gate's commit gesture (WelcomeGate calls
    // window.startMusic() synchronously inside the committing touchend). An
    // uninvited play() with no user activation either throws NotAllowedError
    // or silently violates autoplay policy depending on engine heuristics.
  };

  // WHAT THE LOADER GATES ON is tier-dependent, and the difference is geometry
  // rather than patience:
  //
  // - `full` scrubs the collage with scroll, and that motion is driven by scroll
  //   POSITION: it cannot pause for a download. An unpromoted slot is a 32px
  //   placeholder magnified 4-9x across the stage, mid-swipe, in front of the
  //   guest. Every collage byte has to be fetched and decoded before the gate can
  //   arm, which is why `full` promotes here instead of relying on the component
  //   module's own pass.
  // - a COLLAPSED collage — `lite`, or `prefers-reduced-motion` on any tier —
  //   renders as a static one-viewport bento grid: no pin, no transform, nothing
  //   magnified, and ZoomParallax claims bento sizes for it, so its centre slot
  //   resolves to a generated variant instead of the 2176px master. There is no
  //   mid-scroll blur to pre-empt, and the grid sits several viewports below the
  //   hero where the component's own path already promotes it. Gating on those
  //   bytes would make the guest who asked to save data — or to stop motion —
  //   wait longest for media that degrades gracefully by design, so a collapsed
  //   collage gates on first-view media only.
  const ENTRY_MEDIA_SELECTOR = '#hero-container img, #zoom-parallax-container img';
  const FIRST_VIEW_MEDIA_SELECTOR = '#hero-container img';

  // Called while the collage is scrubbed (see the tier note above). It uses the
  // parse-time promoter's own function rather than carrying a second copy of the
  // attribute-ordering rules — see the note where `__promoteCollageImages` is
  // assigned.
  //
  // What this second call actually covers is NOT "inline scripts were blocked":
  // if the parse-time promoter did not run, this script did not run either. It
  // covers a parse-time pass that THREW partway through. Promotion stamps
  // `data-promoted` last per image, which makes the pass resumable — so this
  // completes the tail the throw skipped, instead of letting the wait below hang
  // on placeholders until the ceiling.
  const promoteEntryCollage = () => {
    if (document.documentElement.hasAttribute('data-desktop')) return;
    if (typeof window.__promoteCollageImages === 'function') {
      window.__promoteCollageImages();
    }
  };

  // Lets the deadline drop every listener the losing branch registered:
  // `{ once: true }` alone only cleans up on an event that may never fire.
  const entryAbort = new AbortController();

  const waitForImageReady = async (image) => {
    if (!image.complete) {
      await new Promise((resolve) => {
        const onDone = () => resolve();
        const opts = { once: true, signal: entryAbort.signal };
        image.addEventListener('load', onDone, opts);
        image.addEventListener('error', onDone, opts);
        // Settle on abort too, so a deadline win does not leave promises that
        // nothing will ever resolve.
        entryAbort.signal.addEventListener('abort', onDone, { once: true });
      });
    }

    if (image.naturalWidth > 0 && typeof image.decode === 'function') {
      try {
        await image.decode();
      } catch {
        // A decode failure must not wedge the entry gate forever.
      }
    }
  };

  const waitForEntryMediaLoaded = async () => {
    const gateCollage = scrubsCollage();
    if (gateCollage) {
      promoteEntryCollage();
      // Let the promotion settle before reading `complete`. Swapping a <picture>'s
      // srcset queues "update the image data", which the HTML Standard defers to a
      // stable state — read `complete` in that same tick and an engine that has
      // not yet marked the element incomplete answers `true` for the FINISHED
      // 32px LQIP, so the gate would open on a placeholder. One frame is enough
      // for the pending-request bookkeeping to land. A collapsed collage promotes
      // nothing here, so it has nothing to settle and skips the wait.
      //
      // Raced against a timer because rAF never fires in a background tab: a guest
      // who opens the invite behind another tab would otherwise sit at the gate
      // until the 16 s ceiling even on a warm cache. What this waits for is a
      // task, not a frame, so 100 ms is generous — in a foreground tab the frame
      // arrives in ~16 ms and the timer never wins.
      await new Promise((resolve) => {
        requestAnimationFrame(resolve);
        setTimeout(resolve, 100);
      });
    }
    const selector = gateCollage ? ENTRY_MEDIA_SELECTOR : FIRST_VIEW_MEDIA_SELECTOR;
    const images = Array.from(document.querySelectorAll(selector));
    await Promise.all(images.map(waitForImageReady));
  };

  const waitForZoomParallaxReady = () => {
    const container = document.getElementById('zoom-parallax-container');
    if (!container || container.getAttribute('data-zoom-parallax-ready') === 'true') {
      return Promise.resolve();
    }

    return new Promise((resolve) => {
      const onReady = () => resolve();
      // Module scripts are deferred, so this inline listener is always attached
      // before ZoomParallax can dispatch; the attribute re-check below is
      // belt-and-braces rather than the primary path.
      window.addEventListener('zoom-parallax:ready', onReady, {
        once: true,
        signal: entryAbort.signal,
      });
      entryAbort.signal.addEventListener('abort', onReady, { once: true });
      if (container.getAttribute('data-zoom-parallax-ready') === 'true') onReady();
    });
  };

  // The soundtrack preload used to start on a fixed 1200 ms timer, tuned for
  // when the loader gated on the hero alone. It now gates on the whole
  // HeroZoom-through-ZoomParallax entry sequence, so a fixed timer would fire
  // mid-fetch and spend bandwidth the gate is waiting on — a 3.1 MB audio file
  // competing with the images that decide when the loader can lift. Starting it
  // when the gate SETTLES cannot compete with anything, and still leaves the
  // guest's read-and-swipe time on the welcome gate to buffer before the commit
  // gesture asks for playback.
  window.addEventListener('desktop-gate:release', () => {
    if (tierIsFull()) enableSoundtrack();
    if (typeof window.__promoteCollageImages === 'function') {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (tierIsFull() && !reduce) {
        window.__promoteCollageImages();
      }
    }
  });

  const initLoadingScreen = async () => {
    // Measured from navigation start, so the ceiling bounds the guest's total
    // wait rather than the time since this script happened to parse.
    const remaining = Math.max(0, LOADER_MAX_WAIT_MS - performance.now());
    let deadlineTimer;
    const deadline = new Promise((resolve) => {
      deadlineTimer = setTimeout(resolve, remaining);
    });
    try {
      // On `full` the loader does not remove until every image in the HeroZoom →
      // ZoomParallax entry range has either loaded or failed, decoded where
      // possible, and the parallax component has initialized its bindings.
      // A collapsed collage (`lite`, or reduced motion) waits on the hero alone:
      // it never pins the stage, so the binding signal is not something that
      // guest can observe, and a module that fails to execute must not hold the
      // gate to the ceiling.
      await Promise.race([
        Promise.all([
          waitForEntryMediaLoaded(),
          scrubsCollage() ? waitForZoomParallaxReady() : Promise.resolve(),
        ]),
        deadline,
      ]);
    } catch {
      // Ignore errors; the deadline remains the final escape hatch.
    } finally {
      // Drop the listeners the losing branch left registered and the deadline
      // timer that would otherwise stay pending for the life of the page when the
      // media branch won, then hand the connection the entry media just vacated
      // to the soundtrack preload.
      if (deadlineTimer) clearTimeout(deadlineTimer);
      entryAbort.abort();
      if (tierIsFull()) enableSoundtrack();
      hideLoadingScreen();
    }
  };
  initLoadingScreen();

</script>

<script>
  import "../scripts/scroll-fade";
</script>

<style>
  :root {
    --loading-bg: #0a0a0a; /* dark mode fallback (neutral-950) */

    /* RSVP section (rsvp-star-confirm D5): dark is the baseline, light inverts.
       The section's own component reads these by inheritance — #rsvp-section
       lives here, so this is the file that owns them. */
    --rsvp-bg: #0a0a0a; /* neutral-950 */
    --rsvp-fg: #fafafa; /* neutral-50: counter digits, name, strong copy */
    --rsvp-muted: #a3a3a3; /* neutral-400: labels, note, guidance line */
    --rsvp-error: #f87171; /* red-400 */

    /* Memories section theme; the photo trail owns its own presentation. */
    --memories-bg: #0a0a0a;
    --memories-heading: #d4d4d4;
  }

  /* Light theme */
  @media (prefers-color-scheme: light) {
    :root {
      --loading-bg: #ffffff;
      --rsvp-bg: #ffffff;
      --rsvp-fg: #0a0a0a;
      --rsvp-muted: #525252; /* neutral-600 — holds contrast on white */
      --rsvp-error: #b91c1c; /* red-700 */

      --memories-bg: #ffffff;
      --memories-heading: #404040; /* neutral-700 — readable on white */
    }
  }

  /* Loading screen theme-aware background and default browser font (prevents font shift mid-flight) */
  #loading-screen {
    background-color: var(--loading-bg);
    font-family: sans-serif;
  }

  /* No-script escape, Chromium twin of the <noscript> block above: Safari has
     not shipped the `scripting` media feature, so neither mechanism alone
     covers every engine. Does not match when scripting is enabled. */
  @media (scripting: none) {
    #loading-screen {
      display: none;
    }
  }

  /* RSVP section background (was a hard-coded bg-neutral-950 utility) */
  #rsvp-section {
    background-color: var(--rsvp-bg);
  }

  main {
    background-color: #0a0a0a;
  }
  @media (prefers-color-scheme: light) {
    main {
      background-color: #ffffff;
    }
  }

  /* Memories section background — same rsvp-* treatment: the section owns
     its chrome so it inverts with the OS theme instead of inheriting main's */
  #memories-section {
    background-color: var(--memories-bg);
    margin-top: -1px;
  }

  /* Theme-aware text shimmer gradients for dark mode (white shimmer) */
  #loading-screen :global(text-shimmer [data-text]),
  #loading-screen :global(text-shimmer [data-text-out]) {
    background-image: linear-gradient(110deg, #4b5563, 45%, #ffffff, 55%, #4b5563);
    font-family: sans-serif;
  }

  /* Theme-aware text shimmer gradients for light mode (dark shimmer) */
  @media (prefers-color-scheme: light) {
    #loading-screen :global(text-shimmer [data-text]),
    #loading-screen :global(text-shimmer [data-text-out]) {
      background-image: linear-gradient(110deg, #a8a29e, 45%, #292524, 55%, #a8a29e);
    }
  }

</style>
</Layout>
