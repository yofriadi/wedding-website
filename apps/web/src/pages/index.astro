---
import Layout from "../layouts/Layout.astro";
import HeroZoom from "../components/HeroZoom.astro";
import ZoomParallax from "../components/ZoomParallax.astro";
import QuranVerse from "../components/QuranVerse.astro";
import TimelineScroll from "../components/TimelineScroll.astro";
import StoryViewer from "../components/StoryViewer.astro";
import AddStoryTile from "../components/AddStoryTile.astro";
import AddStoryFlow from "../components/AddStoryFlow.astro";
import WeddingFAQ from '../components/WeddingFAQ.astro';
import TextShimmer from "../components/TextShimmer.astro";
import WelcomeGate from "../components/WelcomeGate.astro";
import RsvpSection from "../components/RsvpSection.astro";
import VenueMap from "../components/VenueMap.astro";
import EventTimes from "../components/EventTimes.astro";
import { db } from "@wedding-website/db";
import { invites, rsvps, submissionPhotos } from "@wedding-website/db/schema";
import { eq } from "drizzle-orm";

const INVITE_COOKIE_NAME = "ww_invite_id";
const INVITE_ID_RE = /^[A-Za-z0-9_-]{12}$/;

// Personalized greeting + RSVP controls (server-rendered; read-only — metrics
// stay exclusive to /{id}).
let inviteDisplayName: string | null = null;
let inviteRsvpAttending: boolean | null = null;
const inviteCookieValue = Astro.cookies.get(INVITE_COOKIE_NAME)?.value;
// Cookie SHAPE only (guest-submissions 4.1): gates SSR of the add-story
// tile. Not an identity check — an unknown-but-well-formed cookie still
// renders the tile and the client's GET resolves the truth (404 → hidden).
const inviteCookieShapeOk =
  typeof inviteCookieValue === "string" && INVITE_ID_RE.test(inviteCookieValue);
if (typeof inviteCookieValue === "string" && INVITE_ID_RE.test(inviteCookieValue)) {
  try {
    const inviteRow = await db
      .select({
        displayName: invites.displayName,
        attending: rsvps.attending,
      })
      .from(invites)
      .leftJoin(rsvps, eq(rsvps.inviteId, invites.id))
      .where(eq(invites.id, inviteCookieValue))
      .limit(1);
    const row = inviteRow[0];
    inviteDisplayName = row?.displayName ?? null;
    inviteRsvpAttending = row?.attending ?? null;
  } catch (err) {
    // The page must never break on a lookup failure — degrade to anonymous.
    console.error("[invite-greeting] lookup failed:", err);
  }
}

// Homepage HTML is personalized per invite; never let a shared cache serve it.
Astro.response.headers.set("Cache-Control", "no-store");


// Story-rail placeholders (story-rail-attribution D1): ONE population — three
// unnamed example posts built from the couple's own photos. No username,
// avatar or timestamp: an empty rail must not invent guests, and the label row
// keeps its transparent filler so mock tiles hold the same rail geometry as
// the real, first-named tiles that replace them. `src` is the full-size .webp
// (StoryViewer derives the .avif sibling by extension swap); the tile
// over-fetches a cached file its own modal then reuses (D8). Each mock carries
// exactly ONE story, so advancing past its only slide hands off to the next
// mock in rail order (D9) — three single-slide posts chain like a real
// three-post rail.
const mockStories: {
  stories: { id: string; type: "image"; src: string; duration: number }[];
}[] = [
  { stories: [{ id: "mock-1", type: "image", src: "/story_example_1.webp", duration: 4000 }] },
  { stories: [{ id: "mock-2", type: "image", src: "/story_example_2.webp", duration: 4000 }] },
  { stories: [{ id: "mock-3", type: "image", src: "/story_example_3.webp", duration: 4000 }] },
];

// SSR gate (story-rail-mocks D4 + public-wall D4): uniform and cookie-blind —
// the mocks render while zero real guest stories exist (no submission has any
// photo) and disappear for EVERYONE (public included) once the first real
// photo lands, live, through guest-rail.ts's syncMockTiles eviction.
// On DB error, fail open (render the mocks): an outage already degrades the
// page to the anonymous state and the client fetch fails too.
let hasAnyGuestPhoto = false;
try {
  const existingPhoto = await db
    .select({ id: submissionPhotos.id })
    .from(submissionPhotos)
    .limit(1);
  hasAnyGuestPhoto = existingPhoto.length > 0;
} catch (err) {
  console.error("[story-rail-mocks] gate check failed (fail open):", err);
}
const showMockStoryTiles = !hasAnyGuestPhoto;
---

<Layout title="Yofri & Aisha">
  <!-- Loading Overlay -->
  <div id="loading-screen" class="fixed inset-0 z-50 flex items-center justify-center transition-opacity duration-300 ease-out">
    <div class="flex flex-col items-center">
      <TextShimmer
        class="text-xl font-medium tracking-tight"
        duration={2}
        phrases={[
          "nyari titik koma yang ilang…",
          "konsultasi sama kerang ajaib…",
          "nyenyenyenyenye…",
          "ndasmu…",
          "Di desa ngga pakai dolar…",
          "sorry yee…",
          "sodara-sodara…",
          "Kompilasi 1 dan 0 jadi cerita kami…",
          "Dikit lagi beres, siap-siap takjub…",
        ]}
      >
        nyari titik koma yang ilang…
      </TextShimmer>
    </div>
  </div>

  <!-- Welcome gate: the loader fade reveals it; swipe up opens the site. -->
  <WelcomeGate displayName={inviteDisplayName} />

  <!-- Background Music -->
  <audio id="hero-music" loop preload="auto">
    <source src="/Lee Soo Young - ONE - ENGLISH Version.mp3" type="audio/mpeg" />
  </audio>

  <main class="relative">
    <HeroZoom />
    <QuranVerse />
    <ZoomParallax />
    <TimelineScroll />

    <!-- Memories story rail: dark is the baseline, light inverts. The
         --memories-* tokens live in this file's :root (rsvp-* precedent) —
         StoryViewer, AddStoryTile and the guest-rail's dynamically built
         tiles read them by inheritance. -->
    <section id="memories-section" class="relative overflow-hidden py-12 md:py-16" data-progressive-section>
      <div class="mx-auto max-w-7xl px-6 mb-12 md:mb-16 text-center" data-scroll-fade>
        <h2 class="font-serif text-3xl font-light text-[color:var(--memories-heading)] md:text-4xl text-balance">
          Show Our Memories Together
        </h2>
      </div>
    <div data-story-rail class="flex gap-2 overflow-x-auto pb-2 no-scrollbar snap-x px-6">
        {/* Add-story tile (guest-submissions 4.1): invite-only entry point.
             SSR gates on the cookie's SHAPE only (cheap pre-render filter);
             the client script is the real gate — the payload's `inviteValid`
             (server-resolved invite) AND `mine === null` must both hold, so a
             STALE well-shaped cookie hides the tile after load. The
             container's px-6 owns the left inset, so tile removal never
             flushes the story tiles to the viewport edge (4.4). */}
        {inviteCookieShapeOk ? (
          <div class="snap-center flex-shrink-0">
            <AddStoryTile />
          </div>
        ) : null}

        {/* Story-rail placeholders (story-rail-attribution D1): the rail's
             ONLY story tiles while the wall is empty — three unnamed example
             posts, one slide each. Each mock needs its own wrapper div:
             eviction walks parentElement from the <story-viewer> element, so a
             bare mock in the flex row would delete the entire rail. Real guest
             tiles are appended after these by scripts/guest-rail.ts, and every
             mock is evicted the moment any real story exists. */}
        {showMockStoryTiles &&
          mockStories.map((entry, index) => (
            <div
              class="snap-center flex-shrink-0 animate-fade-up"
              style={`animation-delay: ${index * 60}ms`}
            >
              <StoryViewer stories={entry.stories} mock />
            </div>
          ))}
      </div>
    </section>

    <!-- Venue map (venue-map-routes) -->
    <VenueMap />

    <!-- Event Details -->
    <div id="rsvp-section" class="relative z-10 px-6 py-12 md:py-16">
      <div class="mx-auto max-w-2xl text-center space-y-10">

        <EventTimes />

        <RsvpSection
          inviteDisplayName={inviteDisplayName}
          rsvpAttending={inviteRsvpAttending}
        />
      </div>
    </div>

    <WeddingFAQ />
  </main>

  {/* Add-story flow modal: one-screen photo submission. Rendered
     unconditionally (it is inert/hidden until opened, and its opener tile is
     invite-gated) so the client script can always bind to it. */}
  <AddStoryFlow />

  {/* Story intro (retire-wishes-story-intro D3): the three example stories,
     always present and hidden, so the add-story tile's first tap can play them
     once real posts evicted the rail mocks — while the mocks still sit in the
     rail the tap skips it (guest-rail.ts), since it duplicates what the rail
     already shows. NOT a mock (no data-mock) so syncMockTiles never removes
     it; it sits outside [data-story-rail] and the hand-off orchestrator is
     rail-scoped, so its end event closes into the flow (guest-rail.ts) rather
     than chaining into rail tiles. */}
  <div hidden data-story-intro>
    <StoryViewer stories={mockStories.flatMap((entry) => entry.stories)} />
  </div>

<script is:inline>
  // Background music
  const heroMusic = document.getElementById('hero-music');
  let hasStarted = false;
  let gestureArmed = false;
  // A swipe-up ends in `touchend`, which browsers accept as a user gesture for
  // audio. Desktop wheel/trackpad scroll does NOT count, so click/key are armed too.
  const gestureEvents = ['touchend', 'pointerup', 'click', 'keydown'];

  function startMusic() {
    if (!hasStarted && heroMusic) {
      heroMusic.volume = 0.3;
      heroMusic.play()
        .then(() => {
          hasStarted = true;
          disarmMusicGesture();
        })
        .catch(err => {
          console.log('Audio playback failed:', err);
          armMusicGesture();
        });
    }
  }

  function startMusicFromGesture() {
    disarmMusicGesture();
    startMusic();
  }

  function armMusicGesture() {
    if (gestureArmed || hasStarted) return;
    gestureArmed = true;
    for (const event of gestureEvents) {
      document.addEventListener(event, startMusicFromGesture, { once: true, passive: true });
    }
  }

  function disarmMusicGesture() {
    gestureArmed = false;
    for (const event of gestureEvents) {
      document.removeEventListener(event, startMusicFromGesture);
    }
  }


  // Loading screen logic
  //
  // Minimum dwell: on a warm cache / fast connection the media gate resolves
  // in a few hundred ms and the loader would flash for less time than it takes
  // to read one phrase. Hold it up at least LOADER_MIN_DWELL_MS (measured from
  // first paint) so the buffering beat — phrases cycling, then fade into the
  // welcome gate — stays legible on any device.
  const LOADER_MIN_DWELL_MS = 2600;
  const loaderShownAt = performance.now();

  const hideLoadingScreen = () => {
    const elapsed = performance.now() - loaderShownAt;
    const wait = Math.max(0, LOADER_MIN_DWELL_MS - elapsed);
    setTimeout(doHideLoadingScreen, wait);
  };

  const doHideLoadingScreen = () => {
    const loader = document.getElementById('loading-screen');
    if (!loader) return;

    loader.style.opacity = '0';
    setTimeout(() => {
      loader.remove();
    }, 300);

    // NOTE: no startMusic() here. The loader predates the welcome gate; audio
    // unlock now belongs to the gate's commit gesture (WelcomeGate calls
    // window.startMusic() synchronously inside the committing touchend). An
    // uninvited play() with no user activation either throws NotAllowedError
    // or silently violates autoplay policy depending on engine heuristics.
  };

  const waitForHeroZoomLoaded = async () => {
    const heroMedia = document.querySelector('#hero-container [data-hero-media]');
    if (!heroMedia) {
      return;
    }

    if (heroMedia.complete && heroMedia.naturalWidth > 0) {
      if (typeof heroMedia.decode === 'function') {
        try {
          await heroMedia.decode();
        } catch {
          // Ignore decode failures and continue.
        }
      }
      return;
    }

    await new Promise((resolve) => {
      const onDone = () => resolve();
      heroMedia.addEventListener('load', onDone, { once: true });
      heroMedia.addEventListener('error', onDone, { once: true });
    });
  };

  const waitForAudioLoaded = async () => {
    if (!heroMusic) return;

    // Check if already loaded
    if (heroMusic.readyState >= 2) {
      return;
    }

    // Wait for audio to be loaded
    await new Promise((resolve) => {
      const onDone = () => {
        heroMusic.removeEventListener('canplay', onDone);
        heroMusic.removeEventListener('error', onDone);
        resolve();
      };
      heroMusic.addEventListener('canplay', onDone, { once: true });
      heroMusic.addEventListener('error', onDone, { once: true });
    });
  };

  const initLoadingScreen = async () => {
    await Promise.all([waitForHeroZoomLoaded(), waitForAudioLoaded()]);
    hideLoadingScreen();
  };

  initLoadingScreen();

  document.addEventListener('story-viewer-end', (e) => {
    const currentViewer = e.target;
    const viewers = Array.from(document.querySelectorAll('[data-story-rail] [data-story-viewer]'));
    const currentIndex = viewers.indexOf(currentViewer);

    if (currentIndex >= 0 && currentIndex < viewers.length - 1) {
      e.preventDefault();
      const nextViewer = viewers[currentIndex + 1];

      if (nextViewer && typeof nextViewer.openStory === 'function') {
        const closeCurrent = () => {
          if (typeof currentViewer.closeStory === 'function') {
            currentViewer.closeStory({ animate: false });
          }
        };
        // Close the outgoing viewer when the incoming viewer's first slide is
        // actually ready (event-driven, no black flash); the timeout is only a
        // safety net for a readiness signal that never arrives.
        const fallback = setTimeout(closeCurrent, 800);
        nextViewer.openStory({
          animate: true,
          onFirstSlideReady: () => {
            clearTimeout(fallback);
            closeCurrent();
          },
        });
      }
    }
  });

  document.addEventListener('story-viewer-prev', (e) => {
    const currentViewer = e.target;
    const viewers = Array.from(document.querySelectorAll('[data-story-rail] [data-story-viewer]'));
    const currentIndex = viewers.indexOf(currentViewer);

    if (currentIndex > 0) {
      e.preventDefault();
      const prevViewer = viewers[currentIndex - 1];

      if (prevViewer && typeof prevViewer.openStory === 'function') {
        const closeCurrent = () => {
          if (typeof currentViewer.closeStory === 'function') {
            currentViewer.closeStory({ animate: false });
          }
        };
        // Same event-driven hand-off as the next direction, opening the
        // previous viewer at its last story.
        const fallback = setTimeout(closeCurrent, 800);
        prevViewer.openStory({
          animate: true,
          startIndex: 'last',
          onFirstSlideReady: () => {
            clearTimeout(fallback);
            closeCurrent();
          },
        });
      }
    }
  });
</script>

<script>
  // Section-scoped progressive image loading.
  //
  // Sections marked [data-progressive-section] render their <img>s without a
  // src (data-src only). This observer swaps the real src in once the section
  // is ~1.5 viewport-heights from entering — early enough that every photo is
  // fetched AND decoded before its scroll-driven reveal plays, even on a fast
  // flick through the pinned parallax/timeline sections.
  const hydrate = (section: Element) => {
    section.querySelectorAll<HTMLImageElement>("img[data-src]").forEach((img) => {
      const sources = Array.from(img.parentElement?.querySelectorAll<HTMLSourceElement>("source[data-srcset], source[data-src]") ?? []);
      for (const source of sources) {
        if (source.dataset.srcset) source.srcset = source.dataset.srcset;
        if (source.dataset.src) source.src = source.dataset.src;
        if (source.dataset.sizes) source.sizes = source.dataset.sizes;
        source.removeAttribute("data-srcset");
        source.removeAttribute("data-src");
        source.removeAttribute("data-sizes");
      }
      if (img.dataset.srcset) {
        img.srcset = img.dataset.srcset;
        if (img.dataset.sizes) img.sizes = img.dataset.sizes;
      }
      img.src = img.dataset.src!;
      img.removeAttribute("data-src");
      img.removeAttribute("data-srcset");
      img.removeAttribute("data-sizes");
      // Decode ahead of paint; failures fall back to normal <img> handling.
      if (typeof img.decode === "function") img.decode().catch(() => {});
    });
    section.dispatchEvent(new CustomEvent("section:images-ready", { bubbles: true }));
  };

  const observer = new IntersectionObserver(
    (entries, obs) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        obs.unobserve(entry.target);
        hydrate(entry.target);
      }
    },
    // Grows the trigger zone well past the viewport so loading starts before entry.
    { rootMargin: "150% 0px" }
  );

  const observeSections = () => {
    document.querySelectorAll("[data-progressive-section]").forEach((section) => {
      const el = section as HTMLElement;
      if (el.dataset.progressObserved) return;
      el.dataset.progressObserved = "true";
      observer.observe(el);
    });
  };

  observeSections();
  document.addEventListener("astro:page-load", observeSections);
</script>

<script>
  // Guest-submissions client orchestration: add-story flow + rail tiles.
  import { initAddStoryFlow } from "../scripts/add-story-flow";
  import { initGuestRail } from "../scripts/guest-rail";
  import "../scripts/scroll-fade";

  initAddStoryFlow();
  initGuestRail();
</script>

<style>
  :root {
    --loading-bg: #0a0a0a; /* dark mode fallback (neutral-950) */

    /* RSVP section (rsvp-star-confirm D5): dark is the baseline, light inverts.
       The section's own component reads these by inheritance — #rsvp-section
       lives here, so this is the file that owns them. */
    --rsvp-bg: #0a0a0a; /* neutral-950 */
    --rsvp-fg: #fafafa; /* neutral-50: counter digits, name, strong copy */
    --rsvp-muted: #a3a3a3; /* neutral-400: labels, note, guidance line */
    --rsvp-error: #f87171; /* red-400 */

    /* Memories story rail (rsvp-* precedent): dark is the baseline, light
       inverts. StoryViewer/AddStoryTile and the guest-rail's dynamically
       built tiles read these by inheritance — this file owns them. */
    --memories-bg: #0a0a0a; /* neutral-950 — matches main's chrome */
    --memories-heading: #d4d4d4; /* neutral-300 */
    --memories-frame: #e2e8f0; /* slate-200: tile placeholder behind images */
    --memories-frame-ring: rgba(255, 255, 255, 0.1); /* white/10 hairline */
    --memories-label: #737373; /* neutral-500: tile captions, add-story label */
    --memories-tile-border: #525252; /* neutral-600: dashed add-story border */
    --memories-tile-hover-border: #a3a3a3; /* neutral-400: hover state */
    --memories-tile-bg: rgba(23, 23, 23, 0.4); /* neutral-900/40 fill */
    --memories-tile-icon: #a3a3a3; /* neutral-400 plus icon */
  }

  /* Light theme */
  @media (prefers-color-scheme: light) {
    :root {
      --loading-bg: #ffffff;
      --rsvp-bg: #ffffff;
      --rsvp-fg: #0a0a0a;
      --rsvp-muted: #525252; /* neutral-600 — holds contrast on white */
      --rsvp-error: #b91c1c; /* red-700 */

      --memories-bg: #ffffff;
      --memories-heading: #404040; /* neutral-700 — readable on white */
      --memories-frame: #e5e5eb; /* slate-200 — barely differs, by design */
      --memories-frame-ring: rgba(0, 0, 0, 0.08); /* hairline holds on white */
      --memories-label: #525252; /* neutral-600 — holds contrast on white */
      --memories-tile-border: #a3a3a3; /* neutral-400 */
      --memories-tile-hover-border: #525252; /* neutral-600 */
      --memories-tile-bg: rgba(245, 245, 244, 0.6); /* stone-100/60 */
      --memories-tile-icon: #525252; /* neutral-600 */
    }
  }

  /* Loading screen theme-aware background */
  #loading-screen {
    background-color: var(--loading-bg);
  }

  /* RSVP section background (was a hard-coded bg-neutral-950 utility) */
  #rsvp-section {
    background-color: var(--rsvp-bg);
  }

  main {
    background-color: #0a0a0a;
  }
  @media (prefers-color-scheme: light) {
    main {
      background-color: #ffffff;
    }
  }

  /* Memories section background — same rsvp-* treatment: the section owns
     its chrome so it inverts with the OS theme instead of inheriting main's */
  #memories-section {
    background-color: var(--memories-bg);
    margin-top: -1px;
  }

  /* Reserved rail height (story-rail-attribution D6): real story tiles are
     injected client-side after the wall fetch resolves, so a NON-empty wall
     SSRs an empty row. Reserving exactly one tile row (200px frame + 8px gap
     + 16px label + the rail's own 8px bottom padding) keeps the section from
     collapsing and re-flowing the page when the tiles land. */
  [data-story-rail] {
    min-height: 232px;
  }

  /* Theme-aware text shimmer gradients for dark mode (white shimmer) */
  #loading-screen :global(text-shimmer [data-text]),
  #loading-screen :global(text-shimmer [data-text-out]) {
    background-image: linear-gradient(110deg, #4b5563, 45%, #ffffff, 55%, #4b5563);
  }

  /* Theme-aware text shimmer gradients for light mode (dark shimmer) */
  @media (prefers-color-scheme: light) {
    #loading-screen :global(text-shimmer [data-text]),
    #loading-screen :global(text-shimmer [data-text-out]) {
      background-image: linear-gradient(110deg, #a8a29e, 45%, #292524, 55%, #a8a29e);
    }
  }

  :global(.animate-fade-up) {
    animation: fade-up 0.6s var(--ease-out-expo) forwards;
    opacity: 0;
    transform: translateY(20px);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.animate-fade-up) {
      animation: fade 0.2s ease;
    }
  }

  @keyframes fade {
    to {
      opacity: 1;
    }
  }

  @keyframes fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
</Layout>
