        <div class="flex gap-2 overflow-x-auto pb-2 no-scrollbar snap-x">
          <div class="snap-center flex-shrink-0 flex flex-col items-center gap-2">
            <button class="relative w-[90px] h-[90px] rounded-full border-2 border-dashed border-white/20 flex items-center justify-center hover:bg-white/5 transition-colors cursor-pointer group">
              <div class="absolute inset-0 rounded-full border border-neutral-900/50"></div>
              <svg 
                xmlns="http://www.w3.org/2000/svg" 
                width="32" 
                height="32" 
                viewBox="0 0 24 24" 
                fill="none" 
                stroke="currentColor" 
                stroke-width="1.5" 
                stroke-linecap="round" 
                stroke-linejoin="round" 
                class="text-neutral-400 group-hover:text-white transition-colors"
              >
                <path d="M5 12h14" />
                <path d="M12 5v14" />
              </svg>
            </button>
            <span class="text-xs text-slate-500">Add Story</span>
          </div>

          {storyUsers.map((user) => (
            <div class="snap-center flex-shrink-0">
              <StoryViewer
                stories={user.stories}
                username={user.username}
                avatar={user.avatar}
                timestamp="2026-02-03T16:45:00Z"
              />
            </div>
          ))}
