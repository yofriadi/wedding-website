        <div class="space-y-6 text-neutral-300 font-light">
          <p class="text-lg text-neutral-400">
            The Grand Estate<br/>
            San Francisco, California
          </p>
        </div>

        <div class="pt-12">
          <button class="px-8 py-3 border border-white/20 hover:bg-white hover:text-black transition-colors duration-300 tracking-widest text-sm uppercase">
            RSVP Coming Soon
          </button>
        </div>

        <div class="pt-32 pb-12 opacity-50 text-xs tracking-widest text-neutral-600">
          <p>Formal Invitation to Follow</p>
        </div>
      </div>
    </div>

<script>
  document.addEventListener('story-viewer-end', (e) => {
    const currentViewer = e.target as HTMLElement;
    const viewers = Array.from(document.querySelectorAll('[data-story-viewer]'));
    const currentIndex = viewers.indexOf(currentViewer);
    
    if (currentIndex >= 0 && currentIndex < viewers.length - 1) {
      e.preventDefault(); // Don't close the current viewer automatically
      const nextViewer = viewers[currentIndex + 1] as any;
      const currentViewerInstance = currentViewer as any;
      
      if (nextViewer && typeof nextViewer.openStory === 'function') {
        // Open the next viewer immediately with animation (fade in over current)
        nextViewer.openStory({ animate: true });
        
        // Close the current viewer without animation after the next one has likely covered it
        setTimeout(() => {
          if (typeof currentViewerInstance.closeStory === 'function') {
            currentViewerInstance.closeStory({ animate: false });
          }
        }, 300);
      }
    }
  });
</script>

<style>
  .animate-fade-up {
    animation: fade-up 1s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }

  @keyframes fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
