# Fresh installs only. Never overwrite .env or reset existing data to migrate.
# Relative file URLs resolve from apps/web in runtime and migration tooling.
DATABASE_URL=file:../../packages/db/local.db

# Optional: local SQLite needs no auth token. Set only for a remote libSQL/Turso DB.
# DATABASE_AUTH_TOKEN=

# Optional: the admin token guarding POST /api/admin/:token/invites (>= 32 chars).
# INVITE_ADMIN_TOKEN=

# Optional: invite cookie lifetime in days (default 30).
# INVITE_COOKIE_DAYS=30

# Guest-upload directory, never apps/web/public. Use an absolute path in production.
# PHOTO_STORAGE_DIR=/absolute/private/guest-photos-root

# Optional: generate AVIF variants of guest photos in the background after an
# upload (default true). AVIF is ~35% smaller than the canonical WebP but costs
# ~4x the CPU to encode, so set to false to serve WebP only if the VM is CPU
# constrained. Existing variants keep being served either way.
# PHOTO_AVIF_ENABLED=true
