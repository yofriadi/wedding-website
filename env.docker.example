# Copy to `.env` next to docker-compose.yml on the VPS and fill in.
# docker compose reads `.env` automatically for variable substitution.

# Admin token guarding POST /api/admin/:token/invites (>= 32 chars).
# Generate one: openssl rand -hex 32
INVITE_ADMIN_TOKEN=

# Generate AVIF variants of guest photos after upload (~35% smaller than
# WebP but ~4x CPU to encode). Set false on a weak VM.
PHOTO_AVIF_ENABLED=true

# Invite cookie lifetime in days (default 30).
INVITE_COOKIE_DAYS=30
