# Turbo
.turbo

# Cloudflare / Wrangler local runtime state
**/.wrangler

# Local SQLite DB + sidecars — created by `pnpm db:migrate`, hold guest data,
# must never be committed. Playwright scratch DBs follow the same pattern.
packages/db/local.db
packages/db/local.db-shm
packages/db/local.db-wal
*.db-shm
*.db-wal

# Local pi-agent skill/prompt installs (openspec tooling)
.pi/

# Better-T-Stack
.alchemy

# Testing
coverage
.nyc_output

# Playwright scratch space (dev-server DB, reports)
test-results/
playwright-report/

.playwright/

# Scroll-capture and design-iteration artifacts (PNGs, MBs per run, regenerated
# on every run — evidence lives in commit messages / PR review).
.artifacts/
apps/web/.artifacts/

# Misc
*.tgz
.cache
tmp
temp

# Local agent skill dumps
.agents

# Agent skill lockfile (local)
skills-lock.json

# Original full-res media sources and the private copies of real personal
# photos/video/music replaced by placeholders for the public repository.
# tools/restore-private-media.sh copies them back before a private deploy.
/originals/
# Optional personal soundtrack (untracked; see DEPLOY.md — the private-deploy
# restore script puts it back).
apps/web/public/*.mp3

# Guest photo storage (guest-submissions D4): dev fallback root is ./var/photos
/var/
