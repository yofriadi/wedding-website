{
  "name": "@wedding-website/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./schema": {
      "default": "./src/schema/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@libsql/client": "catalog:",
    "@wedding-website/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@wedding-website/config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
